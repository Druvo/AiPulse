@page "/reset-password"
@layout AiPulse.Components.Layout.EmptyLayout
@rendermode InteractiveServer
@inject UserService Users

<PageTitle>AiPulse · Reset password</PageTitle>
<HeadContent>
    @* Carries a single-use token in the query string - never index this. *@
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="login-shell-inner">
<div class="login-card">
    @if (_done)
    {
        <div class="auth-icon" aria-hidden="true"><Icon Name="check-circle" Size="22" /></div>
        <h1 class="auth-title">Password updated</h1>
        <div class="alert alert-success" role="status">You can sign in with your new password now.</div>
        <a class="btn btn-primary w-100" href="/login">Sign in <Icon Name="arrow-right" Size="17" /></a>
    }
    else if (string.IsNullOrWhiteSpace(Token))
    {
        <div class="auth-icon" aria-hidden="true"><Icon Name="alert-triangle" Size="22" /></div>
        <h1 class="auth-title">This link is incomplete</h1>
        <div class="alert alert-danger py-2" role="alert">That reset link is missing its token.</div>
        <a class="btn btn-primary w-100" href="/forgot-password">Request a new link</a>
    }
    else
    {
        <div class="auth-icon" aria-hidden="true"><Icon Name="key" Size="22" /></div>
        <h1 class="auth-title">Choose a new password</h1>
        <p class="auth-sub">Pick something long and memorable; a passphrase works well.</p>
        <EditForm Model="_form" OnValidSubmit="Submit" class="auth-form">
            @if (_error is not null)
            {
                <div class="alert alert-danger py-2" role="alert">@_error</div>
            }
            <div class="auth-field">
                <label class="form-label" for="reset-password">New password</label>
                <div class="password-field">
                    <input id="reset-password" type="password" class="form-control" @bind="_form.Password" @bind:event="oninput" autocomplete="new-password" aria-describedby="reset-strength" required />
                    <button type="button" class="password-reveal" data-reveal="reset-password" aria-pressed="false" aria-label="Show password">
                        <Icon Name="eye" Size="18" CssClass="eye-on" /><Icon Name="eye-off" Size="18" CssClass="eye-off" />
                    </button>
                </div>
                <PasswordMeter Password="@_form.Password" Id="reset-strength" />
            </div>
            <div class="auth-field">
                <label class="form-label" for="reset-confirm">Confirm password</label>
                <input id="reset-confirm" type="password" class="form-control" @bind="_form.ConfirmPassword" autocomplete="new-password" required />
            </div>
            <button type="submit" class="btn btn-primary mt-2">Set new password</button>
        </EditForm>
    }
</div>
</div>

@code {
    [SupplyParameterFromQuery] private string? Token { get; set; }
    private readonly ResetForm _form = new();
    private string? _error;
    private bool _done;

    private async Task Submit()
    {
        _error = null;
        if (_form.Password != _form.ConfirmPassword)
        {
            _error = "Passwords don't match.";
            return;
        }

        var (success, error) = await Users.ResetPasswordWithTokenAsync(Token!, _form.Password);
        if (!success)
        {
            _error = error;
            return;
        }

        _done = true;
    }

    private sealed class ResetForm
    {
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}

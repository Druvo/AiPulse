@page "/read"
@attribute [Authorize]
@layout AiPulse.Components.Shared.ReaderLayout
@rendermode InteractiveServer
@using AiPulse.Services.Productivity
@implements IAsyncDisposable
@inject ReaderService ReaderSvc
@inject ReadingStateService Reading
@inject IJSRuntime JS
@inject ToastService Toasts

<PageTitle>@(_article is null ? "AiPulse · Reading view" : $"{_article.Item.Title} · AiPulse")</PageTitle>

<div class="rd @(_prefs.Serif ? "rd-serif" : "") rd-size-@_prefs.Size rd-width-@_prefs.Width">
    <header class="rd-bar">
        <a class="rd-back" href="news"><span aria-hidden="true">←</span> Back to news</a>
        <div class="rd-controls" role="group" aria-label="Reading preferences">
            <button type="button" class="rd-btn" @onclick="() => SetSize(-1)" disabled="@(_prefs.Size <= 0)" aria-label="Smaller text">A−</button>
            <button type="button" class="rd-btn" @onclick="() => SetSize(1)" disabled="@(_prefs.Size >= MaxSize)" aria-label="Larger text">A+</button>
            <button type="button" class="rd-btn" @onclick="CycleWidth" aria-label="@($"Line width: {WidthNames[_prefs.Width]}. Change")">
                <span aria-hidden="true">↔</span> <span class="rd-btn-label">@WidthNames[_prefs.Width]</span>
            </button>
            <button type="button" class="rd-btn" @onclick="ToggleSerif" aria-pressed="@(_prefs.Serif ? "true" : "false")">
                <span class="rd-serif-sample" aria-hidden="true">Aa</span> <span class="rd-btn-label">Serif</span>
            </button>
            <ThemeToggle CssClass="rd-theme" />
        </div>
    </header>

    @if (!_loaded)
    {
        <p class="rd-status" role="status">Loading…</p>
    }
    else if (_article is null)
    {
        <div class="rd-missing">
            <h1 class="rd-title">This story is not in AiPulse</h1>
            <p>The reading view only opens stories AiPulse has collected. It may have aged out of the history.</p>
            @if (SafeExternal(Url) is { } original)
            {
                <p><a href="@original" target="_blank" rel="noopener noreferrer nofollow">Open the link in a new tab</a></p>
            }
            <p><a href="news">Back to the News Feed</a></p>
        </div>
    }
    else
    {
        var item = _article.Item;
        <article class="rd-article" aria-labelledby="rd-title">
            <p class="rd-kicker">@item.SourceName</p>
            <h1 id="rd-title" class="rd-title">@item.Title</h1>
            <p class="rd-meta">
                @if (!string.IsNullOrWhiteSpace(item.Author)) { <span>By @item.Author</span> }
                <time datetime="@item.Published.ToString("o")">@item.Published.ToLocalTime().ToString("MMMM d, yyyy")</time>
                @if (_article.Minutes > 0) { <span>@_article.Minutes min read</span> }
                <span>@SourceLabel(_article.Source)</span>
            </p>
            <div class="rd-actions">
                <a class="btn btn-primary btn-sm" href="@SafeExternal(item.Link)" target="_blank" rel="noopener noreferrer nofollow">
                    <Icon Name="external-link" Size="14" /> Open original
                </a>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ToggleBookmark" aria-pressed="@(_bookmarked ? "true" : "false")">
                    <Icon Name="bookmark" Size="14" /> @(_bookmarked ? "Bookmarked" : "Bookmark")
                </button>
                @if (_article.Source == ReaderBodySource.Summary)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LoadFull" disabled="@_fetching">
                        @(_fetching ? "Fetching the full article…" : "Load the full article")
                    </button>
                }
            </div>
            @if (_fetchFailed)
            {
                <p class="rd-note" role="status">The full article could not be extracted (it may be paywalled or built with scripts). The summary is below.</p>
            }

            <div class="rd-body">
                @if (string.IsNullOrWhiteSpace(_article.BodyHtml))
                {
                    <p class="rd-note">This feed only shared the headline. Use “Open original” to read it on the site.</p>
                }
                else
                {
                    @((MarkupString)_article.BodyHtml)
                }
            </div>

            <footer class="rd-footer">
                <a href="@SafeExternal(item.Link)" target="_blank" rel="noopener noreferrer nofollow">Read it on @Host(item.Link)</a>
            </footer>
        </article>
    }
</div>

@code {
    private const int MaxSize = 4;
    private static readonly string[] WidthNames = { "Narrow", "Medium", "Wide" };

    /// <summary>The story's link, exactly as the feed gave it (URL-encoded in the query string).</summary>
    [SupplyParameterFromQuery(Name = "url")] public string? Url { get; set; }

    public sealed class ReaderPrefs
    {
        public int Size { get; set; } = 1;
        public int Width { get; set; } = 1;
        public bool Serif { get; set; }
    }

    private ReaderArticle? _article;
    private ReaderPrefs _prefs = new();
    private bool _loaded;
    private bool _fetching;
    private bool _fetchFailed;
    private bool _bookmarked;
    private IJSObjectReference? _module;

    protected override void OnParametersSet()
    {
        _article = ReaderSvc.Get(Url);
        _fetchFailed = false;
        _loaded = true;
        if (_article is not null)
        {
            _bookmarked = Reading.IsBookmarked(_article.Item.Link);
            Reading.EnsureRead(_article.Item);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/productivity.js");
            var saved = await _module.InvokeAsync<ReaderPrefs?>("getReaderPrefs");
            if (saved is not null)
            {
                _prefs = new ReaderPrefs { Size = Math.Clamp(saved.Size, 0, MaxSize), Width = Math.Clamp(saved.Width, 0, 2), Serif = saved.Serif };
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private async Task SavePrefs()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("setReaderPrefs", _prefs); } catch (JSDisconnectedException) { }
    }

    private Task SetSize(int delta)
    {
        _prefs.Size = Math.Clamp(_prefs.Size + delta, 0, MaxSize);
        return SavePrefs();
    }

    private Task CycleWidth()
    {
        _prefs.Width = (_prefs.Width + 1) % 3;
        return SavePrefs();
    }

    private Task ToggleSerif()
    {
        _prefs.Serif = !_prefs.Serif;
        return SavePrefs();
    }

    private async Task LoadFull()
    {
        if (_article is null) return;
        _fetching = true;
        StateHasChanged();
        var full = await ReaderSvc.FetchFullAsync(_article.Item.Link);
        _fetching = false;
        if (full is null) _fetchFailed = true;
        else _article = full;
    }

    private void ToggleBookmark()
    {
        if (_article is null) return;
        _bookmarked = Reading.ToggleBookmark(_article.Item);
        Toasts.Show(_bookmarked ? "Bookmarked. Find it in your collections." : "Bookmark removed.");
    }

    private static string SourceLabel(ReaderBodySource s) => s switch
    {
        ReaderBodySource.FetchedPage => "Full article",
        ReaderBodySource.FeedFullText => "Full text from the feed",
        _ => "Summary from the feed"
    };

    private static string? SafeExternal(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var u) && (u.Scheme == Uri.UriSchemeHttp || u.Scheme == Uri.UriSchemeHttps) ? u.AbsoluteUri : null;

    private static string Host(string url) => Uri.TryCreate(url, UriKind.Absolute, out var u) ? u.Host : "the original site";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}

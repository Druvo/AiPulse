@page "/login"
@layout AiPulse.Components.Layout.EmptyLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject UserService Users
@inject OAuthSettingsService OAuthSettings
@inject ClerkAuthService Clerk
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>AiPulse · Sign in</PageTitle>
<HeadContent>
    <meta name="robots" content="index, follow" />
    <meta name="description" content="Sign in to AiPulse - a standalone, self-hosted dashboard to keep developers current on the AI world." />
    <link rel="canonical" href="/login" />
    <meta property="og:title" content="AiPulse - Sign in" />
    <meta property="og:description" content="A standalone, self-hosted AI news &amp; learning dashboard. No API keys required." />
</HeadContent>

<div class="login-shell-inner">
<div class="login-card">
    <div class="auth-icon" aria-hidden="true"><Icon Name="lock" Size="22" /></div>
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-sub">Sign in to your AiPulse dashboard.</p>

    <EditForm Model="Input" OnValidSubmit="SignIn" FormName="login" method="post" class="auth-form">
        <DataAnnotationsValidator />
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2" role="alert">@_error</div>
        }
        @if (Error == "pending")
        {
            <div class="alert alert-warning py-2" role="alert">Your account is pending admin approval.</div>
        }
        else if (Error == "disabled")
        {
            <div class="alert alert-danger py-2" role="alert">This account has been disabled.</div>
        }
        <div class="auth-field">
            <label class="form-label" for="login-username">Username</label>
            <InputText id="login-username" class="form-control" @bind-Value="Input.Username" autocomplete="username" autocapitalize="none" spellcheck="false" required />
        </div>
        <div class="auth-field">
            <div class="auth-field-head">
                <label class="form-label" for="login-password">Password</label>
                <a href="/forgot-password">Forgot password?</a>
            </div>
            <div class="password-field">
                <InputText id="login-password" type="password" class="form-control" @bind-Value="Input.Password" autocomplete="current-password" required />
                <button type="button" class="password-reveal" data-reveal="login-password" aria-pressed="false" aria-label="Show password">
                    <Icon Name="eye" Size="18" CssClass="eye-on" /><Icon Name="eye-off" Size="18" CssClass="eye-off" />
                </button>
            </div>
        </div>
        <div class="form-check auth-check">
            <InputCheckbox class="form-check-input" id="remember" @bind-Value="Input.Remember" />
            <label class="form-check-label" for="remember">Keep me signed in</label>
        </div>
        <button type="submit" class="btn btn-primary">Sign in <Icon Name="arrow-right" Size="17" /></button>
    </EditForm>

    @if (_googleUsable || _githubUsable)
    {
        <div class="auth-divider">or continue with</div>
        <div class="auth-social">
            @if (_googleUsable)
            {
                <a class="btn btn-outline-secondary" href="@($"/auth/external/google?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/dashboard")}")"><Icon Name="globe" Size="17" /> Sign in with Google</a>
            }
            @if (_githubUsable)
            {
                <a class="btn btn-outline-secondary" href="@($"/auth/external/github?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/dashboard")}")"><Icon Name="github" Size="17" /> Sign in with GitHub</a>
            }
        </div>
    }

    @if (_clerk is { } clerk)
    {
        <div class="auth-divider">or with an email account</div>
        <div id="clerk-signin" data-host="@clerk.Host" data-key="@clerk.PublishableKey" data-return-url="@(ReturnUrl ?? "/dashboard")" data-remember="@(Input.Remember ? "true" : "false")"></div>
    }

    <p class="auth-alt">New to AiPulse? <a href="/register">Create an account</a></p>
</div>
<p class="login-signature"><a href="/">Back to the home page</a> · <a href="/news">Browse the news without an account</a></p>
</div>

@code {
    [SupplyParameterFromForm] private LoginInput Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    private string? _error;
    private bool _googleUsable;
    private bool _githubUsable;
    private (string PublishableKey, string Host)? _clerk;

    protected override async Task OnInitializedAsync()
    {
        _googleUsable = await OAuthSettings.IsUsableAsync(OAuthProviders.Google);
        _githubUsable = await OAuthSettings.IsUsableAsync(OAuthProviders.GitHub);
        _clerk = await Clerk.GetActiveAsync();
    }

    private async Task SignIn()
    {
        var (result, user) = await Users.TryLoginAsync(Input.Username, Input.Password);

        _error = result switch
        {
            LoginResult.PendingApproval => "Your account is pending admin approval.",
            LoginResult.LockedOut => "Too many failed attempts. Try again in a few minutes, or ask an admin to unlock your account.",
            LoginResult.Success => null,
            _ => "Invalid username or password."
        };
        if (_error is not null || user is null)
            return;

        var claims = new[]
        {
            new Claim(ClaimTypes.Name, user.Username),
            new Claim(ClaimTypes.NameIdentifier, user.Id.ToString()),
            new Claim(ClaimTypes.Role, user.Role),
            new Claim("security_stamp", user.SecurityStamp)
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var principal = new ClaimsPrincipal(identity);

        var http = Http.HttpContext!;
        await http.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            principal,
            new AuthenticationProperties { IsPersistent = Input.Remember });

        Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/dashboard" : ReturnUrl);
    }

    public sealed class LoginInput
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
        public bool Remember { get; set; } = true;
    }
}

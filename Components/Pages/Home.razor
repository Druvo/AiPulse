@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject KnowledgeBaseService Kb
@inject ReadingStateService Reading
@inject ISummarizer Ai
@inject FeedAggregatorService Feeds
@inject FeedHistoryService History
@inject HuggingFaceService HuggingFace
@inject GitHubTrendingService GitHubTrending
@inject NavigationManager Nav
@inject SiteStatsService Stats

<PageTitle>AiPulse · Dashboard</PageTitle>

<section class="dash-hero" aria-labelledby="dash-title">
    <div class="dash-hero-intro">
        <p class="dash-eyebrow">@Greeting() · @DateTime.Now.ToString("dddd, MMMM d")</p>
        <h1 id="dash-title" class="dash-title"><Icon Name="zap" Size="24" /> Dashboard</h1>
        <p class="dash-lead">What moved in the AI world, what's waiting for you, and where to pick up learning.</p>
    </div>
    <div class="dash-stats">
        <a class="dash-stat" href="@($"news?date={DateTime.Today:yyyy-MM-dd}&filter=All")">
            <span class="dash-stat-icon"><Icon Name="rss" Size="18" /></span>
            <span class="dash-stat-num">@_summary.NewToday.ToString("N0")</span>
            <span class="dash-stat-label">New today</span>
        </a>
        <a class="dash-stat" href="news">
            <span class="dash-stat-icon"><Icon Name="inbox" Size="18" /></span>
            <span class="dash-stat-num">@_summary.UnreadThisWeek.ToString("N0")</span>
            <span class="dash-stat-label">Unread this week</span>
        </a>
        <a class="dash-stat" href="reading-stats">
            <span class="dash-stat-icon"><Icon Name="activity" Size="18" /></span>
            <span class="dash-stat-num">@_summary.Streak<span class="dash-stat-unit">@(_summary.Streak == 1 ? "day" : "days")</span></span>
            <span class="dash-stat-label">Reading streak</span>
        </a>
        <a class="dash-stat dash-stat--topic" href="@(_summary.TopTopic is null ? "topics" : PublicFeeds.TagPath(_summary.TopTopic).TrimStart('/'))">
            <span class="dash-stat-icon"><Icon Name="trending-up" Size="18" /></span>
            <span class="dash-stat-num dash-stat-text" title="@_summary.TopTopic">@(_summary.TopTopic is null ? "—" : "#" + _summary.TopTopic)</span>
            <span class="dash-stat-label">Top topic this week@(_summary.TopTopicCount > 0 ? $" · {_summary.TopTopicCount:N0}" : "")</span>
        </a>
    </div>
</section>

@if (_pendingNew > 0)
{
    <div class="dash-update" role="status">
        <span><Icon Name="rss" Size="15" /> @_pendingNew.ToString("N0") new item@(_pendingNew == 1 ? "" : "s") arrived since you opened this page</span>
        <button class="btn btn-sm btn-primary" @onclick="ApplyNewItems">Update dashboard</button>
    </div>
}

<div class="bento">
    @if (!_welcomeDismissed)
    {
        <section class="card bento-wide welcome-tile">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="flex-grow-1">
                        <h2 class="tile-title"><Icon Name="sparkle" Size="18" /> New here? Three things to try</h2>
                        <p class="text-muted small mb-2">
                            AiPulse gathers @Stats.Current.ActiveSources AI news, research and tool sources into one feed, plus a glossary, a tools
                            comparison and a learning roadmap. It all runs standalone, no AI required.
                        </p>
                        <div class="welcome-steps">
                            <a href="news" class="welcome-step @(VisitedNews() ? "done" : "")">
                                <Icon Name="@(VisitedNews() ? "check" : "rss")" Size="16" />
                                <span>Browse the News Feed</span>
                            </a>
                            <a href="news" class="welcome-step @(ReadSomething() ? "done" : "")">
                                <Icon Name="@(ReadSomething() ? "check" : "bookmark")" Size="16" />
                                <span>Read or save an article</span>
                            </a>
                            <a href="learn" class="welcome-step @(StartedLearning() ? "done" : "")">
                                <Icon Name="@(StartedLearning() ? "check" : "graduation-cap")" Size="16" />
                                <span>Start a Learning Hub module</span>
                            </a>
                        </div>
                        <a href="help" class="btn btn-sm btn-primary tile-btn">
                            <Icon Name="help-circle" Size="14" /> Read the full guide
                        </a>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary tile-btn" @onclick="DismissWelcome" title="Dismiss">
                        <Icon Name="check" Size="16" /> Got it
                    </button>
                </div>
            </div>
        </section>
    }

    <section class="card bento-wide bento-tall digest-tile" aria-labelledby="digest-title">
        <div class="card-body">
            <div class="tile-head">
                <h2 id="digest-title" class="tile-title"><Icon Name="calendar" Size="18" /> Digest</h2>
                <div class="seg" role="group" aria-label="Digest range">
                    <button class="seg-btn @(_range == "today" ? "is-active" : "")" aria-pressed="@(_range == "today" ? "true" : "false")" @onclick='() => SetRange("today")'>Today</button>
                    <button class="seg-btn @(_range == "week" ? "is-active" : "")" aria-pressed="@(_range == "week" ? "true" : "false")" @onclick='() => SetRange("week")'>Week</button>
                    <button class="seg-btn @(_range == "month" ? "is-active" : "")" aria-pressed="@(_range == "month" ? "true" : "false")" @onclick='() => SetRange("month")'>Month</button>
                </div>
            </div>

            <dl class="mini-stats">
                <div><dt>Stories</dt><dd>@_rangeItems.Count.ToString("N0")</dd></div>
                <div><dt>Active sources</dt><dd>@_activeSourceCount.ToString("N0")</dd></div>
                <div><dt>Top category</dt><dd class="mini-text" title="@_topCategory">@(_topCategory ?? "—")</dd></div>
                <div><dt>Multi-source</dt><dd>@_multiSourceStories.Count.ToString("N0")</dd></div>
            </dl>

            <h3 class="tile-sub">Biggest stories @RangeLabel</h3>
            <p class="tile-note">Ranked by how many of your sources covered the same story.</p>
            @if (_biggestStories.Count == 0)
            {
                <div class="tile-empty"><Icon Name="inbox" Size="20" /> Not enough data yet. Check back once AiPulse has collected a few days of news.</div>
            }
            else
            {
                <div class="story-stack">
                    @foreach (var item in _biggestStories)
                    {
                        <FeedItemCard Item="item" Layout="Compact"
                                      IsRead="Reading.IsRead(item.Link)"
                                      IsBookmarked="Reading.IsBookmarked(item.Link)"
                                      OnToggleRead="() => ToggleRead(item)"
                                      OnToggleBookmark="() => ToggleBookmark(item)"
                                      OnOpened="() => MarkAsRead(item)" />
                    }
                </div>
            }
        </div>
    </section>

    <div class="bento-cell">
        <TrendingPanel Items="_rangeItems" DaysWindow="_daysWindow" />
    </div>

    <div class="bento-cell">
        <ExploreTrendingPanel Models="_trendingModels" Repos="_trendingRepos" Developers="_trendingDevelopers" Loading="_trendingLoading" OnRefresh="() => LoadTrendingAsync(force: true)" />
    </div>

    <div class="bento-wide">
        <MiniTimeline Items="_historyItems ?? Array.Empty<FeedItem>()" MaxDays="365" /> @* Always this year, independent of the Today/Week/Month digest range above. *@
    </div>

    <section class="card bento-cell" aria-labelledby="later-title">
        <div class="card-body">
            <div class="tile-head">
                <h2 id="later-title" class="tile-title"><Icon Name="bookmark" Size="18" /> Read later</h2>
                @if (Reading.Bookmarks.Count > 0)
                {
                    <span class="tile-count">@Reading.Bookmarks.Count.ToString("N0")</span>
                }
            </div>
            @if (Reading.Bookmarks.Count == 0)
            {
                <div class="tile-empty"><Icon Name="bookmark" Size="20" /> <span>Nothing saved yet. Tap the bookmark on any story in the <a href="news">News Feed</a> to keep it here.</span></div>
            }
            else
            {
                <div class="story-stack">
                    @foreach (var b in Reading.Bookmarks.Take(4))
                    {
                        var bItem = ToFeedItem(b);
                        <FeedItemCard Item="bItem" Layout="Compact"
                                      IsRead="Reading.IsRead(bItem.Link)"
                                      IsBookmarked="true"
                                      OnToggleRead="() => ToggleRead(bItem)"
                                      OnToggleBookmark="() => Reading.RemoveBookmark(bItem.Link)"
                                      OnOpened="() => MarkAsRead(bItem)" />
                    }
                </div>
                <a href="reading-stats" class="btn btn-sm btn-outline-primary tile-btn mt-2">Open reading list →</a>
            }
        </div>
    </section>

    <section class="card bento-cell" aria-labelledby="learn-title">
        <div class="card-body">
            @{
                var next = Kb.Learning.Where(m => !Reading.IsModuleComplete(m.Title)).Take(4).ToList();
                var pct = Kb.Learning.Count == 0 ? 0 : Reading.CompletedModuleCount * 100 / Kb.Learning.Count;
            }
            <div class="tile-head">
                <h2 id="learn-title" class="tile-title"><Icon Name="graduation-cap" Size="18" /> Continue learning</h2>
                <span class="tile-count">@Reading.CompletedModuleCount / @Kb.Learning.Count</span>
            </div>
            <div class="learn-bar" role="progressbar" aria-label="Learning modules complete" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct">
                <span style="width: @(pct)%"></span>
            </div>
            @if (next.Count == 0)
            {
                <div class="tile-empty"><Icon Name="check" Size="20" /> All modules complete. Nicely done.</div>
            }
            else
            {
                <ul class="learn-list">
                    @foreach (var m in next)
                    {
                        <li>
                            <a href="learn">
                                <span class="learn-name">@m.Title</span>
                                <span class="badge level-@m.Level.ToLower()">@m.Level</span>
                            </a>
                        </li>
                    }
                </ul>
            }
            <a href="learn" class="btn btn-sm btn-outline-primary tile-btn mt-2">All @Kb.Learning.Count modules →</a>
        </div>
    </section>

    <section class="card bento-cell" aria-labelledby="glance-title">
        <div class="card-body">
            <h2 id="glance-title" class="tile-title"><Icon Name="database" Size="18" /> At a glance</h2>
            <ul class="glance">
                <li><a href="news?filter=New"><span>New since last visit</span><strong>@_newSinceVisit.ToString("N0")</strong></a></li>
                <li><a href="coverage"><span>Live sources</span><strong>@Kb.Sources.Count(s => s.Enabled).ToString("N0")</strong></a></li>
                <li><a href="glossary"><span>Glossary terms</span><strong>@Kb.Glossary.Count.ToString("N0")</strong></a></li>
                <li><a href="learn"><span>Learning modules</span><strong>@Kb.Learning.Count.ToString("N0")</strong></a></li>
            </ul>
            <p class="ai-status @(Ai.Enabled ? "is-on" : "")">
                <span class="ai-status-dot" aria-hidden="true"></span>
                <span><strong>AI layer @(Ai.Enabled ? "on" : "off")</strong> ·
                    @(Ai.Enabled ? "summaries, glossary explanations and Ask AiPulse use your configured model." : "standalone mode. Add a provider under Llm:Providers to enable summaries.")</span>
            </p>
        </div>
    </section>

    @if (_range != "today")
    {
        <section class="card bento-wide" aria-labelledby="days-title">
            <div class="card-body">
                <div class="tile-head">
                    <h2 id="days-title" class="tile-title"><Icon Name="calendar" Size="18" /> Day by day</h2>
                    <input class="form-control form-control-sm tile-search" placeholder="Filter by category…" aria-label="Filter days by category"
                           value="@_search" @oninput="e => { _search = (string)e.Value!; _dayPage = 1; }" />
                </div>
                @{ var (pageDays, totalDays) = GetDayPage(); var dayMax = Math.Max(1, _byDay.Count == 0 ? 1 : _byDay.Max(d => d.Count)); }
                <div class="table-responsive">
                    <table class="table table-sm align-middle day-table">
                        <thead>
                            <tr>
                                <SortableHeader Column="date" Label="Day" SortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="ToggleSort" />
                                <SortableHeader Column="count" Label="Items" SortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="ToggleSort" />
                                <th>Top categories</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var day in pageDays)
                            {
                                <tr>
                                    <td class="text-nowrap"><a href="@($"news?date={day.Date:yyyy-MM-dd}&filter=All")">@day.Date.ToString("ddd, MMM d")</a></td>
                                    <td class="day-count">
                                        <span class="day-bar" aria-hidden="true"><span style="width: @(day.Count * 100 / dayMax)%"></span></span>
                                        <span>@day.Count.ToString("N0")</span>
                                    </td>
                                    <td>
                                        @foreach (var (cat, count) in day.TopCategories)
                                        {
                                            <span class="badge bg-secondary me-1">@cat @count</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (totalDays == 0)
                {
                    <div class="tile-empty"><Icon Name="search" Size="20" /> No days match that category.</div>
                }
                <Pager TotalItems="totalDays" @bind-CurrentPage="_dayPage" @bind-PageSize="_dayPageSize" PageSizeOptions="new[] { 10, 14, 30 }" />
            </div>
        </section>
    }

    @foreach (var w in Reading.DashboardWidgets)
    {
        <section class="card bento-cell bento-widget">
            <div class="card-body">
                <h2 class="tile-title">@w.Title</h2>
                @if (w.Type == "Iframe")
                {
                    <iframe src="@w.Content" class="dashboard-widget-frame" title="@w.Title" sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
                }
                else
                {
                    <div>@((MarkupString)w.Content)</div>
                }
            </div>
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "range")]
    public string? RangeParam { get; set; }

    private static readonly HashSet<string> ValidRanges = new() { "today", "week", "month" };

    private IReadOnlyList<FeedItem>? _historyItems;
    private bool _welcomeDismissed;
    private List<TrendingModel> _trendingModels = new();
    private List<TrendingRepo> _trendingRepos = new();
    private List<TrendingDeveloper> _trendingDevelopers = new();
    private bool _trendingLoading = true;
    private int _newSinceVisit;
    private DashboardSummary _summary = new(0, 0, 0, null, 0);

    private string _range = "week";
    private List<FeedItem> _rangeItems = new();
    private int _activeSourceCount;
    private string? _topCategory;
    private List<FeedItem> _multiSourceStories = new();
    private List<FeedItem> _biggestStories = new();
    private List<DayRow> _byDay = new();

    private string _search = "";
    private string? _sortColumn = "date";
    private bool _sortAscending = false;
    private int _dayPage = 1;
    private int _dayPageSize = 10;

    private int _daysWindow => _range switch { "today" => 1, "month" => 30, _ => 7 };
    private int _heatmapDays => _range switch { "today" => 7, "month" => 90, _ => 30 };
    private string RangeLabel => _range switch { "today" => "today", "month" => "this month", _ => "this week" };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(RangeParam) && ValidRanges.Contains(RangeParam))
            _range = RangeParam;

        _welcomeDismissed = Reading.WelcomeDismissed;
        _historyItems = History.Items; // already-persisted (FeedHistoryService) - no async needed, renders immediately
        RecomputeRange();

        // Both third-party lookups load independently in the background instead of gating the whole
        // Dashboard behind one shared wait - a slow/unreachable Hugging Face or GitHub no longer holds up
        // everything else on the page (stat cards, trending panel, biggest stories all render right away).
        _ = LoadNewSinceVisitAsync();
        _ = LoadTrendingAsync();

        History.Changed += OnHistoryChanged;
    }

    private int _pendingNew;
    private HashSet<string>? _snapshotLinks;

    /// <summary>
    /// The background watcher saved new items. Count them against what this page is showing and offer an update, rather than re-sorting
    /// the dashboard while someone is reading it (the same rule News follows).
    /// </summary>
    private void OnHistoryChanged() => _ = InvokeAsync(() =>
    {
        _snapshotLinks ??= (_historyItems ?? Array.Empty<FeedItem>()).Select(i => i.Link).ToHashSet();
        _pendingNew = History.Items.Count(i => !_snapshotLinks.Contains(i.Link));
        StateHasChanged();
    });

    private void ApplyNewItems()
    {
        _historyItems = History.Items;
        _snapshotLinks = null;
        _pendingNew = 0;
        RecomputeRange();
        _ = LoadNewSinceVisitAsync();
    }

    public void Dispose() => History.Changed -= OnHistoryChanged;

    private async Task LoadNewSinceVisitAsync()
    {
        var result = await Feeds.GetAsync(); // warms the shared cache other pages read from
        // Same live-cache source News.razor's own "New" filter counts against - History.Items (90-day
        // persisted log) would disagree with what clicking through to News actually shows.
        _newSinceVisit = result.Items.Count(i => i.Published > Reading.LastNewsVisit);
        StateHasChanged();
    }

    private async Task LoadTrendingAsync(bool force = false)
    {
        _trendingLoading = true;
        StateHasChanged();
        try
        {
            var hfTask = HuggingFace.GetTrendingAsync(force);
            var reposTask = GitHubTrending.GetTrendingReposAsync(force: force);
            var devsTask = GitHubTrending.GetTrendingDevelopersAsync(force: force);
            await Task.WhenAll(hfTask, reposTask, devsTask);
            (_trendingModels, _) = hfTask.Result;
            _trendingRepos = reposTask.Result;
            _trendingDevelopers = devsTask.Result;
        }
        finally
        {
            _trendingLoading = false;
            StateHasChanged();
        }
    }

    private void SetRange(string range)
    {
        _range = range;
        _dayPage = 1;
        RecomputeRange();
        Nav.NavigateTo(range == "week" ? "/dashboard" : $"/dashboard?range={range}", replace: true);
    }

    /// <summary>Re-derives every range-scoped section (stat cards, trending panel, biggest stories, day-by-day) from the currently selected Today/Week/Month range - mirrors what Digest.razor used to compute for a hardcoded 7 days.</summary>
    private void RecomputeRange()
    {
        if (_historyItems is null) return;

        var cutoff = _range switch
        {
            "today" => new DateTimeOffset(DateTime.Today),
            "month" => DateTimeOffset.Now.AddDays(-30),
            _ => DateTimeOffset.Now.AddDays(-7),
        };
        _rangeItems = _historyItems.Where(i => i.Published >= cutoff).ToList();

        _activeSourceCount = _rangeItems.Select(i => i.SourceName).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        _topCategory = _rangeItems.GroupBy(i => i.Category)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .FirstOrDefault();

        _multiSourceStories = _rangeItems.Where(i => i.AlsoSeenOn.Length > 0).ToList();
        _biggestStories = _rangeItems
            .OrderByDescending(i => i.AlsoSeenOn.Length)
            .ThenByDescending(i => i.Published)
            .Take(6)
            .ToList();

        _byDay = _rangeItems
            .GroupBy(i => i.Published.LocalDateTime.Date)
            .OrderByDescending(g => g.Key)
            .Select(g => new DayRow
            {
                Date = g.Key,
                Count = g.Count(),
                TopCategories = g.GroupBy(i => i.Category)
                    .OrderByDescending(c => c.Count())
                    .Take(3)
                    .Select(c => (c.Key, c.Count()))
                    .ToList()
            })
            .ToList();

        _summary = ContentUi.Summarize(_historyItems, Reading.IsRead, Reading.ReadHistory.Select(h => h.At), DateTimeOffset.Now);
    }

    private static string Greeting() => DateTime.Now.Hour switch
    {
        < 5 => "Working late",
        < 12 => "Good morning",
        < 18 => "Good afternoon",
        _ => "Good evening"
    };

    private void ToggleSort(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
        _dayPage = 1;
    }

    private (List<DayRow> Rows, int Total) GetDayPage()
    {
        IEnumerable<DayRow> q = _byDay;

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var needle = _search.Trim();
            q = q.Where(d => d.TopCategories.Any(c => c.Category.Contains(needle, StringComparison.OrdinalIgnoreCase)));
        }

        q = (_sortColumn, _sortAscending) switch
        {
            ("date", true) => q.OrderBy(d => d.Date),
            ("count", true) => q.OrderBy(d => d.Count),
            ("count", false) => q.OrderByDescending(d => d.Count),
            (_, false) => q.OrderByDescending(d => d.Date),
            _ => q.OrderBy(d => d.Date),
        };

        var list = q.ToList();
        var page = list.Skip((_dayPage - 1) * _dayPageSize).Take(_dayPageSize).ToList();
        return (page, list.Count);
    }

    private sealed class DayRow
    {
        public DateTime Date { get; set; }
        public int Count { get; set; }
        public List<(string Category, int Count)> TopCategories { get; set; } = new();
    }

    private void DismissWelcome()
    {
        Reading.DismissWelcome();
        _welcomeDismissed = true;
    }

    private bool VisitedNews() => Reading.LastNewsVisit > DateTimeOffset.MinValue;
    private bool ReadSomething() => Reading.ReadHistory.Count > 0 || Reading.Bookmarks.Count > 0;
    private bool StartedLearning() => Kb.Learning.Any(m => Reading.CompletedStepCount(m.Title, m.Steps.Length) > 0);

    private void ToggleRead(FeedItem item) => Reading.ToggleRead(item);
    private void ToggleBookmark(FeedItem item) => Reading.ToggleBookmark(item);

    /// <summary>Opening an item marks it read - mirrors the same behavior on the News Feed, so read state stays consistent everywhere FeedItemCard appears.</summary>
    private void MarkAsRead(FeedItem item) => Reading.EnsureRead(item);

    /// <summary>Adapts a saved BookmarkItem to a FeedItem so it can render through the shared FeedItemCard.</summary>
    private static FeedItem ToFeedItem(BookmarkItem b) => new()
    {
        Title = b.Title,
        Link = b.Link,
        SourceName = b.SourceName,
        Category = b.Category,
        ContentType = b.ContentType,
        Level = b.Level,
        Tags = b.Tags,
        Published = b.SavedAt,
        Summary = b.Summary ?? "",
        ImageUrl = b.ImageUrl
    };
}

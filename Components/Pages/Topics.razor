@page "/topics"
@using AiPulse.Services
@inject FeedHistoryService History

<PageTitle>AiPulse · Topics</PageTitle>

@{
    var now = DateTimeOffset.Now;
    var since = DateTimeOffset.UtcNow.AddDays(-30);
    var recent = History.Items.Where(i => PublicFeeds.IsHeadline(i) && i.Published >= since).ToList();
    var topics = PublicFeeds.Topics(recent, since);
    var top = topics.Count > 0 ? topics[0].Count : 1;
    var featured = topics.Take(6).ToList();
}

<header class="tp-hero">
    <p class="tp-eyebrow">Last 30 days · @recent.Count.ToString("N0") stories</p>
    <h1 class="tp-h1"><Icon Name="trending-up" Size="24" /> Topics</h1>
    <p class="tp-lead">What the AI world has been writing about, grouped by subject. Pick one to read only those stories.</p>
</header>

@if (topics.Count == 0)
{
    <div class="tp-empty">
        <Icon Name="trending-up" Size="28" />
        <h2>No topics yet</h2>
        <p>Topics appear once the first news has been collected and tagged. That usually takes a few minutes after the app starts.</p>
        <a class="btn btn-outline-primary" href="news">Open the News Feed</a>
    </div>
}
else
{
    <section aria-labelledby="busiest" class="tp-section">
        <h2 id="busiest" class="tp-h2">Busiest right now</h2>
        <ol class="tp-featured">
            @foreach (var (topic, rank) in featured.Select((t, i) => (t, i + 1)))
            {
                var tagged = recent.Where(i => i.Tags.Any(t => string.Equals(t.Trim(), topic.Tag, StringComparison.OrdinalIgnoreCase))).ToList();
                var daily = ContentUi.DailyCounts(tagged.Select(i => i.Published), now, 14);
                var latest = tagged.OrderByDescending(i => i.Published).FirstOrDefault();
                <li>
                    <a class="tp-card" href="@PublicFeeds.TagPath(topic.Tag)">
                        <span class="tp-rank" aria-hidden="true">@rank.ToString("00")</span>
                        <span class="tp-card-name">#@topic.Tag</span>
                        <span class="tp-card-count"><strong>@topic.Count.ToString("N0")</strong> stories</span>
                        <svg class="tp-spark" viewBox="0 0 120 32" preserveAspectRatio="none" role="img" aria-label="@($"Daily stories over the last 14 days, peak {daily.Max()}")">
                            <path d="@(ContentUi.SparkPath(daily, 120, 32) + " L120,32 L0,32 Z")" class="tp-spark-fill" />
                            <path d="@ContentUi.SparkPath(daily, 120, 32)" class="tp-spark-line" />
                        </svg>
                        @if (latest is not null)
                        {
                            <span class="tp-card-latest">@latest.Title</span>
                        }
                    </a>
                </li>
            }
        </ol>
    </section>

    <section aria-labelledby="all-topics" class="tp-section">
        <h2 id="all-topics" class="tp-h2">All topics <span class="tp-h2-count">@topics.Count</span></h2>
        <ul class="tp-cloud">
            @foreach (var topic in topics)
            {
                <li>
                    <a class="tp-chip tp-tier-@ContentUi.TopicTier(topic.Count, top)" href="@PublicFeeds.TagPath(topic.Tag)" title="@topic.Count stories">
                        <span class="tp-chip-name">#@topic.Tag</span>
                        <span class="tp-chip-count">@topic.Count</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

<p class="tp-foot">
    Prefer a feed reader? <a href="feed.xml"><Icon Name="rss" Size="14" /> Subscribe to the Atom feed</a>.
    New releases of AI libraries and tools are on <a href="releases">Releases</a>.
</p>

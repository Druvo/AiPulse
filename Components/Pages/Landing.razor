@page "/"
@layout AiPulse.Components.Layout.LandingLayout
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject SiteStatsService StatsService

<PageTitle>AiPulse — Self-hosted AI news, tools &amp; learning dashboard</PageTitle>
<HeadContent>
    <meta name="robots" content="index, follow" />
    <meta name="description" content="AiPulse aggregates @_sources AI news, research and tool sources into one feed, plus a glossary, a tools comparison, and a @_modules-module learning path. Self-hosted, standalone, no AI required to run it." />
    <link rel="canonical" href="/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="AiPulse — Self-hosted AI news, tools &amp; learning dashboard" />
    <meta property="og:description" content="@_sources sources, one feed, zero API keys. A self-hosted dashboard to keep developers current on the AI world." />
    <meta property="og:image" content="/favicon.png" />
    <meta property="og:url" content="/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="AiPulse — Self-hosted AI news, tools &amp; learning dashboard" />
    <meta name="twitter:description" content="@_sources sources, one feed, zero API keys. Self-hosted, standalone, no AI required to run it." />
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "SoftwareApplication",
            "name": "AiPulse",
            "applicationCategory": "DeveloperApplication",
            "operatingSystem": "Self-hosted (.NET 8, cross-platform)",
            "description": "A standalone, self-hosted dashboard that aggregates AI news and research, a glossary, a tools comparison, and a structured learning roadmap into one feed. Runs with zero AI and no API keys.",
            "offers": {
                "@@type": "Offer",
                "price": "0",
                "priceCurrency": "USD"
            },
            "license": "https://opensource.org/licenses/MIT",
            "codeRepository": "https://github.com/Druvo/AiPulse",
            "url": "/"
        }
    </script>
</HeadContent>

@if (!_checkedAuth)
{
    return;
}

<div class="landing">
    <a class="skip-link" href="#landing-main">Skip to content</a>

    <header class="landing-nav">
        <div class="landing-nav__inner">
            <a class="landing-nav__brand" href="/" aria-label="AiPulse home">
                <img src="/img/logo-v1.png" alt="" class="app-logo" width="30" height="30" />
                <span>AiPulse</span>
            </a>
            <nav class="landing-nav__center" aria-label="Public">
                @foreach (var item in PublicSite.Menu)
                {
                    <a class="landing-nav__link" href="@item.Path">@item.Label</a>
                }
            </nav>
            <div class="landing-nav__right">
                <ThemeToggle />
                <a class="landing-btn landing-btn--text landing-nav__signin" href="/login">Sign in</a>
                <a class="landing-btn landing-btn--fill landing-nav__cta" href="/register">Get started</a>
                <details class="landing-menu">
                    <summary aria-label="Open menu"><Icon Name="menu" Size="20" /></summary>
                    <div class="landing-menu__panel">
                        @foreach (var item in PublicSite.Menu)
                        {
                            <a class="landing-menu__link" href="@item.Path">@item.Label <Icon Name="chevron-right" Size="15" /></a>
                        }
                        <a class="landing-menu__link" href="https://github.com/Druvo/AiPulse" target="_blank" rel="noopener">GitHub <Icon Name="external-link" Size="15" /></a>
                        <div class="landing-menu__ctas">
                            <a class="landing-btn landing-btn--outline" href="/login">Sign in</a>
                            <a class="landing-btn landing-btn--fill" href="/register">Get started</a>
                        </div>
                    </div>
                </details>
            </div>
        </div>
    </header>

    <main id="landing-main">
        <section class="landing-hero" aria-labelledby="hero-title">
            <div class="landing-hero__aurora" aria-hidden="true"><span></span><span></span><span></span></div>
            <div class="landing-hero__grid" aria-hidden="true"></div>

            <div class="landing-hero__copy">
                @if (_stats.ItemsLast24Hours > 0)
                {
                    var fresh = _stats.LastPolled ?? _stats.NewestItem;
                    <p class="landing-pill reveal" style="--i:0">
                        <span class="live-dot" aria-hidden="true"></span>
                        <span><strong>@_stats.ItemsLast24Hours.ToString("N0")</strong> new headlines in the last 24 hours@(fresh is { } when ? $" · updated {SiteStatsService.Ago(when, DateTimeOffset.UtcNow)}" : "")</span>
                    </p>
                }
                else
                {
                    <p class="landing-pill reveal" style="--i:0">
                        <Icon Name="github" Size="15" /><span>Open source · MIT licensed · .NET 8</span>
                    </p>
                }
                <h1 id="hero-title" class="landing-hero__headline reveal" style="--i:1">@_sources sources. One feed. <span class="text-gradient">Zero API keys.</span></h1>
                <p class="landing-hero__sub reveal" style="--i:2">
                    AiPulse aggregates AI news, research and tools into a single dashboard, plus a glossary,
                    a tools comparison, and a @_modules-module learning path. Self-hosted. No AI required to run it.
                </p>
                <div class="landing-hero__ctas reveal" style="--i:3">
                    <a class="landing-btn landing-btn--fill landing-btn--lg" href="/news">Browse the news feed <Icon Name="arrow-right" Size="18" /></a>
                    <a class="landing-btn landing-btn--outline landing-btn--lg" href="/register">Create a free account</a>
                </div>
                <ul class="landing-hero__meta reveal" style="--i:4">
                    <li><Icon Name="check-circle" Size="16" /> No API keys</li>
                    <li><Icon Name="check-circle" Size="16" /> Your data stays on your server</li>
                    <li><Icon Name="check-circle" Size="16" /> Installable on your phone</li>
                </ul>
            </div>

            @* A stylised, content-free picture of the dashboard: shapes only, plus the real live numbers. Decorative, so hidden from assistive tech. *@
            <div class="landing-preview reveal" style="--i:5" aria-hidden="true">
                <div class="preview-window">
                    <div class="preview-bar"><span></span><span></span><span></span><em>aipulse / news</em></div>
                    <div class="preview-body">
                        <div class="preview-side">
                            <i class="on"></i><i></i><i></i><i></i><i></i><i class="sep"></i><i></i><i></i>
                        </div>
                        <div class="preview-main">
                            <div class="preview-stats">
                                <div><b>@_sources</b><small>sources</small></div>
                                <div><b>@(_stats.ItemsLast24Hours > 0 ? _stats.ItemsLast24Hours.ToString("N0") : _terms.ToString())</b><small>@(_stats.ItemsLast24Hours > 0 ? "today" : "terms")</small></div>
                                <div><b>@_modules</b><small>modules</small></div>
                            </div>
                            @for (var i = 0; i < 3; i++)
                            {
                                <div class="preview-card" style="--d:@(i)">
                                    <span class="preview-thumb"></span>
                                    <span class="preview-lines"><span></span><span></span><span class="short"></span></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="preview-float preview-float--a"><Icon Name="sparkle" Size="16" /> Cross-source dedup</div>
                <div class="preview-float preview-float--b"><Icon Name="bell" Size="16" /> Release alerts</div>
            </div>
        </section>

        <section class="landing-numbers" aria-label="AiPulse in numbers">
            <div class="landing-numbers__inner">
                <div class="number reveal-on-scroll"><span class="number__value">@_sources</span><span class="number__label">sources tracked</span></div>
                @if (_stats.ItemsLast24Hours > 0)
                {
                    <div class="number reveal-on-scroll"><span class="number__value">@_stats.ItemsLast24Hours.ToString("N0")</span><span class="number__label">headlines in 24 hours</span></div>
                }
                else
                {
                    <div class="number reveal-on-scroll"><span class="number__value">@_stats.PollMinutes<small>min</small></span><span class="number__label">between feed refreshes</span></div>
                }
                <div class="number reveal-on-scroll"><span class="number__value">@_terms</span><span class="number__label">glossary terms</span></div>
                <div class="number reveal-on-scroll"><span class="number__value">@_modules</span><span class="number__label">learning modules</span></div>
            </div>
        </section>

        <section class="landing-sources" aria-labelledby="sources-title">
            <p id="sources-title" class="landing-sources__title">Pulling from the places the AI world actually talks</p>
            <ul class="landing-sources__list">
                @foreach (var s in SourceKinds)
                {
                    <li>@s</li>
                }
            </ul>
            <a class="landing-link" href="/coverage">See every source we follow <Icon Name="arrow-right" Size="15" /></a>
        </section>

        <section class="landing-section" id="features" aria-labelledby="features-title">
            <div class="landing-section__head reveal-on-scroll">
                <p class="eyebrow">Everything in one place</p>
                <h2 id="features-title">One dashboard instead of fifteen tabs</h2>
                <p class="landing-section__lead">Read, look things up, compare tools and learn, without hopping between sites or handing your reading habits to anyone.</p>
            </div>
            <div class="landing-bento">
                <article class="bento-cell bento-cell--lead bento-span-2x2 reveal-on-scroll">
                    <span class="bento-icon"><Icon Name="rss" Size="22" /></span>
                    <h3>Every AI headline, one feed</h3>
                    <p>News, research and tool sources (arXiv, Hacker News, GitHub, Reddit, YouTube, RSS). Cross-source dedup means the same story from twelve outlets shows once, not twelve times.</p>
                    <div class="bento-chips" aria-hidden="true"><span>News</span><span>Research</span><span>Releases</span><span>Tutorials</span><span>Video</span></div>
                    <a class="bento-link" href="/news">Open the feed <Icon Name="arrow-right" Size="15" /></a>
                </article>

                <article class="bento-cell bento-span-2x1 reveal-on-scroll">
                    <span class="bento-icon"><Icon Name="trending-up" Size="20" /></span>
                    <h3>Explore</h3>
                    <p>GitHub Trending and Hugging Face models and datasets, refreshed daily with cached results so a slow scrape never blocks the page.</p>
                    <a class="bento-link" href="/explore">Explore <Icon Name="arrow-right" Size="15" /></a>
                </article>

                <article class="bento-cell reveal-on-scroll">
                    <span class="bento-icon"><Icon Name="book" Size="20" /></span>
                    <h3>Glossary</h3>
                    <p>@_terms developer-focused definitions, each with live mentions from the feed.</p>
                    <a class="bento-link" href="/glossary">Look it up <Icon Name="arrow-right" Size="15" /></a>
                </article>

                <article class="bento-cell reveal-on-scroll">
                    <span class="bento-icon"><Icon Name="tool" Size="20" /></span>
                    <h3>Tools &amp; Tips</h3>
                    <p>The right AI dev tool for the task, side by side.</p>
                    <a class="bento-link" href="/tools">Compare tools <Icon Name="arrow-right" Size="15" /></a>
                </article>

                <article class="bento-cell bento-span-1x2 reveal-on-scroll">
                    <span class="bento-icon"><Icon Name="graduation-cap" Size="20" /></span>
                    <h3>Learning Hub <span class="bento-badge">Members</span></h3>
                    <p>A @_modules-module roadmap from how LLMs actually work up through RAG, tool use, agents and MCP, with progress tracking, spaced-repetition resurfacing and notes you can export to Obsidian.</p>
                    <a class="bento-link" href="/login?ReturnUrl=%2Flearn">Sign in to open <Icon Name="arrow-right" Size="15" /></a>
                </article>

                <article class="bento-cell reveal-on-scroll">
                    <span class="bento-icon"><Icon Name="sparkle" Size="20" /></span>
                    <h3>Ask AiPulse <span class="bento-badge">Members</span></h3>
                    <p>Answers built only from AiPulse's own sources, every sentence cited.</p>
                    <a class="bento-link" href="/login?ReturnUrl=%2Fask">Sign in to ask <Icon Name="arrow-right" Size="15" /></a>
                </article>

                <article class="bento-cell reveal-on-scroll">
                    <span class="bento-icon"><Icon Name="key" Size="20" /></span>
                    <h3>Free AI APIs <span class="bento-badge">Members</span></h3>
                    <p>A maintained directory of free-tier LLM APIs: limits, models, sign-up links.</p>
                    <a class="bento-link" href="/login?ReturnUrl=%2Ffree-apis">Sign in to open <Icon Name="arrow-right" Size="15" /></a>
                </article>

                <article class="bento-cell bento-cell--dark bento-span-2x1 reveal-on-scroll" id="self-hosted">
                    <span class="bento-icon"><Icon Name="shield" Size="20" /></span>
                    <h3>Self-hosted &amp; standalone</h3>
                    <p>Runs with zero AI and no API keys. Your reading history, bookmarks and chat logs stay on your own machine. MIT licensed, yours to run and modify.</p>
                </article>
            </div>
        </section>

        <section class="landing-section landing-steps" aria-labelledby="steps-title">
            <div class="landing-section__head reveal-on-scroll">
                <p class="eyebrow">How it works</p>
                <h2 id="steps-title">Running in three steps</h2>
            </div>
            <ol class="steps">
                <li class="step reveal-on-scroll">
                    <span class="step__num">1</span>
                    <h3>Run it</h3>
                    <p>Clone the repo and start it with the .NET 8 SDK, or use the included Docker setup.</p>
                    <pre class="step__code"><code>git clone https://github.com/Druvo/AiPulse.git
cd AiPulse &amp;&amp; dotnet run</code></pre>
                </li>
                <li class="step reveal-on-scroll">
                    <span class="step__num">2</span>
                    <h3>Pick your sources</h3>
                    <p>About 200 are seeded; switch on the ones you care about, add any RSS/Atom feed, import OPML, or scrape a page with no feed.</p>
                </li>
                <li class="step reveal-on-scroll">
                    <span class="step__num">3</span>
                    <h3>Read, learn, get alerts</h3>
                    <p>New items arrive in the background; release and watchlist alerts reach your browser, Slack or Discord.</p>
                </li>
            </ol>
        </section>

        <section class="landing-section landing-faq" aria-labelledby="faq-title">
            <div class="landing-section__head reveal-on-scroll">
                <p class="eyebrow">Questions</p>
                <h2 id="faq-title">Frequently asked</h2>
            </div>
            <div class="faq">
                <details class="faq__item" open>
                    <summary>Is AiPulse free?</summary>
                    <p>Yes. It is open source under the MIT licence: run it, change it, host it for your team. There is no paid tier.</p>
                </details>
                <details class="faq__item">
                    <summary>Do I need an OpenAI or other AI API key?</summary>
                    <p>No. The feed, glossary, tools matrix and learning path all work with zero AI. Ask AiPulse and card summaries are optional extras an admin can switch on by connecting a provider (for example a local Ollama).</p>
                </details>
                <details class="faq__item">
                    <summary>Where is my data stored?</summary>
                    <p>On the server you run it on, in a local SQLite database and files under App_Data. Nothing is sent to a third-party service unless you configure one.</p>
                </details>
                <details class="faq__item">
                    <summary>Can I add my own sources?</summary>
                    <p>Yes. Admins manage sources from the Sources page: add any RSS/Atom feed, import OPML from another reader, or scrape a page with XPath selectors. No restart needed.</p>
                </details>
                <details class="faq__item">
                    <summary>Does it work on my phone?</summary>
                    <p>Yes. The site is responsive and installable (Add to Home Screen). You can also read it from Fever-compatible RSS apps such as Reeder.</p>
                </details>
                <details class="faq__item">
                    <summary>Can several people use one install?</summary>
                    <p>Yes. Each account has its own reading state, bookmarks and settings. New sign-ups wait for an admin's approval.</p>
                </details>
            </div>
        </section>

        <section class="landing-cta" aria-labelledby="cta-title">
            <div class="landing-cta__card reveal-on-scroll">
                <div class="landing-cta__glow" aria-hidden="true"></div>
                <h2 id="cta-title">Stay current on AI without the tab sprawl.</h2>
                <p>Free forever. MIT licensed. Yours to run.</p>
                <div class="landing-hero__ctas">
                    <a class="landing-btn landing-btn--light landing-btn--lg" href="/register">Get started free <Icon Name="arrow-right" Size="18" /></a>
                    <a class="landing-btn landing-btn--ghost-light landing-btn--lg" href="https://github.com/Druvo/AiPulse" target="_blank" rel="noopener"><Icon Name="github" Size="18" /> View on GitHub</a>
                </div>
            </div>
        </section>
    </main>

    <footer class="landing-footer">
        <div class="landing-footer__inner">
            <div class="landing-footer__brand">
                <a class="landing-nav__brand" href="/">
                    <img src="/img/logo-v1.png" alt="" class="app-logo" width="28" height="28" />
                    <span>AiPulse</span>
                </a>
                <p>Your AI reading &amp; learning station. Self-hosted, standalone, no API keys.</p>
            </div>
            <nav class="landing-footer__col" aria-label="Explore">
                <p class="landing-footer__head">Explore</p>
                @foreach (var item in PublicSite.Menu)
                {
                    <a href="@item.Path">@item.Label</a>
                }
            </nav>
            <nav class="landing-footer__col" aria-label="Project">
                <p class="landing-footer__head">Project</p>
                <a href="https://github.com/Druvo/AiPulse" target="_blank" rel="noopener">GitHub</a>
                <a href="https://github.com/Druvo/AiPulse/blob/main/LICENSE" target="_blank" rel="noopener">MIT licence</a>
                <a href="/coverage">Sources we follow</a>
                <a href="/feed.xml">Atom feed</a>
            </nav>
            <nav class="landing-footer__col" aria-label="Account">
                <p class="landing-footer__head">Account</p>
                <a href="/login">Sign in</a>
                <a href="/register">Create an account</a>
                <a href="/forgot-password">Forgot password</a>
            </nav>
        </div>
        <p class="landing-footer__sig">Made with <span class="heart" aria-label="love">♥</span> by <a href="https://github.com/Druvo" target="_blank" rel="noopener">Druvo</a> · © AiPulse contributors</p>
    </footer>
</div>

@code {
    private bool _checkedAuth;

    /// <summary>Kinds of source the seeded list actually contains (see README / Data) - named, never logos we don't have rights to.</summary>
    private static readonly string[] SourceKinds =
        { "arXiv", "Hacker News", "GitHub", "Hugging Face", "Reddit", "YouTube", "Mastodon", "dev.to", "Product Hunt", "RSS & Atom" };

    // Counted from the live knowledge base so the page can never claim a number the site no longer has (it said "202 sources"
    // long after the active list had been cut to about 80).
    private SiteStats _stats = new(0, 0, 0, 0, null, null, 15);
    private int _sources;
    private int _terms;
    private int _modules;

    protected override async Task OnInitializedAsync()
    {
        _stats = StatsService.Current;
        _sources = _stats.ActiveSources;
        _terms = _stats.GlossaryTerms;
        _modules = _stats.LearningModules;

        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/dashboard");
            return;
        }
        _checkedAuth = true;
    }
}

@page "/register"
@layout AiPulse.Components.Layout.EmptyLayout
@rendermode InteractiveServer
@inject UserService Users

<PageTitle>AiPulse · Register</PageTitle>
<HeadContent>
    <meta name="robots" content="index, follow" />
    <meta name="description" content="Create an AiPulse account - a standalone, self-hosted dashboard to keep developers current on the AI world." />
    <link rel="canonical" href="/register" />
    <meta property="og:title" content="AiPulse - Register" />
    <meta property="og:description" content="A standalone, self-hosted AI news &amp; learning dashboard. No API keys required." />
</HeadContent>

<div class="login-shell-inner">
<div class="login-card">
    @if (_registered)
    {
        <div class="auth-icon" aria-hidden="true"><Icon Name="check-circle" Size="22" /></div>
        <h1 class="auth-title">@(Users.RequireApproval ? "Almost there" : "You're in")</h1>
        <div class="alert alert-success" role="status">
            @(Users.RequireApproval
                ? "Account created. An admin needs to approve it before you can sign in."
                : "Account created - you can sign in now.")
        </div>
        <a class="btn btn-primary w-100" href="/login">@(Users.RequireApproval ? "Back to sign in" : "Sign in") <Icon Name="arrow-right" Size="17" /></a>
    }
    else
    {
        <div class="auth-icon" aria-hidden="true"><Icon Name="sparkle" Size="22" /></div>
        <h1 class="auth-title">Create your account</h1>
        <p class="auth-sub">Free, self-hosted, and yours. Takes about a minute.</p>

        <EditForm Model="_form" OnValidSubmit="Submit" class="auth-form">
            @if (_error is not null)
            {
                <div class="alert alert-danger py-2" role="alert">@_error</div>
            }
            <div class="auth-field">
                <label class="form-label" for="reg-username">Username</label>
                <input id="reg-username" class="form-control" @bind="_form.Username" autocomplete="username" autocapitalize="none" spellcheck="false" minlength="3" required />
            </div>
            <div class="auth-field">
                <label class="form-label" for="reg-email">Email <span class="text-muted small fw-normal">(for password reset)</span></label>
                <input id="reg-email" type="email" class="form-control" @bind="_form.Email" autocomplete="email" />
            </div>
            <div class="auth-field">
                <label class="form-label" for="reg-password">Password</label>
                <div class="password-field">
                    <input id="reg-password" type="password" class="form-control" @bind="_form.Password" @bind:event="oninput" autocomplete="new-password" aria-describedby="reg-strength" required />
                    <button type="button" class="password-reveal" data-reveal="reg-password" aria-pressed="false" aria-label="Show password">
                        <Icon Name="eye" Size="18" CssClass="eye-on" /><Icon Name="eye-off" Size="18" CssClass="eye-off" />
                    </button>
                </div>
                <PasswordMeter Password="@_form.Password" Id="reg-strength" />
            </div>
            <div class="auth-field">
                <label class="form-label" for="reg-confirm">Confirm password</label>
                <input id="reg-confirm" type="password" class="form-control" @bind="_form.ConfirmPassword" autocomplete="new-password" required />
            </div>
            <button type="submit" class="btn btn-primary mt-2">Create account <Icon Name="arrow-right" Size="17" /></button>
        </EditForm>

        <p class="auth-alt">Already have an account? <a href="/login">Sign in</a></p>
    }
</div>
<p class="login-signature"><a href="/">Back to the home page</a></p>
</div>

@code {
    private readonly RegisterForm _form = new();
    private string? _error;
    private bool _registered;

    private async Task Submit()
    {
        _error = null;
        if (_form.Password != _form.ConfirmPassword)
        {
            _error = "Passwords don't match.";
            return;
        }

        var (success, error) = await Users.RegisterAsync(_form.Username, _form.Password, _form.Email);
        if (!success)
        {
            _error = error;
            return;
        }

        _registered = true;
    }

    private sealed class RegisterForm
    {
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}

@page "/login/clerk"
@layout AiPulse.Components.Layout.EmptyLayout

<PageTitle>AiPulse · Signing in</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="login-shell-inner">
    <div class="login-card text-center">
        <div class="auth-icon mx-auto" aria-hidden="true"><Icon Name="lock" Size="22" /></div>
        @if (_clerk is { } clerk)
        {
            <h1 class="auth-title">Signing you in…</h1>
            <p class="auth-sub mb-0">This only takes a moment.</p>
            <div id="clerk-finish" class="mt-3" data-host="@clerk.Host" data-key="@clerk.PublishableKey" data-return-url="@(ReturnUrl ?? "/dashboard")" data-remember="@(Remember ?? "true")"></div>
        }
        else
        {
            <h1 class="auth-title">Clerk sign-in is off</h1>
            <p class="auth-sub">Sign-in with Clerk is not turned on here.</p>
            <a class="btn btn-primary w-100" href="/login">Back to sign in</a>
        }
    </div>
</div>

@code {
    [Inject] private ClerkAuthService Clerk { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string? Remember { get; set; }
    private (string PublishableKey, string Host)? _clerk;

    protected override async Task OnInitializedAsync() => _clerk = await Clerk.GetActiveAsync();
}

@page "/sources"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject KnowledgeBaseService Kb
@inject FeedAggregatorService Feeds
@inject SourceHealthService Health
@inject WebSubService WebSub
@inject OpmlService Opml
@inject FeedDiscoveryService Discovery
@inject IJSRuntime JS
@inject IWebHostEnvironment Env

<PageTitle>AiPulse · Sources</PageTitle>

<div class="page-header">
    <h1><Icon Name="database" Size="22" /> Sources</h1>
    <p class="lead">Where your updates come from. Add, edit or disable feeds here; changes apply immediately, no restart needed.</p>
</div>

@{
    var totalFailing = TotalFailingCount();
    var enabledCount = Kb.SourceRecords.Count(s => s.Enabled);
}

<div class="kpis">
    <div class="kpi"><span class="kpi-num">@Kb.SourceRecords.Count</span><span class="kpi-label">Sources</span></div>
    <div class="kpi"><span class="kpi-num">@enabledCount</span><span class="kpi-label">Enabled</span></div>
    <div class="kpi"><span class="kpi-num">@(Kb.SourceRecords.Count - enabledCount)</span><span class="kpi-label">Disabled</span></div>
    <button type="button" class="kpi kpi-btn @(totalFailing > 0 ? "kpi-bad" : "")" @onclick='() => SetStatus(totalFailing > 0 ? "failing" : "")' aria-label="@($"{totalFailing} failing sources, show them")">
        <span class="kpi-num">@totalFailing</span><span class="kpi-label">Failing now</span>
    </button>
</div>

@if (_opmlResult is { } r)
{
    <div class="alert @(r.Unreachable > 0 ? "alert-warning" : "alert-success") py-2 small" role="status">
        OPML import: added @r.Added new source(s)@(r.Skipped > 0 ? $", skipped {r.Skipped} already-present" : "").
        @if (r.Unreachable > 0)
        {
            <text> @r.Unreachable of them didn't respond to a quick check just now; still added, but worth a look below.</text>
        }
    </div>
}
else if (OpmlAdded is not null)
{
    <div class="alert @(OpmlUnreachable is > 0 ? "alert-warning" : "alert-success") py-2 small" role="status">
        OPML import: added @OpmlAdded new source(s)@(OpmlSkipped is > 0 ? $", skipped {OpmlSkipped} already-present" : "").
        @if (OpmlUnreachable is > 0)
        {
            <text> @OpmlUnreachable of them didn't respond to a quick check just now; still added, but worth a look below.</text>
        }
    </div>
}
@if (_bulkMessage is not null)
{
    <div class="alert alert-success py-2 small" role="status">@_bulkMessage</div>
}

<div class="actions-bar">
    <button class="btn btn-primary" @onclick="ToggleAddForm" aria-expanded="@(_showAddForm ? "true" : "false")">
        <Icon Name="@(_showAddForm ? "check" : "database")" Size="15" /> @(_showAddForm ? "Close form" : "Add source")
    </button>
    <a class="btn btn-outline-secondary" href="/opml/export"><Icon Name="download" Size="15" /> Export OPML</a>
    <label class="btn btn-outline-secondary file-btn @(_opmlImporting ? "disabled" : "")" for="opml-file">
        <Icon Name="arrow-up" Size="15" /> Import OPML
    </label>
    <InputFile id="opml-file" OnChange="HandleOpmlFileSelected" accept=".opml,.xml" class="visually-hidden" disabled="@_opmlImporting" />
    @if (_opmlImporting)
    {
        <div class="import-progress" role="status">
            <div class="progress" style="width:160px;height:8px;" aria-hidden="true">
                <div class="progress-bar" style="width:@(_opmlProgress?.PercentComplete ?? 0)%"></div>
            </div>
            <span class="x-small text-muted">
                Checking @(_opmlProgress?.Done ?? 0)/@(_opmlProgress?.Total ?? 0)@(string.IsNullOrWhiteSpace(_opmlProgress?.CurrentName) ? "" : $" · {_opmlProgress!.CurrentName}")
            </span>
        </div>
    }
</div>

@if (_showAddForm)
{
    <section class="form-card" aria-labelledby="add-title">
        <h2 id="add-title" class="form-title">Add a source</h2>
        <EditForm Model="_form" OnValidSubmit="AddSource">
            @SourceFormFields("new", true)
            <div class="form-actions">
                <button type="submit" class="btn btn-success">Save source</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ToggleAddForm">Cancel</button>
            </div>
        </EditForm>
    </section>
}

<div class="filters">
    <div class="f-search">
        <label class="visually-hidden" for="src-search">Search sources</label>
        <input id="src-search" type="search" class="form-control" placeholder="Search name, category, tag, note…" autocomplete="off"
               value="@_search" @oninput="e => { _search = (string)e.Value!; _page = 1; }" />
    </div>
    <div>
        <label class="visually-hidden" for="src-cat">Category</label>
        <select id="src-cat" class="form-select" value="@_categoryFilter" @onchange="e => SetCategory((string?)e.Value)">
            <option value="">All categories</option>
            @foreach (var c in Kb.SourceRecords.Select(s => s.Category).Distinct().OrderBy(c => c))
            {
                <option value="@c">@c</option>
            }
        </select>
    </div>
    <div>
        <label class="visually-hidden" for="src-status">Status</label>
        <select id="src-status" class="form-select" value="@_statusFilter" @onchange="e => SetStatus((string?)e.Value)">
            <option value="">Any status</option>
            <option value="enabled">Enabled</option>
            <option value="disabled">Disabled</option>
            <option value="failing">Failing now</option>
            <option value="nodata">No uptime data yet</option>
        </select>
    </div>
    <div class="seg" role="group" aria-label="Layout">
        <button type="button" class="seg-btn @(_grouped ? "active" : "")" aria-pressed="@(_grouped ? "true" : "false")" @onclick="() => _grouped = true"><Icon Name="database" Size="14" /> Grouped</button>
        <button type="button" class="seg-btn @(!_grouped ? "active" : "")" aria-pressed="@(!_grouped ? "true" : "false")" @onclick="() => _grouped = false"><Icon Name="list" Size="14" /> Table</button>
    </div>
</div>

@if (_selected.Count > 0)
{
    <div class="bulk-bar" role="region" aria-label="Bulk actions">
        <span class="bulk-count">@_selected.Count selected</span>
        <button class="btn btn-sm btn-outline-success" disabled="@_bulkBusy" @onclick="() => BulkEnable(true)"><Icon Name="check" Size="14" /> Enable</button>
        <button class="btn btn-sm btn-outline-secondary" disabled="@_bulkBusy" @onclick="() => BulkEnable(false)"><Icon Name="eye-off" Size="14" /> Disable</button>
        <button class="btn btn-sm btn-outline-danger" disabled="@_bulkBusy" @onclick="BulkDelete"><Icon Name="trash" Size="14" /> Delete</button>
        <button class="btn btn-sm btn-link" @onclick="() => _selected.Clear()">Clear selection</button>
    </div>
}

@{
    _uptime = UptimeHistory.ReadAll(Env.ContentRootPath);
}
@if (_grouped)
{
    var groups = GetGroups();
    @if (groups.Count == 0)
    {
        <div class="empty-box"><EmptyState Icon="search" Title="No sources match these filters" ActionText="Clear filters" OnAction="ClearFilters" /></div>
    }
    @foreach (var group in groups)
    {
        var failing = group.Rows.Count(x => x.FailStreak > 0);
        <details class="group" @key="group.Category" open="@(group.Rows.Count <= 15 || !string.IsNullOrWhiteSpace(_search) || _statusFilter != "")">
            <summary class="group-head">
                <span class="group-name">@group.Category</span>
                <span class="group-meta">@group.Rows.Count source@(group.Rows.Count == 1 ? "" : "s") · @group.Rows.Count(x => x.Source.Enabled) enabled</span>
                @if (failing > 0)
                {
                    <span class="status-chip chip-warn">@failing failing</span>
                }
                <span class="group-chev" aria-hidden="true"></span>
            </summary>
            @SourceTable(group.Rows)
        </details>
    }
}
else
{
    var (pageRows, totalRows) = GetPage();
    @if (totalRows == 0)
    {
        <div class="empty-box"><EmptyState Icon="search" Title="No sources match these filters" ActionText="Clear filters" OnAction="ClearFilters" /></div>
    }
    else
    {
        <div class="table-card">@SourceTable(pageRows)</div>
        <Pager TotalItems="totalRows" @bind-CurrentPage="_page" @bind-PageSize="_pageSize" />
    }
}

<div class="tip-box">
    <strong>Tip:</strong> any RSS/Atom URL works. A GitHub project's releases feed is <code>https://github.com/&lt;owner&gt;/&lt;repo&gt;/releases.atom</code>;
    a subreddit is <code>https://www.reddit.com/r/&lt;name&gt;/.rss</code>; most blogs expose <code>/feed</code> or <code>/rss.xml</code>.
</div>

@code {
    private string _categoryFilter = "";
    private string _statusFilter = "";
    private readonly HashSet<int> _selected = new();
    private bool _bulkBusy;
    private string? _bulkMessage;
    private IReadOnlyDictionary<string, Dictionary<string, bool>> _uptime = new Dictionary<string, Dictionary<string, bool>>();

    private void SetStatus(string? status)
    {
        _statusFilter = status ?? "";
        _page = 1;
    }

    private void SetCategory(string? category)
    {
        _categoryFilter = category ?? "";
        _page = 1;
    }

    private void ClearFilters()
    {
        _search = "";
        _categoryFilter = "";
        _statusFilter = "";
        _page = 1;
    }

    private void ToggleSelect(int id, bool on)
    {
        if (on) _selected.Add(id); else _selected.Remove(id);
    }

    private void ToggleSelectAll(IEnumerable<SourceRow> rows, bool on)
    {
        foreach (var r in rows)
        {
            if (on) _selected.Add(r.Source.Id); else _selected.Remove(r.Source.Id);
        }
    }

    private async Task BulkEnable(bool enabled)
    {
        _bulkBusy = true;
        try
        {
            var targets = Kb.SourceRecords.Where(s => _selected.Contains(s.Id) && s.Enabled != enabled).ToList();
            foreach (var s in targets)
                await Kb.UpdateSourceAsync(AdminTable.WithEnabled(s, enabled));
            _bulkMessage = $"{(enabled ? "Enabled" : "Disabled")} {targets.Count} source{(targets.Count == 1 ? "" : "s")}.";
            _selected.Clear();
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private async Task BulkDelete()
    {
        var targets = Kb.SourceRecords.Where(s => _selected.Contains(s.Id)).ToList();
        if (targets.Count == 0) return;
        var names = string.Join(", ", targets.Take(5).Select(s => s.Name)) + (targets.Count > 5 ? $" and {targets.Count - 5} more" : "");
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete {targets.Count} source{(targets.Count == 1 ? "" : "s")} ({names})? This can't be undone.")) return;
        _bulkBusy = true;
        try
        {
            foreach (var s in targets)
                await Kb.DeleteSourceAsync(s.Id);
            _bulkMessage = $"Deleted {targets.Count} source{(targets.Count == 1 ? "" : "s")}.";
            _selected.Clear();
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private IReadOnlyList<UptimeDay> StripFor(string name) =>
        UptimeHistory.Strip(_uptime.TryGetValue(name, out var days) ? days : null, DateOnly.FromDateTime(DateTime.Now), 30);

    private RenderFragment SourceTable(IReadOnlyList<SourceRow> rows)
    {
        var allSelected = rows.Count > 0 && rows.All(r => _selected.Contains(r.Source.Id));
        return @<table class="src-table">
            <thead>
                <tr>
                    <th scope="col" class="c-check">
                        <input type="checkbox" class="row-check" aria-label="Select all shown sources" checked="@allSelected" @onchange="e => ToggleSelectAll(rows, (bool)e.Value!)" />
                    </th>
                    @if (_grouped)
                    {
                        <th scope="col">Source</th>
                        <th scope="col">Type</th>
                        <th scope="col">Status</th>
                        <th scope="col">Uptime (30d)</th>
                    }
                    else
                    {
                        <th scope="col" aria-sort="@AriaSort("name")">@SortBtn("name", "Source")</th>
                        <th scope="col" aria-sort="@AriaSort("category")">@SortBtn("category", "Type")</th>
                        <th scope="col" aria-sort="@AriaSort("status")">@SortBtn("status", "Status")</th>
                        <th scope="col" aria-sort="@AriaSort("uptime")">@SortBtn("uptime", "Uptime (30d)")</th>
                    }
                    <th scope="col">Push</th>
                    <th scope="col" class="c-actions"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var s = row.Source;
                    var strip = StripFor(s.Name);
                    var pct = UptimeHistory.UptimePercent(strip);
                    var tone = UptimeHistory.Tone(pct);
                    <tr class="@(_editingId == s.Id ? "is-editing" : "") @(_selected.Contains(s.Id) ? "is-selected" : "")" @key="s.Id">
                        <td class="c-check">
                            <input type="checkbox" class="row-check" aria-label="@($"Select {s.Name}")" checked="@_selected.Contains(s.Id)" @onchange="e => ToggleSelect(s.Id, (bool)e.Value!)" />
                        </td>
                        <td class="c-source">
                            <div class="src-name">
                                @if (HostOf(s.Url) is { } host)
                                {
                                    <img src="/favicon-proxy/@host" alt="" loading="lazy" class="source-favicon" onerror="this.style.display='none'" />
                                }
                                <a href="@s.Url" target="_blank" rel="noopener">@s.Name</a>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(s.Note))
                            {
                                <p class="src-note">@s.Note</p>
                            }
                            @if (s.Tags.Length > 0)
                            {
                                <div class="src-tags">
                                    @foreach (var t in s.Tags.Take(4)) { <span class="mini-chip">@t</span> }
                                    @if (s.Tags.Length > 4) { <span class="mini-chip">+@(s.Tags.Length - 4)</span> }
                                </div>
                            }
                        </td>
                        <td data-label="Type">
                            <div class="chips">
                                <span class="mini-chip">@s.Category</span>
                                <span class="badge ctype-@s.ContentType.ToLower()">@s.ContentType</span>
                                <span class="badge level-@s.Level.ToLower()">@s.Level</span>
                            </div>
                        </td>
                        <td data-label="Status">
                            <div class="chips">
                                @if (s.Enabled) { <span class="status-chip chip-ok"><span class="dot" aria-hidden="true"></span>Enabled</span> }
                                else { <span class="status-chip chip-muted"><span class="dot" aria-hidden="true"></span>Disabled</span> }
                                @if (row.FailStreak > 0)
                                {
                                    <span class="status-chip chip-bad" title="@row.FailStreak consecutive failed fetch(es)">@row.FailStreak failed</span>
                                }
                                @if (s.IsScrape) { <span class="mini-chip" title="Scraped HTML page, no RSS feed">scrape</span> }
                                @if (s.FullTextFetch) { <span class="mini-chip" title="Fetches the full article text">full text</span> }
                            </div>
                        </td>
                        <td data-label="Uptime (30d)">
                            <div class="uptime">
                                <span class="spark" role="img" aria-label="@(pct is null ? "No uptime data yet" : $"{pct}% of recorded days healthy over the last 30 days")">
                                    @foreach (var d in strip)
                                    {
                                        <span class="spark-day d-@d.ToString().ToLowerInvariant()"></span>
                                    }
                                </span>
                                <span class="uptime-pct tone-@tone">@(pct is null ? "no data" : $"{pct}%")</span>
                            </div>
                        </td>
                        <td data-label="Push">
                            @if (!WebSub.Enabled)
                            {
                                <span class="muted-text" title="Set WebSub:PublicBaseUrl in appsettings.json to enable">off</span>
                            }
                            else if (_webSubStatus.TryGetValue(s.Id, out var sub))
                            {
                                @if (sub.Status == "Verified")
                                {
                                    <span class="status-chip chip-ok" title="@(sub.LeaseExpiresAt is { } exp ? $"Renews before {exp.ToLocalTime():g}" : "")">live</span>
                                }
                                else if (sub.Status == "Pending")
                                {
                                    <span class="status-chip chip-warn">pending</span>
                                }
                                else
                                {
                                    <span class="muted-text">unavailable</span>
                                }
                            }
                            else
                            {
                                <span class="muted-text">-</span>
                            }
                        </td>
                        <td class="c-actions">
                            <button class="icon-btn" title="Edit" aria-label="@($"Edit {s.Name}")" @onclick="() => StartEdit(s)"><Icon Name="settings" Size="16" /></button>
                            <button class="icon-btn danger" title="Delete" aria-label="@($"Delete {s.Name}")" @onclick="() => DeleteSource(s.Id)"><Icon Name="trash" Size="16" /></button>
                        </td>
                    </tr>
                    @if (_editingId == s.Id)
                    {
                        <tr class="edit-row">
                            <td colspan="7">
                                <EditForm Model="_form" OnValidSubmit="SaveEdit">
                                    <p class="form-title">Edit @s.Name</p>
                                    @SourceFormFields("edit", false)
                                    <div class="form-actions">
                                        <button type="submit" class="btn btn-success">Save</button>
                                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </EditForm>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>;
    }

    private string AriaSort(string column) => _sortColumn != column ? "none" : _sortAscending ? "ascending" : "descending";

    private RenderFragment SortBtn(string column, string label) => @<button type="button" class="sort-btn @(_sortColumn == column ? "active" : "")" @onclick="() => ToggleSort(column)">
        @label <span aria-hidden="true">@(_sortColumn != column ? "↕" : _sortAscending ? "↑" : "↓")</span>
    </button>;

    private RenderFragment SourceFormFields(string p, bool isNew) => @<div class="form-grid">
        <div class="fg-name">
            <label class="f-label" for="@($"{p}-name")">Name</label>
            <input id="@($"{p}-name")" class="form-control" @bind="_form.Name" />
        </div>
        <div class="fg-url">
            <label class="f-label" for="@($"{p}-url")">Feed URL (RSS/Atom)@(isNew ? " or the site's homepage" : "")</label>
            <div class="input-group">
                <input id="@($"{p}-url")" class="form-control" type="url" inputmode="url" placeholder="https://…" @bind="_form.Url" @bind:event="oninput" />
                @if (isNew)
                {
                    <button type="button" class="btn btn-outline-secondary" disabled="@(_discovering || string.IsNullOrWhiteSpace(_form.Url))" @onclick="DiscoverFeed">
                        @if (_discovering) { <span class="spinner"></span> } else { <Icon Name="search" Size="14" /> }
                        Find feed
                    </button>
                }
            </div>
            @if (isNew && _discoveryMessage is not null)
            {
                <div class="f-hint @(_discoveryFound ? "ok" : "bad")" role="status">@_discoveryMessage</div>
            }
        </div>
        <div>
            <label class="f-label" for="@($"{p}-cat")">Category</label>
            <select id="@($"{p}-cat")" class="form-select" @bind="_form.Category">
                @foreach (var c in _categories) { <option value="@c">@c</option> }
            </select>
        </div>
        <div>
            <label class="f-label" for="@($"{p}-type")">Content type</label>
            <select id="@($"{p}-type")" class="form-select" @bind="_form.ContentType">
                @foreach (var c in _contentTypes) { <option value="@c">@c</option> }
            </select>
        </div>
        <div>
            <label class="f-label" for="@($"{p}-level")">Level</label>
            <select id="@($"{p}-level")" class="form-select" @bind="_form.Level">
                @foreach (var l in _levels) { <option value="@l">@l</option> }
            </select>
        </div>
        <div>
            <label class="f-label" for="@($"{p}-tags")">Tags</label>
            <input id="@($"{p}-tags")" class="form-control" placeholder="Comma-separated" @bind="_form.TagsCsv" />
        </div>
        <div class="fg-full">
            <label class="f-label" for="@($"{p}-note")">Note</label>
            <input id="@($"{p}-note")" class="form-control" placeholder="What it gives you" @bind="_form.Note" />
        </div>
        <div class="fg-full checks">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="@($"{p}-enabled")" @bind="_form.Enabled" />
                <label class="form-check-label" for="@($"{p}-enabled")">Enabled</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="@($"{p}-full")" @bind="_form.FullTextFetch" />
                <label class="form-check-label" for="@($"{p}-full")">Fetch full article text</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="@($"{p}-scrape")" @bind="_form.IsScrape" />
                <label class="form-check-label" for="@($"{p}-scrape")">Scrape HTML (no RSS feed)</label>
            </div>
        </div>
        @if (_form.IsScrape)
        {
            <fieldset class="fg-full scrape">
                <legend>Scrape selectors (XPath)</legend>
                <p class="f-hint">The URL above is the page to scrape, not an RSS feed.</p>
                <div class="form-grid inner">
                    <div><label class="f-label" for="@($"{p}-x-item")">Item container</label><input id="@($"{p}-x-item")" class="form-control" placeholder="e.g. //article" @bind="_form.ScrapeItemXPath" /></div>
                    <div><label class="f-label" for="@($"{p}-x-link")">Link (relative)</label><input id="@($"{p}-x-link")" class="form-control" placeholder="default .//a" @bind="_form.ScrapeLinkXPath" /></div>
                    <div><label class="f-label" for="@($"{p}-x-title")">Title (optional)</label><input id="@($"{p}-x-title")" class="form-control" placeholder="defaults to link text" @bind="_form.ScrapeTitleXPath" /></div>
                    <div><label class="f-label" for="@($"{p}-x-date")">Date (optional)</label><input id="@($"{p}-x-date")" class="form-control" @bind="_form.ScrapeDateXPath" /></div>
                </div>
            </fieldset>
        }
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small mb-0 fg-full" role="alert">@_error</div>
        }
    </div>;

    [SupplyParameterFromQuery(Name = "opmlAdded")] private int? OpmlAdded { get; set; }
    [SupplyParameterFromQuery(Name = "opmlSkipped")] private int? OpmlSkipped { get; set; }
    [SupplyParameterFromQuery(Name = "opmlUnreachable")] private int? OpmlUnreachable { get; set; }

    private bool _opmlImporting;
    private OpmlImportProgress? _opmlProgress;
    private (int Added, int Skipped, int Unreachable)? _opmlResult;

    /// <summary>
    /// Imports directly through OpmlService (in-process, same as the /opml/import endpoint uses) instead
    /// of a plain form POST - lets the page report live "checking N of M" progress instead of a blank wait
    /// followed by a full-page redirect, since reachability-checking every new URL is genuinely slow for a
    /// large import.
    /// </summary>
    private async Task HandleOpmlFileSelected(InputFileChangeEventArgs e)
    {
        _opmlImporting = true;
        _opmlProgress = null;
        _opmlResult = null;
        StateHasChanged();
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10_000_000);
            _opmlResult = await Opml.ImportOpmlAsync(stream, progress =>
            {
                _opmlProgress = progress;
                return InvokeAsync(StateHasChanged);
            });
        }
        finally
        {
            _opmlImporting = false;
            StateHasChanged();
        }
    }

    private bool _showAddForm;
    private int? _editingId;
    private string? _error;
    private SourceForm _form = new();
    private Dictionary<int, WebSubSubscription> _webSubStatus = new();

    private readonly string[] _categories = { "News", "Research", "Tools", "Community" };
    private readonly string[] _contentTypes = { "News", "Tutorial", "Release", "Paper", "Discussion", "Video" };
    private readonly string[] _levels = { "Beginner", "Intermediate", "Advanced" };

    private string _search = "";
    private string? _sortColumn = "name";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 20;

    private sealed class SourceRow
    {
        public required SourceRecord Source { get; init; }
        public int Healthy { get; init; }
        public int HealthTotal { get; init; }
        public int FailStreak { get; init; }
    }

    private void ToggleSort(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
        _page = 1;
    }

    private bool _grouped = true;

    /// <summary>Base projection + search filter shared by both the flat table and the grouped-by-category view.</summary>
    private IEnumerable<SourceRow> FilteredRows()
    {
        IEnumerable<SourceRow> q = Kb.SourceRecords.Select(s =>
        {
            var (healthy, total) = Health.GetSummary(s.Name);
            return new SourceRow { Source = s, Healthy = healthy, HealthTotal = total, FailStreak = Feeds.GetFailureStreak(s.Name) };
        });

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var needle = _search.Trim();
            q = q.Where(r =>
                r.Source.Name.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                r.Source.Category.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                r.Source.ContentType.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                r.Source.Level.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                r.Source.TagsCsv.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                (r.Source.Note ?? "").Contains(needle, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrEmpty(_categoryFilter))
            q = q.Where(r => r.Source.Category == _categoryFilter);

        q = _statusFilter switch
        {
            "enabled" => q.Where(r => r.Source.Enabled),
            "disabled" => q.Where(r => !r.Source.Enabled),
            "failing" => q.Where(r => r.FailStreak > 0),
            "nodata" => q.Where(r => r.HealthTotal == 0),
            _ => q
        };

        return q;
    }

    /// <summary>Unfiltered count across every source, not just the current search/category view - so the page-level warning banner
    /// reflects the whole picture even while a search or a collapsed category is hiding some rows.</summary>
    private int TotalFailingCount() => Kb.SourceRecords.Count(s => Feeds.GetFailureStreak(s.Name) > 0);

    /// <summary>For the small per-source favicon next to its name - same /favicon-proxy/{host} the News Feed
    /// cards use (FeedItemCard.HostOf), so a source is visually recognizable here too, not just once its
    /// items start showing up in the feed.</summary>
    private static string? HostOf(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) ? uri.Host : null;

    /// <summary>Collapsible-groups view: same filtered rows as the flat table, partitioned by category (folders), sorted by name within each.</summary>
    private List<(string Category, List<SourceRow> Rows)> GetGroups() =>
        FilteredRows()
            .GroupBy(r => r.Source.Category)
            .OrderBy(g => g.Key)
            .Select(g => (g.Key, g.OrderBy(r => r.Source.Name).ToList()))
            .ToList();



    private (List<SourceRow> Rows, int Total) GetPage()
    {
        var q = FilteredRows();

        q = (_sortColumn, _sortAscending) switch
        {
            ("category", true) => q.OrderBy(r => r.Source.Category),
            ("category", false) => q.OrderByDescending(r => r.Source.Category),
            ("type", true) => q.OrderBy(r => r.Source.ContentType),
            ("type", false) => q.OrderByDescending(r => r.Source.ContentType),
            ("level", true) => q.OrderBy(r => r.Source.Level),
            ("level", false) => q.OrderByDescending(r => r.Source.Level),
            ("status", true) => q.OrderBy(r => r.Source.Enabled).ThenBy(r => r.Source.Name),
            ("status", false) => q.OrderByDescending(r => r.Source.Enabled).ThenBy(r => r.Source.Name),
            ("uptime", true) => q.OrderBy(r => r.HealthTotal == 0 ? -1 : r.Healthy * 100.0 / r.HealthTotal),
            ("uptime", false) => q.OrderByDescending(r => r.HealthTotal == 0 ? -1 : r.Healthy * 100.0 / r.HealthTotal),
            (_, false) => q.OrderByDescending(r => r.Source.Name),
            _ => q.OrderBy(r => r.Source.Name),
        };

        var list = q.ToList();
        var page = list.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
        return (page, list.Count);
    }

    protected override async Task OnInitializedAsync()
    {
        if (WebSub.Enabled)
            _webSubStatus = await WebSub.GetAllStatusesAsync();
    }

    private void ToggleAddForm()
    {
        _showAddForm = !_showAddForm;
        _editingId = null;
        _error = null;
        _discoveryMessage = null;
        if (_showAddForm) _form = new SourceForm { Enabled = true, Category = "News", ContentType = "News", Level = "Intermediate" };
    }

    private void StartEdit(SourceRecord s)
    {
        _showAddForm = false;
        _error = null;
        _editingId = _editingId == s.Id ? null : s.Id;
        _form = new SourceForm
        {
            Name = s.Name,
            Url = s.Url,
            Category = s.Category,
            ContentType = s.ContentType,
            Level = s.Level,
            TagsCsv = s.TagsCsv,
            Note = s.Note ?? "",
            Enabled = s.Enabled,
            FullTextFetch = s.FullTextFetch,
            IsScrape = s.IsScrape,
            ScrapeItemXPath = s.ScrapeItemXPath ?? "",
            ScrapeTitleXPath = s.ScrapeTitleXPath ?? "",
            ScrapeLinkXPath = s.ScrapeLinkXPath ?? "",
            ScrapeDateXPath = s.ScrapeDateXPath ?? ""
        };
    }

    private void CancelEdit() => _editingId = null;

    private bool _discovering;
    private bool _discoveryFound;
    private string? _discoveryMessage;

    private async Task DiscoverFeed()
    {
        _discovering = true;
        _discoveryMessage = null;
        StateHasChanged();
        try
        {
            var found = await Discovery.DiscoverFeedUrlAsync(_form.Url);
            if (found is not null)
            {
                _discoveryFound = true;
                _discoveryMessage = found == _form.Url.Trim() ? "That's already a feed URL." : $"Found: {found}";
                _form.Url = found;
            }
            else
            {
                _discoveryFound = false;
                _discoveryMessage = "Couldn't find a feed on that page - paste the RSS/Atom URL directly if you know it.";
            }
        }
        finally
        {
            _discovering = false;
        }
    }

    private async Task AddSource()
    {
        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.Url))
        {
            _error = "Name and URL are required.";
            return;
        }
        if (_form.IsScrape && string.IsNullOrWhiteSpace(_form.ScrapeItemXPath))
        {
            _error = "Scrape sources need at least an item container XPath.";
            return;
        }
        _error = null;
        await Kb.AddSourceAsync(new SourceRecord
        {
            Name = _form.Name.Trim(),
            Url = _form.Url.Trim(),
            Category = _form.Category,
            ContentType = _form.ContentType,
            Level = _form.Level,
            TagsCsv = _form.TagsCsv.Trim(),
            Note = string.IsNullOrWhiteSpace(_form.Note) ? null : _form.Note.Trim(),
            Enabled = _form.Enabled,
            FullTextFetch = _form.FullTextFetch,
            IsScrape = _form.IsScrape,
            ScrapeItemXPath = Blank(_form.ScrapeItemXPath),
            ScrapeTitleXPath = Blank(_form.ScrapeTitleXPath),
            ScrapeLinkXPath = Blank(_form.ScrapeLinkXPath),
            ScrapeDateXPath = Blank(_form.ScrapeDateXPath)
        });
        _showAddForm = false;
    }

    private async Task SaveEdit()
    {
        if (_editingId is null) return;
        if (_form.IsScrape && string.IsNullOrWhiteSpace(_form.ScrapeItemXPath))
        {
            _error = "Scrape sources need at least an item container XPath.";
            return;
        }
        _error = null;
        await Kb.UpdateSourceAsync(new SourceRecord
        {
            Id = _editingId.Value,
            Name = _form.Name.Trim(),
            Url = _form.Url.Trim(),
            Category = _form.Category,
            ContentType = _form.ContentType,
            Level = _form.Level,
            TagsCsv = _form.TagsCsv.Trim(),
            Note = string.IsNullOrWhiteSpace(_form.Note) ? null : _form.Note.Trim(),
            Enabled = _form.Enabled,
            FullTextFetch = _form.FullTextFetch,
            IsScrape = _form.IsScrape,
            ScrapeItemXPath = Blank(_form.ScrapeItemXPath),
            ScrapeTitleXPath = Blank(_form.ScrapeTitleXPath),
            ScrapeLinkXPath = Blank(_form.ScrapeLinkXPath),
            ScrapeDateXPath = Blank(_form.ScrapeDateXPath)
        });
        _editingId = null;
    }

    private static string? Blank(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private async Task DeleteSource(int id)
    {
        var name = Kb.SourceRecords.FirstOrDefault(s => s.Id == id)?.Name ?? "this source";
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete \"{name}\"? This can't be undone.");
        if (confirmed)
        {
            await Kb.DeleteSourceAsync(id);
            _selected.Remove(id);
            if (_editingId == id) _editingId = null;
        }
    }

    private sealed class SourceForm
    {
        public string Name { get; set; } = "";
        public string Url { get; set; } = "";
        public string Category { get; set; } = "News";
        public string ContentType { get; set; } = "News";
        public string Level { get; set; } = "Intermediate";
        public string TagsCsv { get; set; } = "";
        public string Note { get; set; } = "";
        public bool Enabled { get; set; } = true;
        public bool FullTextFetch { get; set; }
        public bool IsScrape { get; set; }
        public string ScrapeItemXPath { get; set; } = "";
        public string ScrapeTitleXPath { get; set; } = "";
        public string ScrapeLinkXPath { get; set; } = "";
        public string ScrapeDateXPath { get; set; } = "";
    }
}

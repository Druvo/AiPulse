@page "/app"
@using AiPulse.Services.Security
@inject NavigationManager Nav
@inject IHttpContextAccessor Http
@inject AppDownloads Downloads
@inject SiteStatsService Stats

@* Static server-rendered (no @rendermode): light, crawlable and shareable. The Install button, the "already installed" state and
   Share/Copy are wired by wwwroot/js/install-app.js, which also catches the browser's install prompt on every page. *@

<PageTitle>@Site.Name · Get the app</PageTitle>
<HeadContent>
    <meta name="description" content="Install @Site.Name on your phone, tablet or computer straight from this site: no app store, one tap, opens full screen from your home screen." />
</HeadContent>

@{
    var device = AppInstall.Classify(Http.HttpContext?.Request.Headers.UserAgent.ToString());
    var pageUrl = AppInstall.PageUrl(Nav.BaseUri);
    var secure = AppInstall.CanInstallFrom(Nav.BaseUri);
    var qr = QrCode.EncodeText(pageUrl).ToSvg(title: "QR code that opens this page on your phone");
    var android = Downloads.Android();
}

<header class="ia-hero">
    <img class="ia-icon" src="icons/icon-192.png" width="96" height="96" alt="" />
    <div class="ia-hero-text">
        <h1 class="ia-h1">Get @Site.Name on your phone</h1>
        <p class="ia-lead">@if (android is not null){<text>Download the Android app below, or install the web app: either way it lands on your home screen like any other app, and it is the same @Site.Name as the website.</text>}else{<text>Install it straight from this site. No app store and no separate download: it lands on your home screen like any other app, opens full screen, and is the same @Site.Name you use in the browser.</text>}</p>
        <div class="ia-actions">
            <button type="button" class="btn btn-primary ia-install" data-install-button hidden><Icon Name="download" Size="18" /> Install @Site.Name</button>
            <button type="button" class="btn btn-outline-secondary" data-share-button><Icon Name="share" Size="17" /> Send the link to my phone</button>
        </div>
        <p class="ia-status" data-install-status role="status" aria-live="polite">@if (!secure){<span>This address is not secure (https), so browsers will only offer a shortcut here. Open the https address of this site to install the full app.</span>}</p>
    </div>
</header>

@if (android is not null)
{
    <section class="ia-card ia-apk" aria-labelledby="ia-apk-h">
        <div class="ia-apk-main">
            <h2 id="ia-apk-h" class="ia-h2"><Icon Name="download" Size="20" /> @Site.Name for Android</h2>
            <p class="ia-muted mb-2">The native app: sign in once and read the news, mark items read and keep a reading list that is shared with the website. Version @android.Version · @AppDownloads.FormatSize(android.Size) · Android 7 or newer.</p>
            <p class="mb-2"><a class="btn btn-primary ia-apk-btn" href="download/android" download><Icon Name="download" Size="18" /> Download the Android app (APK)</a></p>
            <details class="ia-apk-steps">
                <summary>How to install an APK</summary>
                <ol>
                    <li>Open the downloaded file (from the notification or your Downloads folder).</li>
                    <li>If Android asks, allow installs from this source: tap <strong>Settings</strong>, switch on <strong>Allow from this source</strong>, then go back.</li>
                    <li>Tap <strong>Install</strong>, then <strong>Open</strong>. Sign in with your @Site.Name account.</li>
                </ol>
                <p class="ia-muted mb-1">Updates: download the newest file and install it over the old one; your sign-in and reading list stay.</p>
                <p class="ia-muted mb-0">Check the file: SHA-256 <code class="ia-sha">@android.Sha256</code></p>
            </details>
        </div>
    </section>
}

<div class="ia-grid">
    <section class="ia-card ia-qr" aria-labelledby="ia-qr-h">
        <h2 id="ia-qr-h" class="ia-h2">Scan with your phone</h2>
        <div class="ia-qr-box">@((MarkupString)qr)</div>
        <p class="ia-muted">Point your camera at the code, open the link, then follow the steps for your phone.</p>
        <p class="ia-link"><span class="ia-url" data-page-url>@pageUrl</span> <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-link>Copy link</button></p>
    </section>

    <section class="ia-card ia-steps" aria-labelledby="ia-steps-h">
        <h2 id="ia-steps-h" class="ia-h2">Install in three taps</h2>

        <details class="ia-platform" id="android" open="@(device is DeviceKind.Android or DeviceKind.Other)">
            <summary><Icon Name="grid" Size="18" /> Android (Chrome, Edge, Samsung Internet)@(device == DeviceKind.Android ? " · your device" : "")</summary>
            <ol>
                <li>Open this page in Chrome.</li>
                <li>Tap <strong>Install @Site.Name</strong> above, or the browser menu (<strong>⋮</strong>) then <strong>Install app</strong> or <strong>Add to Home screen</strong>.</li>
                <li>Confirm. @Site.Name appears with your other apps.</li>
            </ol>
        </details>

        <details class="ia-platform" id="ios" open="@(device == DeviceKind.Ios)">
            <summary><Icon Name="grid" Size="18" /> iPhone and iPad (Safari)@(device == DeviceKind.Ios ? " · your device" : "")</summary>
            <ol>
                <li>Open this page in <strong>Safari</strong> (other iOS browsers can add it too, from their share menu).</li>
                <li>Tap the <strong>Share</strong> button (the square with an arrow).</li>
                <li>Choose <strong>Add to Home Screen</strong>, then <strong>Add</strong>.</li>
            </ol>
        </details>

        <details class="ia-platform" id="desktop" open="@(device == DeviceKind.Desktop)">
            <summary><Icon Name="grid" Size="18" /> Computer (Chrome, Edge)@(device == DeviceKind.Desktop ? " · your device" : "")</summary>
            <ol>
                <li>Click <strong>Install @Site.Name</strong> above, or the install icon at the right end of the address bar.</li>
                <li>@Site.Name opens in its own window and gets a shortcut in your Start menu or Dock.</li>
            </ol>
        </details>
    </section>
</div>

<section class="ia-why" aria-labelledby="ia-why-h">
    <h2 id="ia-why-h" class="ia-h2">Why keep @Site.Name in your pocket</h2>
    <div class="ia-features">
        <article class="ia-feature">
            <span class="ia-feature-icon"><Icon Name="rss" Size="20" /></span>
            <h3>One feed, not forty tabs</h3>
            <p>@Stats.Current.ActiveSources.ToString("N0") sources merged into a single stream, with the same story from many sites shown once.</p>
        </article>
        <article class="ia-feature">
            <span class="ia-feature-icon"><Icon Name="bookmark" Size="20" /></span>
            <h3>Pick up where you left off</h3>
            <p>Your reading list and what you have read are the same on your phone and on the website.</p>
        </article>
        <article class="ia-feature">
            <span class="ia-feature-icon"><Icon Name="bell" Size="20" /></span>
            <h3>Quiet by design</h3>
            <p>No ads, no engagement tricks. You see what the sources publish, newest first, and you decide what is worth a read.</p>
        </article>
        <article class="ia-feature">
            <span class="ia-feature-icon"><Icon Name="shield" Size="20" /></span>
            <h3>Private and yours</h3>
            <p>It talks only to this site. Your account and reading history live on the server that runs it, not with an advertiser.</p>
        </article>
        <article class="ia-feature">
            <span class="ia-feature-icon"><Icon Name="key" Size="20" /></span>
            <h3>Sign in your way</h3>
            <p>Username and password with optional two-step codes, or Google, GitHub or Facebook where the site has turned them on.</p>
        </article>
        <article class="ia-feature">
            <span class="ia-feature-icon"><Icon Name="sun" Size="20" /></span>
            <h3>Light, dark, and fast</h3>
            <p>Follows your phone's theme, loads quickly on mobile data and keeps working through a flaky connection.</p>
        </article>
    </div>
</section>

<section class="ia-shots" aria-labelledby="ia-shots-h">
    <h2 id="ia-shots-h" class="ia-h2">A look inside</h2>
    <div class="ia-shot-row">
        <img class="ia-shot ia-shot--phone" src="img/screenshots/phone-home.png" width="390" height="844" loading="lazy" alt="The app on a phone: the home page with the latest news" />
        <img class="ia-shot ia-shot--wide" src="img/screenshots/desktop-home.png" width="1280" height="800" loading="lazy" alt="The same site on a computer" />
    </div>
</section>

<section class="ia-card" aria-labelledby="ia-faq-h">
    <h2 id="ia-faq-h" class="ia-h2">Questions</h2>
    <details class="ia-faq"><summary>Is it free?</summary><p>Yes. There is nothing to buy and no subscription; the site is run by whoever hosts it.</p></details>
    <details class="ia-faq"><summary>Which phones does it run on?</summary><p>The Android app needs Android 7 or newer. Any phone, tablet or computer with a modern browser can install the web app instead, including iPhone and iPad.</p></details>
    <details class="ia-faq"><summary>Does it work offline?</summary><p>You need a connection to load the latest news. Without one you get a friendly offline screen, and the app reconnects by itself when the signal returns.</p></details>
    <details class="ia-faq"><summary>Is my data safe?</summary><p>Passwords are stored as slow salted hashes, you can turn on two-step sign-in, and every session can be ended from your account page. The app only talks to this site.</p></details>
    <details class="ia-faq"><summary>How do I update it?</summary><p>The web app updates itself. For the Android file, download the newest one from this page and install it over the old one; you stay signed in.</p></details>
</section>

<section class="ia-card" aria-labelledby="ia-get-h">
    <h2 id="ia-get-h" class="ia-h2">What you get</h2>
    <ul class="ia-list">
        <li><strong>One-tap launch</strong> from the home screen, full screen with no browser bars.</li>
        <li><strong>Always current.</strong> It updates itself whenever the site does; there is nothing to download again.</li>
        <li><strong>Shortcuts</strong> straight to News and Ask (long-press the icon on Android).</li>
        <li><strong>Light and dark</strong> follow your phone's setting.</li>
        <li><strong>A friendly offline page</strong> when you have no signal. The news itself needs a connection.</li>
        <li><strong>Private.</strong> It is the same site, so your data stays on the server it came from.</li>
    </ul>
</section>

<section class="ia-card" aria-labelledby="ia-help-h">
    <h2 id="ia-help-h" class="ia-h2">No Install button?</h2>
    <ul class="ia-list">
        <li>Use the real browser (Chrome or Safari), not the one built into another app. Tap <strong>Open in browser</strong> first.</li>
        <li>Installing needs a secure (<strong>https</strong>) address.</li>
        <li>Already installed? Open it from your home screen; this page then says so.</li>
        <li>There is no Google Play or App Store listing to search for: the Android app is downloaded from this page, and the web app is installed from the site (also the way to get it on an iPhone).</li>
    </ul>
</section>

@page "/Error"
@using System.Diagnostics

<PageTitle>AiPulse · Something went wrong</PageTitle>

<div class="status-screen">
    <div class="status-screen__card">
        <div class="empty-state__icon" aria-hidden="true"><Icon Name="alert-triangle" Size="28" /></div>
        <div class="status-screen__code">500 · Error</div>
        <h1>Something went wrong</h1>
        <p>An error occurred while processing your request. Try again in a moment; if it keeps happening, the details below help whoever runs this AiPulse find the cause.</p>
        <div class="status-screen__actions">
            <a href="" class="btn btn-primary"><Icon Name="refresh" Size="17" /> Try again</a>
            <a href="/" class="btn btn-outline-secondary"><Icon Name="home" Size="17" /> Home</a>
        </div>

        @if (ShowRequestId)
        {
            <p class="mt-4 small">
                <strong>Request ID:</strong> <code>@RequestId</code>
            </p>
        }

        <details class="status-details">
            <summary>For the person running this server</summary>
            <p class="mt-2">
                Swapping to the <strong>Development</strong> environment shows more detailed information about the error.
            </p>
            <p>
                <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
                It can show sensitive information from exceptions to end users.
                For local debugging, set the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
                and restart the app.
            </p>
        </details>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

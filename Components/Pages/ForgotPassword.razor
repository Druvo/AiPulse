@page "/forgot-password"
@layout AiPulse.Components.Layout.EmptyLayout
@rendermode InteractiveServer
@inject UserService Users
@inject NavigationManager Nav

<PageTitle>AiPulse · Forgot password</PageTitle>

<div class="login-shell-inner">
<div class="login-card">
    @if (_submitted)
    {
        <div class="auth-icon" aria-hidden="true"><Icon Name="mail" Size="22" /></div>
        <h1 class="auth-title">Check your inbox</h1>
        <div class="alert alert-success" role="status">
            If that email matches an account, a reset link has been sent. (No SMTP configured? An admin can generate the link for you from Users.)
        </div>
        <a class="btn btn-primary w-100" href="/login">Back to sign in</a>
    }
    else
    {
        <div class="auth-icon" aria-hidden="true"><Icon Name="key" Size="22" /></div>
        <h1 class="auth-title">Reset your password</h1>
        <p class="auth-sub">Enter the email on your account and we'll send you a link to choose a new password.</p>
        <EditForm Model="_form" OnValidSubmit="Submit" class="auth-form">
            <div class="auth-field">
                <label class="form-label" for="forgot-email">Email</label>
                <input id="forgot-email" type="email" class="form-control" @bind="_form.Email" autocomplete="email" required />
            </div>
            <button type="submit" class="btn btn-primary mt-1">Send reset link <Icon Name="arrow-right" Size="17" /></button>
        </EditForm>

        <p class="auth-alt"><a href="/login"><Icon Name="chevron-left" Size="15" /> Back to sign in</a></p>
    }
</div>
</div>

@code {
    private readonly ForgotForm _form = new();
    private bool _submitted;

    private async Task Submit()
    {
        var baseUrl = Nav.BaseUri.TrimEnd('/');
        await Users.RequestPasswordResetAsync(_form.Email, token => $"{baseUrl}/reset-password?token={token}");
        _submitted = true;
    }

    private sealed class ForgotForm
    {
        public string Email { get; set; } = "";
    }
}

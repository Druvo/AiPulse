@page "/glossary"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject KnowledgeBaseService Kb
@inject ISummarizer Ai
@inject FeedAggregatorService Feeds
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>AiPulse · Glossary</PageTitle>

<div class="page-header">
    <h1><Icon Name="book" Size="22" /> Glossary</h1>
    <p class="lead">Every buzzword your coworkers throw around, decoded for a developer, with when to actually use it.</p>
</div>

<AuthorizeView Roles="Admin,Curator" Context="adminPanel">
    <Authorized>
        @if (_pendingCandidates.Count > 0)
        {
            <details class="gloss-panel mb-3 review-panel" open="@(_approvingCandidateId is not null)">
                <summary class="gloss-panel-title review-summary"><Icon Name="search" Size="16" /> Candidate terms awaiting review <span class="count-pill">@_pendingCandidates.Count</span><span class="review-hint">Show</span></summary>
                <ul class="review-list">
                    @foreach (var c in _pendingCandidates)
                    {
                        <li class="review-item">
                            @if (_approvingCandidateId == c.Id)
                            {
                                <EditForm Model="_form" OnValidSubmit="ConfirmApprove">
                                    <div class="row g-2 mb-2">
                                        <div class="col-md-6">
                                            <label class="form-label small" for="gc-term">Term</label>
                                            <InputText id="gc-term" class="form-control" @bind-Value="_form.Term" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small" for="gc-cat">Category</label>
                                            <InputSelect id="gc-cat" class="form-select" @bind-Value="_form.Category">
                                                @foreach (var cat in _categories.Where(c => c != "All"))
                                                {
                                                    <option value="@cat">@cat</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>
                                    <label class="form-label small" for="gc-short">Short definition (required)</label>
                                    <InputText id="gc-short" class="form-control mb-2" @bind-Value="_form.ShortDef" />
                                    <label class="form-label small" for="gc-details">Details (optional)</label>
                                    <InputTextArea id="gc-details" class="form-control mb-2" @bind-Value="_form.Details" />
                                    <label class="form-label small" for="gc-when">When to use (optional)</label>
                                    <InputText id="gc-when" class="form-control mb-2" @bind-Value="_form.WhenToUse" />
                                    <label class="form-label small" for="gc-url">Learn more URL (optional)</label>
                                    <InputText id="gc-url" class="form-control mb-2" @bind-Value="_form.LearnMoreUrl" />
                                    @if (_error is not null)
                                    {
                                        <div class="alert alert-danger py-2 small mb-2" role="alert">@_error</div>
                                    }
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="submit" class="btn btn-success">Add to glossary</button>
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _approvingCandidateId = null">Cancel</button>
                                    </div>
                                </EditForm>
                            }
                            else
                            {
                                <div class="review-text"><strong>@c.Name</strong> <span class="text-muted">· @c.RawNote</span></div>
                                <div class="review-actions">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartApprove(c)">Review</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => Dismiss(c.Id)">Dismiss</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </details>
        }
    </Authorized>
</AuthorizeView>

@{
    var emerging = EmergingTerms();
}
@if (emerging.Count > 0)
{
    <section class="gloss-panel gloss-emerging mb-3" aria-labelledby="gloss-emerging-title">
        <h2 id="gloss-emerging-title" class="gloss-panel-title"><Icon Name="trending-up" Size="16" /> Trending in the news, not defined here yet</h2>
        <div class="chip-row">
            @foreach (var (term, count) in emerging)
            {
                <a class="emerging-chip" href="@($"news?tag={Uri.EscapeDataString(term)}")">@term <span class="chip-count">@count</span></a>
            }
        </div>
    </section>
}

@{
    var matches = Kb.Glossary
        .Where(t => _filter == "All" || t.Category == _filter)
        .Where(t => GlossaryIndex.Matches(t, _search))
        .OrderBy(t => t.Term, StringComparer.OrdinalIgnoreCase)
        .ToList();
    var groups = matches.GroupBy(t => GlossaryIndex.LetterOf(t.Term)).OrderBy(g => g.Key == '#' ? ' ' : g.Key).ToList();
    var lettersWithTerms = groups.Select(g => g.Key).ToHashSet();
    var known = Kb.Glossary.ToDictionary(t => t.Term, StringComparer.OrdinalIgnoreCase);
}

<div class="gloss-controls">
    <div class="gloss-search">
        <label for="gloss-search" class="visually-hidden">Search the glossary</label>
        <span class="gloss-search-icon" aria-hidden="true"><Icon Name="search" Size="18" /></span>
        <input id="gloss-search" type="search" class="form-control" placeholder="Search a term, alias or definition (e.g. RAG, headroom, caveman)"
               autocomplete="off" spellcheck="false" aria-describedby="gloss-count"
               @bind="_search" @bind:event="oninput" />
        @if (!string.IsNullOrEmpty(_search))
        {
            <button type="button" class="gloss-clear" aria-label="Clear search" @onclick="ClearSearch">✕</button>
        }
        else
        {
            <kbd class="gloss-kbd" aria-hidden="true" title="Press / to search">/</kbd>
        }
    </div>
    <div class="gloss-cats" role="group" aria-label="Filter by category">
        @foreach (var cat in _categories)
        {
            var n = cat == "All" ? Kb.Glossary.Count : Kb.Glossary.Count(t => t.Category == cat);
            <button type="button" class="cat-btn @(_filter == cat ? "active" : "")" aria-pressed="@(_filter == cat ? "true" : "false")" @onclick="() => SetCategory(cat)">
                @cat <span class="cat-count">@n</span>
            </button>
        }
    </div>
    <p class="gloss-count" id="gloss-count" role="status">
        @if (matches.Count == Kb.Glossary.Count)
        {
            <span>@Kb.Glossary.Count terms</span>
        }
        else
        {
            <span>@matches.Count of @Kb.Glossary.Count terms</span>
        }
    </p>
</div>

<nav class="az-rail" aria-label="Jump to letter">
    <ol>
        @foreach (var letter in GlossaryIndex.Alphabet)
        {
            var id = LetterId(letter);
            <li>
                @if (lettersWithTerms.Contains(letter))
                {
                    <a href="@($"glossary#{id}")" class="az-link" aria-label="@(letter == '#' ? "Numbers and symbols" : $"Letter {letter}")"
                       @onclick="() => JumpToLetter(letter)" @onclick:preventDefault="true">@letter</a>
                }
                else
                {
                    <span class="az-link az-empty" aria-hidden="true">@letter</span>
                }
            </li>
        }
    </ol>
</nav>

@if (matches.Count == 0)
{
    <div class="gloss-empty">
        <EmptyState Icon="search" Title="@($"No term matches \"{_search}\"{(_filter == "All" ? "" : $" in {_filter}")}")"
                    Body="Try a shorter word, an alias, or another category. Missing a term? Add it to Data/glossary.json and it shows up here."
                    ActionText="Clear search and filters" OnAction="ClearAll" />
    </div>
}

@foreach (var group in groups)
{
    <section class="gloss-group" id="@LetterId(group.Key)" aria-labelledby="@($"{LetterId(group.Key)}-h")">
        <h2 class="gloss-letter" id="@($"{LetterId(group.Key)}-h")">@group.Key</h2>
        <div class="term-grid">
            @foreach (var term in group)
            {
                var slug = GlossaryIndex.Slug(term.Term);
                var mentions = RecentMentions(term.Term);
                <article class="term-card" id="@slug" tabindex="-1" @key="term.Term">
                    <header class="term-head">
                        <h3 class="term-name"><a href="@($"glossary#{slug}")" class="term-anchor" @onclick="() => JumpToTerm(term.Term)" @onclick:preventDefault="true">@term.Term</a></h3>
                        <span class="cat-chip cat-@term.Category.ToLowerInvariant()">@term.Category</span>
                    </header>
                    @if (term.Aliases.Length > 0)
                    {
                        <p class="term-aliases">Also: @string.Join(", ", term.Aliases)</p>
                    }
                    <p class="term-def">@term.ShortDef</p>
                    @if (!string.IsNullOrWhiteSpace(term.Details))
                    {
                        <p class="term-details">@term.Details</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(term.WhenToUse))
                    {
                        <div class="term-when"><span class="term-when-label">When to use</span> @term.WhenToUse</div>
                    }
                    @if (term.Related.Length > 0)
                    {
                        <div class="term-related">
                            <span class="term-sub">Related</span>
                            @foreach (var rel in term.Related)
                            {
                                @if (known.ContainsKey(rel))
                                {
                                    <a class="rel-chip" href="@($"glossary#{GlossaryIndex.Slug(rel)}")" @onclick="() => JumpToTerm(rel)" @onclick:preventDefault="true">@rel</a>
                                }
                                else
                                {
                                    <span class="rel-chip rel-plain">@rel</span>
                                }
                            }
                        </div>
                    }
                    @if (mentions.Count > 0)
                    {
                        <div class="term-mentions">
                            <span class="term-sub">Recent mentions</span>
                            <ul>
                                @foreach (var m in mentions)
                                {
                                    <li><a href="@m.Link" target="_blank" rel="noopener">@m.Title</a> <span class="text-muted">· @m.SourceName</span></li>
                                }
                            </ul>
                            <a href="@($"news?tag={Uri.EscapeDataString(term.Term)}")" class="small">See all in News →</a>
                        </div>
                    }
                    <footer class="term-actions">
                        <button type="button" class="act-btn" @onclick="() => CopyDefinition(term)" aria-label="@($"Copy definition of {term.Term}")">
                            <Icon Name="@(_copied == "def:" + term.Term ? "check" : "copy")" Size="15" /> <span>@(_copied == "def:" + term.Term ? "Copied" : "Copy definition")</span>
                        </button>
                        <button type="button" class="act-btn" @onclick="() => CopyLink(term)" aria-label="@($"Copy link to {term.Term}")">
                            <Icon Name="@(_copied == "link:" + term.Term ? "check" : "share")" Size="15" /> <span>@(_copied == "link:" + term.Term ? "Link copied" : "Copy link")</span>
                        </button>
                        @if (!string.IsNullOrWhiteSpace(term.LearnMoreUrl))
                        {
                            <a href="@term.LearnMoreUrl" target="_blank" rel="noopener" class="act-btn">
                                <Icon Name="external-link" Size="15" /> <span>Learn more</span>
                            </a>
                        }
                        @if (Ai.ExplanationsEnabled)
                        {
                            <button type="button" class="act-btn act-ai" disabled="@_explaining.Contains(term.Term)" @onclick="() => Explain(term.Term)">
                                @if (_explaining.Contains(term.Term)) { <span class="spinner" aria-hidden="true"></span> } else { <Icon Name="sparkle" Size="15" /> }
                                <span>Explain with AI</span>
                            </button>
                        }
                        <span class="visually-hidden" role="status">@(_copied?.EndsWith(":" + term.Term) == true ? "Copied to clipboard" : "")</span>
                    </footer>
                    @if (_explanations.TryGetValue(term.Term, out var ex))
                    {
                        <div class="term-ai" role="status"><span class="term-sub">AI explanation</span>@ex</div>
                    }
                </article>
            }
        </div>
    </section>
}

@code {
    private string? _copied;
    private readonly HashSet<string> _explaining = new(StringComparer.OrdinalIgnoreCase);
    private IJSObjectReference? _ui;

    private static string LetterId(char letter) => letter == '#' ? "letter-num" : $"letter-{char.ToLowerInvariant(letter)}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _ui = await JS.InvokeAsync<IJSObjectReference>("import", "./js/page-ui.js");
            await _ui.InvokeVoidAsync("slashFocus", "gloss-search");
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private void ClearSearch() => _search = "";

    private void ClearAll()
    {
        _search = "";
        SetCategory("All");
    }

    private async Task ScrollTo(string id, bool flash)
    {
        if (_ui is null) return;
        try
        {
            await _ui.InvokeAsync<bool>("scrollToId", id, true);
            if (flash) await _ui.InvokeVoidAsync("flash", id);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private Task JumpToLetter(char letter) => ScrollTo(LetterId(letter), false);

    /// <summary>Related-term chips and term anchors: clear anything that would hide the target, then scroll to it and highlight it.</summary>
    private async Task JumpToTerm(string term)
    {
        var target = Kb.Glossary.FirstOrDefault(t => t.Term.Equals(term, StringComparison.OrdinalIgnoreCase));
        if (target is null) return;
        if ((_filter != "All" && target.Category != _filter) || !GlossaryIndex.Matches(target, _search))
        {
            _search = "";
            _filter = "All";
            StateHasChanged();
            await Task.Yield();
        }
        await ScrollTo(GlossaryIndex.Slug(target.Term), true);
    }

    private Task CopyDefinition(GlossaryTerm t) => CopyAsync("def:" + t.Term, GlossaryIndex.CopyText(t));

    private Task CopyLink(GlossaryTerm t) => CopyAsync("link:" + t.Term, $"{Nav.BaseUri}glossary#{GlossaryIndex.Slug(t.Term)}");

    private async Task CopyAsync(string key, string text)
    {
        var ok = false;
        try
        {
            _ui ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/page-ui.js");
            ok = await _ui.InvokeAsync<bool>("copy", text);
        }
        catch (JSDisconnectedException) { return; }
        catch (JSException) { }
        if (!ok) return;
        _copied = key;
        StateHasChanged();
        await Task.Delay(1800);
        if (_copied == key)
        {
            _copied = null;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_ui is not null)
        {
            try { await _ui.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }

    [SupplyParameterFromQuery(Name = "q")]
    public string? QueryParam { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryParam { get; set; }

    private string _search = "";
    private string _filter = "All";
    private readonly string[] _categories = { "All", "Concept", "Technique", "Architecture", "Tooling" };
    private readonly Dictionary<string, string> _explanations = new();
    private IReadOnlyList<FeedItem> _feedItems = Array.Empty<FeedItem>();

    private List<ContentCandidate> _pendingCandidates = new();
    private int? _approvingCandidateId;
    private string? _error;
    private GlossaryForm _form = new();

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(QueryParam))
            _search = QueryParam;
        if (!string.IsNullOrWhiteSpace(CategoryParam) && _categories.Contains(CategoryParam))
            _filter = CategoryParam;

        // Fire-and-forget: the glossary itself renders instantly from static data - it shouldn't block on
        // Feeds.GetAsync(), which on a cold cache can take 10+ minutes with the Reddit source batch. The
        // "emerging terms" panel just fades in once this resolves instead of holding up the whole page.
        _ = LoadFeedItemsAsync();
        _ = RefreshCandidatesAsync();
    }

    private async Task LoadFeedItemsAsync()
    {
        var result = await Feeds.GetAsync();
        _feedItems = result.Items;
        await QueueEmergingCandidatesAsync();
        StateHasChanged();
    }

    /// <summary>Turns the tag-frequency "emerging terms" signal into actual admin-reviewable candidates instead of just a read-only chip list - this is what makes the Glossary "grow on its own."</summary>
    private async Task QueueEmergingCandidatesAsync()
    {
        var existingNames = Kb.Glossary.SelectMany(t => new[] { t.Term }.Concat(t.Aliases)).ToList();
        foreach (var (term, count) in EmergingTerms())
            await Kb.AddContentCandidateIfNewAsync("Glossary", term, "Concept", $"Seen {count}x in News over the last 14 days", existingNames);
        await RefreshCandidatesAsync();
    }

    private async Task RefreshCandidatesAsync() => _pendingCandidates = await Kb.GetPendingContentCandidatesAsync("Glossary");

    private void StartApprove(ContentCandidate c)
    {
        _approvingCandidateId = c.Id;
        _error = null;
        _form = new GlossaryForm { Term = c.Name, Category = c.Category ?? "Concept" };
    }

    private async Task ConfirmApprove()
    {
        if (_approvingCandidateId is null) return;
        if (string.IsNullOrWhiteSpace(_form.Term) || string.IsNullOrWhiteSpace(_form.ShortDef))
        {
            _error = "Term and short definition are required.";
            return;
        }
        await Kb.ApproveGlossaryCandidateAsync(_approvingCandidateId.Value, new GlossaryTerm
        {
            Term = _form.Term.Trim(),
            Category = _form.Category,
            ShortDef = _form.ShortDef.Trim(),
            Details = _form.Details.Trim(),
            WhenToUse = _form.WhenToUse.Trim(),
            LearnMoreUrl = string.IsNullOrWhiteSpace(_form.LearnMoreUrl) ? null : _form.LearnMoreUrl.Trim()
        });
        _approvingCandidateId = null;
        await RefreshCandidatesAsync();
    }

    private async Task Dismiss(int id)
    {
        await Kb.DismissContentCandidateAsync(id);
        await RefreshCandidatesAsync();
    }

    private sealed class GlossaryForm
    {
        public string Term { get; set; } = "";
        public string Category { get; set; } = "Concept";
        public string ShortDef { get; set; } = "";
        public string Details { get; set; } = "";
        public string WhenToUse { get; set; } = "";
        public string LearnMoreUrl { get; set; } = "";
    }

    private void SetCategory(string cat)
    {
        _filter = cat;
        var qs = cat == "All" ? "" : $"?category={Uri.EscapeDataString(cat)}";
        Nav.NavigateTo($"glossary{qs}", replace: true);
    }

    private List<(string Term, int Count)> EmergingTerms()
    {
        var known = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var t in Kb.Glossary)
        {
            known.Add(t.Term);
            foreach (var a in t.Aliases) known.Add(a);
        }

        return _feedItems
            .Where(i => i.Published >= DateTimeOffset.UtcNow.AddDays(-14))
            .SelectMany(i => i.Tags)
            .Where(tag => !string.IsNullOrWhiteSpace(tag) && !known.Contains(tag))
            .GroupBy(tag => tag, StringComparer.OrdinalIgnoreCase)
            .Where(g => g.Count() >= 2)
            .OrderByDescending(g => g.Count())
            .Take(10)
            .Select(g => (g.Key, g.Count()))
            .ToList();
    }

    private List<FeedItem> RecentMentions(string term) =>
        _feedItems
            .Where(i => i.Tags.Contains(term, StringComparer.OrdinalIgnoreCase))
            .OrderByDescending(i => i.Published)
            .Take(3)
            .ToList();

    private async Task Explain(string term)
    {
        if (!_explaining.Add(term)) return;
        try
        {
            var text = await Ai.ExplainTermAsync(term);
            _explanations[term] = text ?? "Couldn't generate an explanation right now. Try again in a moment.";
        }
        finally
        {
            _explaining.Remove(term);
        }
    }
}

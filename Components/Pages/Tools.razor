@page "/tools"
@rendermode InteractiveServer
@inject KnowledgeBaseService Kb
@inject GitHubTrendingService GitHub

<PageTitle>AiPulse · Tools &amp; Tips</PageTitle>

<div class="page-header">
    <h1><Icon Name="tool" Size="22" /> Tools &amp; Tips</h1>
    <p class="lead">The right tool for the right task, plus concrete ways to cut token usage.</p>
</div>

<AuthorizeView Roles="Admin,Curator" Context="adminPanel">
    <Authorized>
        @if (_pendingCandidates.Count > 0)
        {
            <details class="tools-panel mb-4 review-panel" open="@(_approvingCandidateId is not null)">
                <summary class="tools-panel-title review-summary"><Icon Name="search" Size="16" /> Candidate tools awaiting review <span class="count-pill">@_pendingCandidates.Count</span><span class="review-hint">Show</span></summary>
                <ul class="review-list">
                    @foreach (var c in _pendingCandidates)
                    {
                        <li class="review-item">
                            @if (_approvingCandidateId == c.Id)
                            {
                                <EditForm Model="_form" OnValidSubmit="ConfirmApprove">
                                    <div class="row g-2 mb-2">
                                        <div class="col-md-6">
                                            <label class="form-label small" for="tc-name">Name</label>
                                            <InputText id="tc-name" class="form-control" @bind-Value="_form.Name" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small" for="tc-cat">Category</label>
                                            <InputText id="tc-cat" class="form-control" @bind-Value="_form.Category" />
                                        </div>
                                    </div>
                                    <label class="form-label small" for="tc-one">One-liner (required)</label>
                                    <InputText id="tc-one" class="form-control mb-2" @bind-Value="_form.OneLiner" />
                                    <label class="form-label small" for="tc-best">Best for (comma-separated)</label>
                                    <InputText id="tc-best" class="form-control mb-2" @bind-Value="_form.BestFor" />
                                    <label class="form-label small" for="tc-not">Not ideal for (comma-separated)</label>
                                    <InputText id="tc-not" class="form-control mb-2" @bind-Value="_form.NotIdealFor" />
                                    <label class="form-label small" for="tc-tips">Token tips (comma-separated)</label>
                                    <InputText id="tc-tips" class="form-control mb-2" @bind-Value="_form.TokenTips" />
                                    <label class="form-label small" for="tc-url">URL</label>
                                    <InputText id="tc-url" class="form-control mb-2" @bind-Value="_form.Url" />
                                    @if (_error is not null)
                                    {
                                        <div class="alert alert-danger py-2 small mb-2" role="alert">@_error</div>
                                    }
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="submit" class="btn btn-success">Add to list</button>
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _approvingCandidateId = null">Cancel</button>
                                    </div>
                                </EditForm>
                            }
                            else
                            {
                                <div class="review-text"><strong>@c.Name</strong> <span class="text-muted">· @c.RawNote</span></div>
                                <div class="review-actions">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartApprove(c)">Review</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => Dismiss(c.Id)">Dismiss</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </details>
        }
    </Authorized>
</AuthorizeView>

<section aria-labelledby="matrix-title">
    <div class="tools-head">
        <h2 id="matrix-title" class="tools-title"><Icon Name="tool" Size="18" /> Right tool for the right task</h2>
        <div class="view-switch" role="group" aria-label="Layout">
            <button type="button" class="view-btn @(_view == "matrix" ? "active" : "")" aria-pressed="@(_view == "matrix" ? "true" : "false")" @onclick='() => _view = "matrix"'>
                <Icon Name="list" Size="15" /> Matrix
            </button>
            <button type="button" class="view-btn @(_view == "cards" ? "active" : "")" aria-pressed="@(_view == "cards" ? "true" : "false")" @onclick='() => _view = "cards"'>
                <Icon Name="grid" Size="15" /> Cards
            </button>
        </div>
    </div>

    <div class="tools-filters">
        <div class="tf-field tf-search">
            <label for="tool-search" class="visually-hidden">Search tools</label>
            <input id="tool-search" type="search" class="form-control" placeholder="Search tools or use cases…" autocomplete="off"
                   value="@_search" @oninput="e => { _search = (string)e.Value!; _page = 1; }" />
        </div>
        <div class="tf-field">
            <label for="tool-cat" class="visually-hidden">Category</label>
            <select id="tool-cat" class="form-select" @bind="_category" @bind:after="() => _page = 1">
                <option value="">All categories</option>
                @foreach (var c in Kb.Tools.Select(t => t.Category).Distinct().OrderBy(c => c))
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        <div class="tf-field">
            <label for="tool-sort" class="visually-hidden">Sort</label>
            <select id="tool-sort" class="form-select" value="@SortKey" @onchange="e => SetSortKey((string?)e.Value)">
                <option value="category-asc">Sort: category</option>
                <option value="stars-desc">Sort: most GitHub stars</option>
                <option value="name-asc">Sort: name A-Z</option>
                <option value="name-desc">Sort: name Z-A</option>
            </select>
        </div>
    </div>

    @{
        var (pagedTools, totalTools) = GetPage();
    }
    <p class="tools-count" role="status">@totalTools tool@(totalTools == 1 ? "" : "s")@(_starCounts.Count == 0 ? "" : " · stars are live from GitHub")</p>

    @if (totalTools == 0)
    {
        <div class="tools-empty">
            <EmptyState Icon="search" Title="No tools match the current filter or search" ActionText="Clear filters" OnAction="@(() => { _search = ""; _category = ""; _page = 1; })" />
        </div>
    }
    else
    {
        <div class="matrix-wrap @(_view == "matrix" ? "" : "is-hidden")">
            <table class="matrix">
                <caption class="visually-hidden">Tools compared by what they are best for, what they are not ideal for, and GitHub stars. Column headers sort the table.</caption>
                <thead>
                    <tr>
                        <th scope="col" aria-sort="@AriaSort("name")">@SortButton("name", "Tool")</th>
                        <th scope="col" aria-sort="@AriaSort("category")">@SortButton("category", "Category")</th>
                        <th scope="col">Best for</th>
                        <th scope="col">Not ideal for</th>
                        <th scope="col" class="num" aria-sort="@AriaSort("stars")">@SortButton("stars", "Stars")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tool in pagedTools)
                    {
                        var open = _tipsOpen.Contains(tool.Name);
                        <tr class="@(open ? "has-tips" : "")" @key="tool.Name">
                            <th scope="row" class="tool-cell">
                                @ToolName(tool)
                                <p class="tool-one">@tool.OneLiner</p>
                                @if (tool.TokenTips.Length > 0)
                                {
                                    <button type="button" class="tips-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="@TipsId(tool)" @onclick="() => ToggleTips(tool)">
                                        <Icon Name="zap" Size="13" /> @tool.TokenTips.Length token tip@(tool.TokenTips.Length == 1 ? "" : "s")
                                        <span class="chev" aria-hidden="true"></span>
                                    </button>
                                }
                            </th>
                            <td><span class="cat-chip">@tool.Category</span></td>
                            <td>@FitList(tool.BestFor, true)</td>
                            <td>@FitList(tool.NotIdealFor, false)</td>
                            <td class="num">@Stars(tool)</td>
                        </tr>
                        @if (open && tool.TokenTips.Length > 0)
                        {
                            <tr class="tips-row" id="@TipsId(tool)">
                                <td colspan="5">
                                    <ul class="tips-list">
                                        @foreach (var tip in tool.TokenTips) { <li>@tip</li> }
                                    </ul>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="tool-cards @(_view == "cards" ? "force" : "")">
            @foreach (var group in pagedTools.GroupBy(t => _sortColumn == "category" ? t.Category : ""))
            {
                @if (!string.IsNullOrEmpty(group.Key))
                {
                    <h3 class="group-title">@group.Key</h3>
                }
                <div class="card-grid">
                    @foreach (var tool in group)
                    {
                        <article class="tool-card" @key="tool.Name">
                            <header class="tool-card-head">
                                <h4 class="tool-card-name">@ToolName(tool)</h4>
                                @Stars(tool)
                            </header>
                            <span class="cat-chip">@tool.Category</span>
                            <p class="tool-one">@tool.OneLiner</p>
                            <div class="fit-grid">
                                <div>
                                    <p class="fit-label fit-yes-label">Best for</p>
                                    @FitList(tool.BestFor, true)
                                </div>
                                <div>
                                    <p class="fit-label fit-no-label">Not ideal for</p>
                                    @FitList(tool.NotIdealFor, false)
                                </div>
                            </div>
                            @if (tool.TokenTips.Length > 0)
                            {
                                <details class="card-tips">
                                    <summary><Icon Name="zap" Size="13" /> @tool.TokenTips.Length token tip@(tool.TokenTips.Length == 1 ? "" : "s")</summary>
                                    <ul class="tips-list">
                                        @foreach (var tip in tool.TokenTips) { <li>@tip</li> }
                                    </ul>
                                </details>
                            }
                        </article>
                    }
                </div>
            }
        </div>

        @if (totalTools > _pageSize)
        {
            <Pager TotalItems="totalTools" @bind-CurrentPage="_page" @bind-PageSize="_pageSize" PageSizeOptions="new[] { 10, 20, 50 }" />
        }
    }
</section>

<section class="practices" aria-labelledby="practices-title">
    <h2 id="practices-title" class="tools-title"><Icon Name="sparkle" Size="18" /> Best practices &amp; token optimization</h2>
    @foreach (var group in Kb.Practices.GroupBy(p => p.Category))
    {
        <h3 class="group-title">@group.Key</h3>
        <div class="card-grid">
            @foreach (var tip in group)
            {
                <article class="tip-card">
                    <h4 class="tip-title">@tip.Title</h4>
                    <p class="tip-body">@tip.Body</p>
                </article>
            }
        </div>
    }
</section>

@code {
    private List<TrendingRepo> _trendingRepos = new();
    private Dictionary<string, int> _starCounts = new();

    private string _search = "";
    private string _category = "";
    private string _sortColumn = "category";
    private bool _sortAscending = true;
    private string _view = "matrix";
    private readonly HashSet<string> _tipsOpen = new();
    private int _page = 1;
    private int _pageSize = 20;

    protected override void OnInitialized()
    {
        // Independent loads - a slow/unreachable GitHub trending fetch shouldn't hold up the popularity
        // badges on the curated tools list below (or vice versa).
        _ = LoadTrendingReposAsync();
        _ = LoadStarCountsAsync();
        _ = RefreshCandidatesAsync();
    }

    /// <summary>No display panel for this anymore - the fetch only feeds QueueToolCandidatesAsync's candidate detection below.</summary>
    private async Task LoadTrendingReposAsync()
    {
        _trendingRepos = await GitHub.GetTrendingReposAsync();
        await QueueToolCandidatesAsync();
    }

    private static readonly string[] AiToolKeywords =
    {
        "ai", "llm", "gpt", "agent", "copilot", "assistant", "chatbot", "rag", "prompt",
        "claude", "openai", "ollama", "langchain", "vector", "embedding", "coding agent"
    };

    /// <summary>
    /// Trending repos not already on the curated list (by name/URL), filtered to ones that look like
    /// AI-dev-tooling by keyword match on name/description - the closest deterministic substitute for "is
    /// this actually relevant to this page" without an AI call to judge it.
    /// </summary>
    private async Task QueueToolCandidatesAsync()
    {
        var existingNames = Kb.Tools.Select(t => t.Name).Concat(Kb.Tools.Select(t => t.Url ?? "")).ToList();
        var candidates = _trendingRepos
            .Where(r => AiToolKeywords.Any(k =>
                r.FullName.Contains(k, StringComparison.OrdinalIgnoreCase) ||
                (r.Description?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false)))
            .Take(20);

        foreach (var r in candidates)
            await Kb.AddContentCandidateIfNewAsync("Tool", r.FullName, "Coding Agent", r.Description ?? r.Url, existingNames);

        await RefreshCandidatesAsync();
    }

    private List<ContentCandidate> _pendingCandidates = new();
    private int? _approvingCandidateId;
    private string? _error;
    private ToolForm _form = new();

    private async Task RefreshCandidatesAsync() => _pendingCandidates = await Kb.GetPendingContentCandidatesAsync("Tool");

    private void StartApprove(ContentCandidate c)
    {
        _approvingCandidateId = c.Id;
        _error = null;
        _form = new ToolForm { Name = c.Name, Category = c.Category ?? "Coding Agent", Url = c.RawNote?.StartsWith("http") == true ? c.RawNote : "" };
    }

    private async Task ConfirmApprove()
    {
        if (_approvingCandidateId is null) return;
        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.OneLiner))
        {
            _error = "Name and one-liner are required.";
            return;
        }
        static string[] Split(string s) => s.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        await Kb.ApproveToolCandidateAsync(_approvingCandidateId.Value, new ToolEntry
        {
            Name = _form.Name.Trim(),
            Category = _form.Category.Trim(),
            OneLiner = _form.OneLiner.Trim(),
            BestFor = Split(_form.BestFor),
            NotIdealFor = Split(_form.NotIdealFor),
            TokenTips = Split(_form.TokenTips),
            Url = string.IsNullOrWhiteSpace(_form.Url) ? null : _form.Url.Trim()
        });
        _approvingCandidateId = null;
        await RefreshCandidatesAsync();
    }

    private async Task Dismiss(int id)
    {
        await Kb.DismissContentCandidateAsync(id);
        await RefreshCandidatesAsync();
    }

    private sealed class ToolForm
    {
        public string Name { get; set; } = "";
        public string Category { get; set; } = "Coding Agent";
        public string OneLiner { get; set; } = "";
        public string BestFor { get; set; } = "";
        public string NotIdealFor { get; set; } = "";
        public string TokenTips { get; set; } = "";
        public string Url { get; set; } = "";
    }

    private async Task LoadStarCountsAsync()
    {
        var lookups = Kb.Tools
            .Select(t => (Tool: t, Repo: ParseGitHubUrl(t.Url)))
            .Where(x => x.Repo is not null)
            .ToList();

        var results = await Task.WhenAll(lookups.Select(async x =>
        {
            var stars = await GitHub.GetRepoStatsAsync(x.Repo!.Value.Owner, x.Repo.Value.Repo);
            return (x.Tool.Name, Stars: stars);
        }));

        _starCounts = results.Where(r => r.Stars.HasValue).ToDictionary(r => r.Name, r => r.Stars!.Value);
        StateHasChanged();
    }

    /// <summary>Extracts (owner, repo) from a tool's Url if it points at a github.com repo - used to look up a live star count for the "Popularity" sort/badge.</summary>
    private static (string Owner, string Repo)? ParseGitHubUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri) || !uri.Host.Equals("github.com", StringComparison.OrdinalIgnoreCase))
            return null;

        var parts = uri.AbsolutePath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? (parts[0], parts[1]) : null;
    }


    private (List<ToolEntry> Tools, int Total) GetPage()
    {
        IEnumerable<ToolEntry> q = Kb.Tools;

        if (!string.IsNullOrEmpty(_category))
            q = q.Where(t => t.Category == _category);

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim();
            q = q.Where(t =>
                t.Name.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                t.OneLiner.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                t.BestFor.Any(b => b.Contains(s, StringComparison.OrdinalIgnoreCase)));
        }

        q = ToolMatrix.Sort(q, _sortColumn, _sortAscending, _starCounts);

        var list = q.ToList();
        var page = list.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
        return (page, list.Count);
    }

    private string SortKey => $"{_sortColumn}-{(_sortAscending ? "asc" : "desc")}";

    private void SetSortKey(string? key)
    {
        var parts = (key ?? "category-asc").Split('-');
        _sortColumn = parts[0];
        _sortAscending = parts.Length < 2 || parts[1] == "asc";
        _page = 1;
    }

    /// <summary>Header click: same column flips direction; a new column starts in its natural direction (stars high-to-low, text A-Z).</summary>
    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = column != "stars"; }
        _page = 1;
    }

    private string AriaSort(string column) => _sortColumn != column ? "none" : _sortAscending ? "ascending" : "descending";

    private void ToggleTips(ToolEntry t)
    {
        if (!_tipsOpen.Add(t.Name)) _tipsOpen.Remove(t.Name);
    }

    private static string TipsId(ToolEntry t) => "tips-" + GlossaryIndex.Slug(t.Name);

    private RenderFragment SortButton(string column, string label) => @<button type="button" class="sort-btn @(_sortColumn == column ? "active" : "")" @onclick="() => SortBy(column)">
        @label
        <span class="sort-ind" aria-hidden="true">@(_sortColumn != column ? "↕" : _sortAscending ? "↑" : "↓")</span>
    </button>;

    private RenderFragment ToolName(ToolEntry tool) => @<span class="tool-name">
        @if (!string.IsNullOrWhiteSpace(tool.Url))
        {
            <a href="@tool.Url" target="_blank" rel="noopener">@tool.Name<Icon Name="external-link" Size="13" /><span class="visually-hidden"> (opens in a new tab)</span></a>
        }
        else
        {
            @tool.Name
        }
    </span>;

    private RenderFragment Stars(ToolEntry tool) => @<span>
        @if (_starCounts.TryGetValue(tool.Name, out var stars))
        {
            <span class="stars" title="Live GitHub star count"><Icon Name="star" Size="13" /> @ToolMatrix.FormatStars(stars)</span>
        }
        else
        {
            <span class="stars none" title="Not a GitHub project, or stars not loaded yet">-</span>
        }
    </span>;

    private static RenderFragment FitList(string[] items, bool good) => @<ul class="fit-list @(good ? "fit-yes" : "fit-no")">
        @foreach (var i in items) { <li>@i</li> }
    </ul>;
}

@page "/news"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject FeedAggregatorService Feeds
@inject FeedHistoryService History
@inject ReadingStateService Reading
@inject FollowService Follow
@inject CommentService CommentsSvc
@inject KnowledgeBaseService Kb
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toasts
@inject ISummarizer Ai
@inject ILogger<News> Log
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>AiPulse · News Feed</PageTitle>

<header class="news-head">
    <div class="news-head-text">
        <h1 class="news-title"><Icon Name="rss" Size="22" /> News Feed</h1>
        <p class="news-status" aria-live="polite">
            @if (_result is null)
            {
                <span>Collecting the latest from across the AI world…</span>
            }
            else if (_result.FetchedAt == DateTimeOffset.MinValue)
            {
                <span>Showing saved history@(_loading ? " · fetching live updates…" : "")</span>
            }
            else
            {
                <span>Updated <time datetime="@_result.FetchedAt.ToString("o")" title="@_result.FetchedAt.ToLocalTime().ToString("f")">@ContentUi.RelativeTime(_result.FetchedAt, DateTimeOffset.Now)</time></span>
            }
            @if (_loading && _result is not null)
            {
                <span class="news-live-dot" aria-hidden="true"></span>
            }
        </p>
    </div>
    <div class="news-head-actions">
        @* Refresh/Mark-all-as-read are account actions, not browsing filters - a signed-out visitor sees just the display and filter controls. *@
        @if (_userId is not null)
        {
            <button class="btn btn-outline-secondary news-btn" title="Mark every item in the current view as read" @onclick="MarkAllAsRead">
                <Icon Name="check" Size="15" /> <span class="news-btn-label">Mark all read</span>
            </button>
            <button class="btn btn-primary news-btn" @onclick="() => Load(true)" disabled="@_loading">
                @if (_loading) { <span class="spinner"></span> } else { <Icon Name="refresh" Size="15" /> }
                <span class="news-btn-label">@(_loading ? "Refreshing…" : "Refresh")</span>
            </button>
        }
        <button class="btn btn-outline-secondary news-btn news-btn--icon" title="Keyboard shortcuts" aria-label="Keyboard shortcuts" aria-expanded="@(_showShortcutsHelp ? "true" : "false")"
                @onclick="() => _showShortcutsHelp = !_showShortcutsHelp">
            <span aria-hidden="true">?</span>
        </button>
    </div>
</header>

@if (_showShortcutsHelp)
{
    <div class="news-shortcuts" role="note">
        <strong>Keyboard shortcuts</strong> <span class="text-muted">(inactive while typing)</span>
        <ul>
            <li><kbd>j</kbd> <kbd>k</kbd> next / previous</li>
            <li><kbd>o</kbd> <kbd>Enter</kbd> open</li>
            <li><kbd>m</kbd> toggle read</li>
            <li><kbd>b</kbd> toggle bookmark</li>
            <li><kbd>r</kbd> refresh</li>
            <li><kbd>?</kbd> this help</li>
            <li><kbd>Esc</kbd> clear focus</li>
        </ul>
    </div>
}

<div class="news-layout">
<div class="news-main">
    @{
        var (pageItems, totalItems) = _result is null ? (new List<FeedItem>(), 0) : GetPage();
        _lastTotal = totalItems;
    }
    <div class="news-toolbar">
        <div class="nt-row">
            <div class="nt-search">
                <Icon Name="search" Size="16" CssClass="nt-search-icon" />
                <input type="search" class="nt-search-input" placeholder="Search the feed…" aria-label="Search the feed"
                       value="@_search" @oninput="e => { _search = (string)e.Value!; _page = 1; }" />
                @if (!string.IsNullOrEmpty(_search))
                {
                    <button type="button" class="nt-search-clear" title="Clear search" aria-label="Clear search" @onclick="() => { _search = string.Empty; _page = 1; }">
                        <span aria-hidden="true">✕</span>
                    </button>
                }
            </div>
            <button type="button" class="nt-filters-btn" aria-controls="news-side" aria-expanded="@(_showFilters ? "true" : "false")" @onclick="() => _showFilters = !_showFilters">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
                <span class="nt-filters-label">Filters</span>
                @if (PanelFilterCount() is > 0 and var panelCount)
                {
                    <span class="nt-badge">@panelCount</span>
                }
            </button>
            <div class="nt-density" role="group" aria-label="Layout">
                @foreach (var d in Enum.GetValues<FeedDensity>())
                {
                    <button type="button" class="nt-density-btn @(_density == d ? "is-active" : "")" aria-pressed="@(_density == d ? "true" : "false")"
                            title="@DensityLabel(d)" aria-label="@DensityLabel(d)" @onclick="() => SetDensity(d)">
                        @DensityIcon(d)
                    </button>
                }
            </div>
        </div>
        <div class="nt-row nt-row--tabs">
            <div class="nt-tabs" role="group" aria-label="Show">
                @foreach (var f in _filters)
                {
                    @* "Following" and "New" only mean something for a signed-in user - nothing to follow, and no remembered
                       last visit to be new since (so an anonymous visitor saw every single item as New), otherwise. *@
                    @if (f is not ("Following" or "New") || _userId is not null)
                    {
                        <button type="button" class="nt-tab @(_filter == f ? "is-active" : "")" aria-pressed="@(_filter == f ? "true" : "false")" @onclick="() => SetFilter(f)">
                            @f
                            @if (f == "New" && NewCount() is > 0 and var newCount)
                            {
                                <span class="nt-tab-count">@newCount.ToString("N0")</span>
                            }
                        </button>
                    }
                }
            </div>
            @if (_result is not null)
            {
                <span class="nt-count" aria-live="polite">@_lastTotal.ToString("N0") @(_lastTotal == 1 ? "story" : "stories")</span>
            }
        </div>
        @{ var active = ActiveFilters(); }
        @if (active.Count > 0)
        {
            <div class="nt-chips" aria-label="Active filters">
                @foreach (var chip in active)
                {
                    <button type="button" class="nt-chip" title="Remove filter: @chip.Label" @onclick="chip.Clear">
                        <span class="nt-chip-label">@chip.Label</span>
                        <span class="nt-chip-x" aria-hidden="true">✕</span>
                    </button>
                }
                <button type="button" class="nt-clear" @onclick="ClearAllFilters">Clear all</button>
            </div>
        }
        @if (_pendingNewCount > 0)
        {
            <div class="nt-live" role="status">
                <button type="button" class="nt-live-show" @onclick="ApplyPending">
                    <Icon Name="arrow-up" Size="15" /> @_pendingNewCount.ToString("N0") new item@(_pendingNewCount == 1 ? "" : "s") ready, show
                </button>
                <button type="button" class="nt-live-dismiss" title="Dismiss" aria-label="Dismiss" @onclick="DismissPending">
                    <span aria-hidden="true">✕</span>
                </button>
            </div>
        }
    </div>

    @if (_loadError is not null)
    {
        <div class="news-callout news-callout--warn" role="alert">
            <Icon Name="refresh" Size="18" />
            <div class="news-callout-text">
                <strong>Couldn't refresh just now.</strong>
                <span>@_loadError</span>
            </div>
            <button class="btn btn-sm btn-outline-secondary" disabled="@_loading" @onclick="() => Load(true)">Try again</button>
        </div>
    }

    @if (_loading && _result is null)
    {
        <div class="news-list news-list--@ContentUi.DensityKey(_density)" aria-busy="true" aria-label="Loading stories">
            @for (var s = 0; s < 6; s++)
            {
                <div class="sk-card sk-card--@ContentUi.DensityKey(_density)" aria-hidden="true">
                    @if (_density != FeedDensity.Compact) { <div class="sk-media"></div> }
                    <div class="sk-body">
                        <div class="sk-line sk-w-30"></div>
                        <div class="sk-line sk-line--title sk-w-90"></div>
                        <div class="sk-line sk-line--title sk-w-60"></div>
                        @if (_density != FeedDensity.Compact) { <div class="sk-line sk-w-80"></div> }
                    </div>
                </div>
            }
        </div>
    }
    else if (_result is null)
    {
        <div class="news-empty">
            <EmptyState Icon="rss" Title="No stories yet" Body="The sources haven't returned anything on this first load. They're polled every few minutes; try again shortly." ActionText="Try again" OnAction="() => Load(true)" />
        </div>
    }
    else
    {
        var items = pageItems;
        _visibleItems = items;
        RequestCommentCounts(items);

        @if (_result.Errors.Count > 0)
        {
            <details class="news-errors">
                <summary>@_result.Errors.Count source@(_result.Errors.Count == 1 ? "" : "s") couldn't be reached</summary>
                <ul>
                    @foreach (var err in _result.Errors) { <li>@err</li> }
                </ul>
            </details>
        }

        @if (totalItems == 0)
        {
            <div class="news-empty">
                @if (_filter == "Unread" && ActiveFilters().Count == 0)
                {
                    <EmptyState Icon="check" Title="You're all caught up" Body="Every story in your feed has been read. New ones arrive as the sources are polled." ActionText="Show everything" OnAction='() => SetFilter("All")' />
                }
                else
                {
                    <EmptyState Icon="search" Title="Nothing matches these filters" Body="Try a broader search, another tab, or remove a filter." ActionText="Clear all filters" OnAction="ClearAllFilters" />
                }
            </div>
        }
        else
        {
            <div class="news-list news-list--@ContentUi.DensityKey(_density)">
                @foreach (var (item, idx) in items.Select((it, i) => (it, i)))
                {
                    <div class="news-item" id="news-item-@idx" @key="item.Link">
                        <FeedItemCard Item="item" Layout="@ContentUi.CardLayout(_density)"
                                      IsNew="IsNewItem(item)"
                                      WatchedKeyword='@Reading.MatchWatchlist(item.Title + " " + item.Summary)'
                                      IsRead="Reading.IsRead(item.Link)"
                                      IsBookmarked="Reading.IsBookmarked(item.Link)"
                                      OnToggleRead="() => ToggleRead(item)"
                                      OnToggleBookmark="() => Toggle(item)"
                                      OnOpened="() => MarkAsRead(item)"
                                      OnMuteSource="MuteSource"
                                      IsFollowingSource="_followedSources.Contains(item.SourceName)"
                                      OnFollowSource="_userId.HasValue ? EventCallback.Factory.Create<string>(this, ToggleFollowSource) : default"
                                      ShowFullTextToggle="true"
                                      Expanded="_expandedLinks.Contains(item.Link)"
                                      OnToggleExpanded="() => ToggleExpanded(item.Link)"
                                      CommentCount="GetCommentCount(item)"
                                      CommentsExpanded="_expandedComments.Contains(item.Link)"
                                      OnToggleComments="() => ToggleComments(item.Link)"
                                      OnCommentCountChanged="c => _commentCounts[item.Link] = c"
                                      OnSummarize="@(CanSummarize ? EventCallback.Factory.Create(this, () => SummarizeAsync(item)) : default)"
                                      AiSummary="@GetSummaryText(item)"
                                      AiSummaryIsError="IsSummaryError(item)"
                                      AiSummaryBusy="_summarizing.Contains(item.Link)"
                                      CssClass='@(idx == _focusedIndex ? "kb-focused" : "")' />
                    </div>
                }
            </div>

            <Pager TotalItems="totalItems" @bind-CurrentPage="_page" PageSize="_pageSize" PageSizeChanged="OnPageSizeChanged" />
        }
    }
</div>

@if (_showFilters)
{
    <div class="news-side-backdrop" @onclick="() => _showFilters = false"></div>
}
<aside id="news-side" class="news-side @(_showFilters ? "is-open" : "")" aria-label="Filters">
    <div class="news-side-head">
        <h2 class="news-side-title">Filters</h2>
        <button type="button" class="news-side-close" title="Close filters" aria-label="Close filters" @onclick="() => _showFilters = false">
            <span aria-hidden="true">✕</span>
        </button>
    </div>

    <section class="news-side-section">
        <h3 class="news-side-label"><Icon Name="calendar" Size="15" /> Calendar</h3>
        <MonthCalendar Items="_result?.Items ?? new()" RangeStart="_dateFrom" RangeEnd="_dateTo" OnRangeChanged="OnCalendarRangeChanged" />
    </section>

    <section class="news-side-section">
        <h3 class="news-side-label"><Icon Name="tool" Size="15" /> Refine</h3>
        <div class="news-selects">
            <label>
                <span>Category</span>
                <select class="form-select form-select-sm" @bind="_category" @bind:after="SyncUrl">
                    <option value="">All</option>
                    @foreach (var cat in _categories) { <option value="@cat">@cat</option> }
                </select>
            </label>
            <label>
                <span>Type</span>
                <select class="form-select form-select-sm" @bind="_contentType" @bind:after="SyncUrl">
                    <option value="">All</option>
                    @foreach (var ct in _contentTypes) { <option value="@ct">@ct</option> }
                </select>
            </label>
            <label>
                <span>Level</span>
                <select class="form-select form-select-sm" @bind="_level" @bind:after="SyncUrl">
                    <option value="">All</option>
                    @foreach (var lvl in _levels) { <option value="@lvl">@lvl</option> }
                </select>
            </label>
            <label>
                <span>Sort</span>
                <select class="form-select form-select-sm" @bind="_sort" @bind:after="SyncUrl">
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                    <option value="source">Source A-Z</option>
                    <option value="title">Title A-Z</option>
                </select>
            </label>
        </div>
    </section>

    @if (AvailableSources().Count > 0)
    {
        <section class="news-side-section">
            <h3 class="news-side-label"><Icon Name="database" Size="15" /> Sources <span class="news-side-hint">select any number</span></h3>
            <input type="search" class="form-control form-control-sm mb-2" placeholder="Find a source…" aria-label="Find a source"
                   value="@_sourceSearch" @oninput="e => _sourceSearch = (string)e.Value!" />
            <div class="news-chip-scroll">
                @{ var filteredSources = FilteredSources(); }
                @foreach (var src in filteredSources)
                {
                    <button type="button" class="news-pick @(_sources.Contains(src) ? "is-active" : "")" aria-pressed="@(_sources.Contains(src) ? "true" : "false")" @onclick="() => ToggleSource(src)">@src</button>
                }
                @if (filteredSources.Count == 0)
                {
                    <span class="text-muted small">No sources match "@_sourceSearch".</span>
                }
            </div>
        </section>
    }

    @if (_result is not null && AvailableTags().Count > 0)
    {
        <section class="news-side-section">
            <h3 class="news-side-label"><Icon Name="trending-up" Size="15" /> Tags</h3>
            <div class="news-chip-scroll news-chip-scroll--short">
                @foreach (var t in AvailableTags().Take(24))
                {
                    <button type="button" class="news-pick @(_tag == t ? "is-active" : "")" aria-pressed="@(_tag == t ? "true" : "false")" @onclick='() => SetTag(_tag == t ? "" : t)'>#@t</button>
                }
            </div>
        </section>
    }

    @* Meaningless for an anonymous, per-tab-only session (Phase 0's ReadingStateService in-memory
       state doesn't survive a refresh) - hidden entirely for signed-out visitors rather than shown
       and silently forgotten. *@
    <AuthorizeView>
        <Authorized>
            <section class="news-side-section">
                <h3 class="news-side-label"><Icon Name="star" Size="15" /> Saved searches</h3>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    @foreach (var saved in Reading.SavedSearches)
                    {
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" title="@SavedSearchSummary(saved)" @onclick="() => ApplySavedSearch(saved)">@saved.Name</button>
                            <button class="btn btn-outline-danger" title="Delete this saved search" aria-label="Delete saved search @saved.Name" @onclick="() => Reading.RemoveSavedSearch(saved.Id)"><Icon Name="trash" Size="12" /></button>
                        </div>
                    }
                    @if (_savingSearch)
                    {
                        <input class="form-control form-control-sm" style="max-width:180px" placeholder="Name this search…" aria-label="Name this search"
                               value="@_savedSearchName" @oninput="e => _savedSearchName = (string)e.Value!"
                               @onkeydown="@(e => { if (e.Key == "Enter") SaveCurrentSearch(); })" />
                        <button class="btn btn-sm btn-success" @onclick="SaveCurrentSearch" disabled="@string.IsNullOrWhiteSpace(_savedSearchName)">Save</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _savingSearch = false">Cancel</button>
                    }
                    else if (HasSaveableFilters())
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => _savingSearch = true">
                            <Icon Name="star" Size="12" /> Save current filters…
                        </button>
                    }
                    else if (Reading.SavedSearches.Count == 0)
                    {
                        <span class="text-muted small">Set a search or filter, then save it here for one-click reuse.</span>
                    }
                </div>
            </section>
        </Authorized>
    </AuthorizeView>

    <div class="news-side-foot">
        <button type="button" class="btn btn-primary w-100" @onclick="() => _showFilters = false">Show @_lastTotal.ToString("N0") @(_lastTotal == 1 ? "story" : "stories")</button>
    </div>
</aside>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tag")]
    public string? TagParam { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? DateParam { get; set; }

    [SupplyParameterFromQuery(Name = "dateFrom")]
    public string? DateFromParam { get; set; }

    [SupplyParameterFromQuery(Name = "dateTo")]
    public string? DateToParam { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewParam { get; set; }

    [SupplyParameterFromQuery(Name = "filter")]
    public string? FilterParam { get; set; }

    [SupplyParameterFromQuery(Name = "contentType")]
    public string? ContentTypeParam { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryParam { get; set; }

    [SupplyParameterFromQuery(Name = "level")]
    public string? LevelParam { get; set; }

    [SupplyParameterFromQuery(Name = "source")]
    public string? SourceParam { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortParam { get; set; }

    private FeedResult? _result;
    private FeedResult? _pendingResult;
    private int _pendingNewCount;
    private bool _loading;
    private string? _loadError;
    private string _filter = "Unread";
    private string _search = "";
    private string _contentType = "";
    private string _category = "";
    private string _level = "";
    private string _sourceSearch = "";
    private HashSet<string> _sources = new(StringComparer.OrdinalIgnoreCase);
    private string _sort = "newest";
    private string _tag = "";
    private DateOnly? _dateFrom;
    private DateOnly? _dateTo;
    private FeedDensity _density = FeedDensity.Grid;
    private bool _showFilters;
    private int _lastTotal;
    private IJSObjectReference? _prefs;
    private int _page = 1;
    // Starts small: rendering 100 cards cost 170-320 ms per interaction (vs 37-51 ms for 20) and shipped a
    // 468 KB document - fine on a desktop, a 46,000 px scroll and laggy typing on a phone. Grows to 100 on
    // wide viewports once the circuit can ask the browser (OnAfterRenderAsync); a size the user picks wins.
    private const int WidePageSize = 100;
    private int _pageSize = 20;
    private bool _pageSizeChosen;
    private DateTimeOffset _sinceVisit = DateTimeOffset.MinValue;
    private List<FeedItem> _visibleItems = new();
    private readonly HashSet<string> _expandedLinks = new();
    private readonly HashSet<string> _expandedComments = new();
    private readonly Dictionary<string, int> _commentCounts = new();
    private readonly HashSet<string> _commentCountsRequested = new();
    private int _focusedIndex = -1;
    private bool _showShortcutsHelp;
    private DotNetObjectReference<News>? _dotNetRef;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _userId;
    private HashSet<string> _followedSources = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _followedTags = new(StringComparer.OrdinalIgnoreCase);

    private readonly string[] _filters = { "Unread", "New", "Read", "All", "Following" };
    private readonly string[] _categories = { "News", "Research", "Tools", "Community" };
    private readonly string[] _contentTypes = { "News", "Tutorial", "Paper", "Discussion", "Video" };
    private readonly string[] _levels = { "Beginner", "Intermediate", "Advanced" };
    private readonly string[] _sortOptions = { "newest", "oldest", "source", "title" };

    /// <summary>
    /// Filter state is read from the query string, absent meaning "default" - SyncUrl omits defaults, so the
    /// two are exact mirrors. Runs on every parameter change, not just first load: otherwise following any
    /// in-app link to /news (sidebar "News Feed", a tag link, global search) while already on this page
    /// rewrote the URL but silently kept the old filters applied, and a refresh then jumped somewhere else.
    /// </summary>
    protected override void OnParametersSet() => ApplyQueryParams();

    private void ApplyQueryParams()
    {
        _tag = !string.IsNullOrWhiteSpace(TagParam) ? TagParam : "";

        if (DateOnly.TryParse(DateFromParam, out var dFrom) && DateOnly.TryParse(DateToParam, out var dTo))
        {
            _dateFrom = dFrom < dTo ? dFrom : dTo;
            _dateTo = dFrom < dTo ? dTo : dFrom;
        }
        else if (DateOnly.TryParse(DateParam, out var d))
        {
            _dateFrom = d;
            _dateTo = d;
        }
        else
        {
            _dateFrom = null;
            _dateTo = null;
        }

        // ?view= is an override for shared/old links (List|Grid|comfortable|compact); otherwise the reader's saved density stands.
        if (!string.IsNullOrWhiteSpace(ViewParam)) _density = ContentUi.ParseDensity(ViewParam, _density);
        _filter = !string.IsNullOrWhiteSpace(FilterParam) && _filters.Contains(FilterParam) ? FilterParam : "Unread";
        _contentType = !string.IsNullOrWhiteSpace(ContentTypeParam) && _contentTypes.Contains(ContentTypeParam) ? ContentTypeParam : "";
        _category = !string.IsNullOrWhiteSpace(CategoryParam) && _categories.Contains(CategoryParam) ? CategoryParam : "";
        _level = !string.IsNullOrWhiteSpace(LevelParam) && _levels.Contains(LevelParam) ? LevelParam : "";
        _sources = !string.IsNullOrWhiteSpace(SourceParam)
            ? new HashSet<string>(SourceParam.Split(',').Select(Uri.UnescapeDataString), StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _sort = !string.IsNullOrWhiteSpace(SortParam) && _sortOptions.Contains(SortParam) ? SortParam : "newest";
    }

    protected override void OnInitialized()
    {
        // The saved density, mirrored into a cookie by feed-prefs.js, so the prerendered page already has the right layout (no
        // flash of the default grid before the browser's localStorage can be read).
        try
        {
            if (HttpContextAccessor.HttpContext?.Request.Cookies[ContentUi.DensityStorageKey] is { Length: > 0 } saved)
                _density = ContentUi.ParseDensity(saved);
        }
        catch { /* no request context on this pass - the browser-side copy is applied after first render */ }

        // Peek (don't mark yet) so prerender + the interactive circuit's own OnInitializedAsync - two
        // separate component instances, both hitting this - agree on the same cutoff. Marking the visit
        // itself is deferred to OnAfterRenderAsync(firstRender), which Blazor Server guarantees runs exactly
        // once in the real circuit; doing the mutate-on-read here would let the interactive pass read back
        // the timestamp the prerender pass had just written, collapsing "New" to ~0 items every time.
        _sinceVisit = Reading.LastNewsVisit;

        // Show what we already know instantly instead of a blank "Fetching..." state - FeedHistoryService's
        // persisted items are already on disk and available with no network wait, even right after a
        // restart. Load() below still runs and replaces this with the live, fully-deduped result once it
        // resolves; in the meantime this is at least real (if slightly stale, and not fuzzy-deduped) data.
        var historyItems = History.Items;
        if (historyItems.Count > 0)
        {
            _result = new FeedResult { Items = historyItems.ToList(), Errors = new(), FetchedAt = DateTimeOffset.MinValue };
        }

        // Progressive fill-in: as each source finishes during the live fetch, update the list instead of
        // waiting for the entire batch - with 100+ Reddit sources sharing one rate-limited host, "the whole
        // batch" can take 10+ minutes, so a one-shot swap at the end would leave the page looking frozen.
        Feeds.PartialProgress += OnPartialProgress;
        Feeds.CacheUpdated += OnCacheUpdated;

        // Fire-and-forget: this page must render immediately instead of blocking behind Feeds.GetAsync()
        // on a cold cache - a blocking OnInitializedAsync would leave the page showing nothing at all for
        // however long the live fetch takes.
        _ = Load(false);

        // Same fire-and-forget reasoning: don't block the page's first render on a DB round-trip just to
        // find out whether this visitor even has an account.
        _ = LoadFollowsAsync();
    }

    /// <summary>Resolves the signed-in user's id (null for anonymous, since News is public now) and their
    /// followed sources/tags, for the "Following" filter and the per-card follow star.</summary>
    private async Task LoadFollowsAsync()
    {
        if (AuthStateTask is null) return;
        var authState = await AuthStateTask;
        var idClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(idClaim, out var uid)) return;

        _userId = uid;
        _followedSources = await Follow.GetFollowedSourcesAsync(uid);
        _followedTags = await Follow.GetFollowedTagsAsync(uid);
        StateHasChanged();
    }

    private async Task ToggleFollowSource(string sourceName)
    {
        if (_userId is not { } uid) return;
        var following = await Follow.ToggleFollowSourceAsync(uid, sourceName);
        if (following) _followedSources.Add(sourceName); else _followedSources.Remove(sourceName);
    }

    /// <summary>
    /// A poll finished somewhere else: the background watcher (every few minutes, whether or not anyone is looking) or a WebSub push. Route it
    /// through the same buffer as everything else, so an open tab shows the "N new items ready" banner instead of the list silently going stale
    /// or jumping under the reader. A fetch started by this very tab already delivers its own result, so it is skipped here.
    /// </summary>
    private void OnCacheUpdated(FeedResult result) => _ = InvokeAsync(() =>
    {
        if (_loading) return;
        BufferOrApply(result);
        StateHasChanged();
    });

    private void OnPartialProgress(IReadOnlyList<FeedItem> items)
    {
        _ = InvokeAsync(() =>
        {
            // Only while a live fetch is actually in flight - once Load() finishes, its own fully-deduped
            // result should stand rather than a stray late progress tick from some other page's refresh.
            if (!_loading) return;
            BufferOrApply(new FeedResult { Items = items.ToList(), Errors = _result?.Errors ?? new(), FetchedAt = DateTimeOffset.Now });
            StateHasChanged();
        });
    }

    /// <summary>
    /// The visible list only ever changes when the user asks it to - it used to reshuffle live on every
    /// progressive tick (and on every Refresh), which with 100+ sources completing at different times meant
    /// the list could visibly jump several times while someone was mid-read. Still on the History-preloaded
    /// placeholder (nothing real shown yet, nothing to disrupt)? Apply immediately - that's what makes the
    /// cold-start fill-in feel fast. Otherwise, buffer the incoming data and surface it as a "N new items"
    /// banner instead, same for a progressive tick or a completed Refresh.
    /// </summary>
    private void BufferOrApply(FeedResult candidate)
    {
        if (_result is null || _result.FetchedAt == DateTimeOffset.MinValue)
        {
            ApplyResult(candidate);
            return;
        }

        _pendingResult = candidate;
        var currentLinks = new HashSet<string>(_result.Items.Select(i => i.Link), StringComparer.OrdinalIgnoreCase);
        _pendingNewCount = candidate.Items.Count(i => !currentLinks.Contains(i.Link));
    }

    /// <summary>
    /// A live fetch (partial or final) only contains what feeds serve right now, so showing it as-is made the
    /// list collapse from the whole saved history (~15k items) to whatever the first few sources had returned
    /// (20 items, then slowly growing) the moment the first progress tick landed - and the final result never
    /// brought the saved items back. Merging history in by link keeps the list from ever shrinking below what's
    /// saved; the live copy wins for items in both. History is recorded from already-deduped live results, so
    /// this doesn't resurrect near-duplicates the live pass folded into "+N more sources".
    /// </summary>
    private void ApplyResult(FeedResult live)
    {
        var liveLinks = new HashSet<string>(live.Items.Select(i => i.Link), StringComparer.OrdinalIgnoreCase);
        var merged = live.Items
            .Concat(History.Items.Where(i => !liveLinks.Contains(i.Link)))
            .OrderByDescending(i => i.Published)
            .ToList();
        _result = new FeedResult { Items = merged, Errors = live.Errors, FetchedAt = live.FetchedAt };
    }

    private void ApplyPending()
    {
        if (_pendingResult is null) return;
        ApplyResult(_pendingResult);
        _pendingResult = null;
        _pendingNewCount = 0;
        _page = 1;
    }

    private void DismissPending()
    {
        _pendingResult = null;
        _pendingNewCount = 0;
    }

    private async Task SetDensity(FeedDensity density)
    {
        if (_density == density) return;
        _density = density;
        _focusedIndex = -1;
        if (!string.IsNullOrWhiteSpace(ViewParam)) SyncUrl(resetPage: false); // drop a now-stale ?view= override from the address
        try
        {
            if (_prefs is not null) await _prefs.InvokeVoidAsync("set", ContentUi.DensityStorageKey, ContentUi.DensityKey(density));
        }
        catch { /* storage blocked or circuit gone - the choice still applies for this visit */ }
    }


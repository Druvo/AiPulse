    private sealed record FilterChip(string Label, EventCallback Clear);

    /// <summary>Everything narrowing the list beyond the Unread/New/... tab, as removable chips - so the sticky bar always says why the list looks the way it does.</summary>
    private List<FilterChip> ActiveFilters()
    {
        var chips = new List<FilterChip>();
        EventCallback Do(Action a) => EventCallback.Factory.Create(this, a);

        if (!string.IsNullOrWhiteSpace(_search)) chips.Add(new($"“{_search.Trim()}”", Do(() => { _search = ""; _page = 1; })));
        if (!string.IsNullOrEmpty(_tag)) chips.Add(new($"#{_tag}", Do(() => SetTag(""))));
        if (_dateFrom is not null && _dateTo is not null)
            chips.Add(new(_dateFrom == _dateTo ? $"{_dateFrom.Value:MMM d}" : $"{_dateFrom.Value:MMM d} – {_dateTo.Value:MMM d}", Do(ClearDate)));
        if (!string.IsNullOrEmpty(_category)) chips.Add(new(_category, Do(() => { _category = ""; SyncUrl(); })));
        if (!string.IsNullOrEmpty(_contentType)) chips.Add(new(_contentType, Do(() => { _contentType = ""; SyncUrl(); })));
        if (!string.IsNullOrEmpty(_level)) chips.Add(new(_level, Do(() => { _level = ""; SyncUrl(); })));
        if (_sources.Count is > 0 and <= 3)
            foreach (var src in _sources.OrderBy(s => s, StringComparer.OrdinalIgnoreCase).ToList())
                chips.Add(new(src, Do(() => ToggleSource(src))));
        else if (_sources.Count > 3)
            chips.Add(new($"{_sources.Count} sources", Do(ClearSources)));
        if (_sort != "newest")
            chips.Add(new(_sort switch { "oldest" => "Oldest first", "source" => "Source A-Z", _ => "Title A-Z" }, Do(() => { _sort = "newest"; SyncUrl(); })));
        return chips;
    }

    /// <summary>How many filters set inside the (collapsible) filter panel are on - shown on the Filters button so a closed panel never hides an active filter.</summary>
    private int PanelFilterCount() =>
        (string.IsNullOrEmpty(_category) ? 0 : 1) + (string.IsNullOrEmpty(_contentType) ? 0 : 1) + (string.IsNullOrEmpty(_level) ? 0 : 1) +
        (_sources.Count > 0 ? 1 : 0) + (string.IsNullOrEmpty(_tag) ? 0 : 1) + (_dateFrom is null ? 0 : 1) + (_sort != "newest" ? 1 : 0);
    private void SetFilter(string filter) { _filter = filter; SyncUrl(); }
    private void SetTag(string tag) { _tag = tag; SyncUrl(); }
    private void ClearDate() { _dateFrom = null; _dateTo = null; SyncUrl(); }

    private void SetDateRange(DateOnly start, DateOnly end) { _dateFrom = start; _dateTo = end; SyncUrl(); }
    private void OnCalendarRangeChanged((DateOnly Start, DateOnly End) range) => SetDateRange(range.Start, range.End);

    private void ToggleSource(string source)
    {
        if (!_sources.Remove(source))
            _sources.Add(source);
        SyncUrl();
    }

    private void ClearSources() { _sources.Clear(); SyncUrl(); }

    /// <summary>Reflects the current filter/view state into the URL so a refresh (or a shared link) lands back in the same place.</summary>
    private void SyncUrl() => SyncUrl(resetPage: true);

    private void SyncUrl(bool resetPage)
    {
        if (resetPage) _page = 1; // any filter/sort change invalidates the current page

        // Density is a per-browser preference now (feed-prefs.js), not part of the address.
        var query = new List<string>();
        if (_filter != "Unread") query.Add($"filter={Uri.EscapeDataString(_filter)}");
        if (!string.IsNullOrEmpty(_tag)) query.Add($"tag={Uri.EscapeDataString(_tag)}");
        if (_dateFrom is not null && _dateTo is not null)
        {
            if (_dateFrom == _dateTo) query.Add($"date={_dateFrom:yyyy-MM-dd}");
            else query.Add($"dateFrom={_dateFrom:yyyy-MM-dd}&dateTo={_dateTo:yyyy-MM-dd}");
        }
        if (!string.IsNullOrEmpty(_category)) query.Add($"category={Uri.EscapeDataString(_category)}");
        if (!string.IsNullOrEmpty(_contentType)) query.Add($"contentType={Uri.EscapeDataString(_contentType)}");
        if (!string.IsNullOrEmpty(_level)) query.Add($"level={Uri.EscapeDataString(_level)}");
        if (_sources.Count > 0) query.Add($"source={string.Join(",", _sources.Select(Uri.EscapeDataString))}");
        if (_sort != "newest") query.Add($"sort={_sort}");
        var qs = query.Count > 0 ? "?" + string.Join("&", query) : "";
        Nav.NavigateTo($"news{qs}", replace: true);
    }

    private async Task Load(bool force)
    {
        _loading = true;
        _loadError = null;
        try
        {
            BufferOrApply(await Feeds.GetAsync(force));
        }
        catch (Exception ex)
        {
            // Fire-and-forget from OnInitialized: without a catch the failure vanished and the page sat on "saved history" with no clue why.
            Log.LogWarning(ex, "Loading the feed failed");
            _loadError = "Couldn't fetch the latest items just now. You're seeing saved history.";
        }
        finally
        {
            _loading = false;
            StateHasChanged(); // Load() is fire-and-forget from OnInitialized(), so this is what tells the circuit to push the finished state.
        }
    }

    private bool _savingSearch;
    private string _savedSearchName = "";

    private bool HasSaveableFilters() =>
        !string.IsNullOrWhiteSpace(_search) || !string.IsNullOrEmpty(_tag) || !string.IsNullOrEmpty(_category) || !string.IsNullOrEmpty(_contentType) ||
        !string.IsNullOrEmpty(_level) || _sources.Count > 0 || (_dateFrom is not null && _dateTo is not null);

    private void SaveCurrentSearch()
    {
        if (string.IsNullOrWhiteSpace(_savedSearchName)) return;

        // Only capture the date range as a reusable relative window when it trails up to today (e.g. "last
        // 7 days") - an arbitrary fixed historical range wouldn't mean the same thing next time this is applied.
        int? windowDays = null;
        if (_dateFrom is not null && _dateTo is not null && _dateTo == DateOnly.FromDateTime(DateTime.Today))
            windowDays = _dateTo.Value.DayNumber - _dateFrom.Value.DayNumber + 1;

        Reading.AddSavedSearch(new SavedSearch
        {
            Name = _savedSearchName.Trim(),
            Search = _search,
            Tag = _tag,
            Category = _category,
            ContentType = _contentType,
            Level = _level,
            Sources = _sources.ToList(),
            Sort = _sort,
            DateWindowDays = windowDays
        });

        _savingSearch = false;
        _savedSearchName = "";
    }

    private void ApplySavedSearch(SavedSearch saved)
    {
        _search = saved.Search;
        _tag = saved.Tag;
        _category = saved.Category;
        _contentType = saved.ContentType;
        _level = saved.Level;
        _sources = new HashSet<string>(saved.Sources, StringComparer.OrdinalIgnoreCase);
        _sort = saved.Sort;

        if (saved.DateWindowDays is { } days)
        {
            _dateTo = DateOnly.FromDateTime(DateTime.Today);
            _dateFrom = _dateTo.Value.AddDays(-(days - 1));
        }
        else
        {
            _dateFrom = null;
            _dateTo = null;
        }

        SyncUrl();
    }

    private static string SavedSearchSummary(SavedSearch s)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(s.Search)) parts.Add($"\"{s.Search}\"");
        if (!string.IsNullOrEmpty(s.Tag)) parts.Add($"tag: {s.Tag}");
        if (!string.IsNullOrEmpty(s.Category)) parts.Add(s.Category);
        if (!string.IsNullOrEmpty(s.ContentType)) parts.Add(s.ContentType);
        if (!string.IsNullOrEmpty(s.Level)) parts.Add(s.Level);
        if (s.Sources.Count > 0) parts.Add($"{s.Sources.Count} source(s)");
        if (s.DateWindowDays is { } d) parts.Add(d == 1 ? "today" : $"last {d} days");
        return parts.Count > 0 ? string.Join(" · ", parts) : "No filters";
    }

    private List<string> AvailableTags() =>
        _result?.Items.SelectMany(i => i.Tags).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(t => t).ToList() ?? new();

    /// <summary>
    /// The configured (enabled) source list, not "sources seen in the current item snapshot" - the latter
    /// used to grow/shrink/reorder visibly as progressive loading streamed in more items and the preload
    /// placeholder swapped for the live result, making the chip list look like it was constantly changing.
    /// The full source list is stable regardless of fetch progress.
    /// </summary>
    private List<string> AvailableSources() =>
        Kb.Sources.Where(s => s.Enabled).Select(s => s.Name).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();

    /// <summary>Narrows the (potentially 100+ entry) source chip list by name as the admin types - the list itself stays the stable AvailableSources() set, this is just what's rendered.</summary>
    private List<string> FilteredSources()
    {
        var all = AvailableSources();
        return string.IsNullOrWhiteSpace(_sourceSearch)
            ? all
            : all.Where(s => s.Contains(_sourceSearch.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    }

    /// <summary>What the feed can ever show before any tab/search refinement - shared by Filtered() and the "New" tab badge so the badge can't count items (releases, muted sources, exclude-filter hits) that the tab itself hides.</summary>
    private IEnumerable<FeedItem> VisibleBase()
    {
        if (_result is null) return Enumerable.Empty<FeedItem>();
        IEnumerable<FeedItem> q = _result.Items;

        // GitHub release items now live on Explore's GitHub Trending tab instead of the News feed -
        // it already has a dedicated trending-repos section, so a separate release stream here was
        // redundant noise for the same ecosystem.
        q = q.Where(i => i.ContentType != "Release");

        if (Reading.ExcludeFilters.Count > 0)
            q = q.Where(i => !Reading.IsExcluded(i.Title + " " + i.Summary));

        if (Reading.MutedSources.Count > 0)
            q = q.Where(i => !Reading.IsSourceMuted(i.SourceName));

        return q;
    }

    private int NewCount() => VisibleBase().Count(i => i.Published > _sinceVisit);

    private bool IsNewItem(FeedItem item) => _userId is not null && item.Published > _sinceVisit;

    private List<FeedItem> Filtered()
    {
        if (_result is null) return new();
        var q = VisibleBase();

        q = _filter switch
        {
            "New" => q.Where(i => i.Published > _sinceVisit),
            "Unread" => q.Where(i => !Reading.IsRead(i.Link)),
            "Read" => q.Where(i => Reading.IsRead(i.Link)),
            "Following" => q.Where(i => _followedSources.Contains(i.SourceName) || i.Tags.Any(t => _followedTags.Contains(t))),
            _ => q
        };

        if (!string.IsNullOrEmpty(_category))
            q = q.Where(i => i.Category == _category);

        if (!string.IsNullOrEmpty(_contentType))
            q = q.Where(i => i.ContentType == _contentType);

        if (!string.IsNullOrEmpty(_level))
            q = q.Where(i => i.Level == _level);

        if (_sources.Count > 0)
            q = q.Where(i => _sources.Contains(i.SourceName));

        if (!string.IsNullOrEmpty(_tag))
            q = q.Where(i => i.Tags.Contains(_tag, StringComparer.OrdinalIgnoreCase));

        if (_dateFrom is not null && _dateTo is not null)
            q = q.Where(i =>
            {
                var d = DateOnly.FromDateTime(i.Published.LocalDateTime);
                return d >= _dateFrom.Value && d <= _dateTo.Value;
            });

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim();
            q = q.Where(i =>
                i.Title.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                i.Summary.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                i.SourceName.Contains(s, StringComparison.OrdinalIgnoreCase));
        }

        q = _sort switch
        {
            "oldest" => q.OrderBy(i => i.Published),
            "source" => q.OrderBy(i => i.SourceName, StringComparer.OrdinalIgnoreCase).ThenByDescending(i => i.Published),
            "title" => q.OrderBy(i => i.Title, StringComparer.OrdinalIgnoreCase),
            _ => q.OrderByDescending(i => i.Published),
        };

        return q.ToList();
    }

    private (List<FeedItem> PageItems, int Total) GetPage()
    {
        var filtered = Filtered();

        // Marking items read (or muting a source) on the Unread tab shrinks the list under the user's feet;
        // without this, being on the last page when that happens left an out-of-range page: an empty grid
        // under a pager reading "Showing 3101-3054 of 3054".
        var lastPage = Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)_pageSize));
        if (_page > lastPage) _page = lastPage;

        var page = filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
        return (page, filtered.Count);
    }

    private readonly Dictionary<string, (string Text, bool IsError)> _summaries = new();
    private readonly HashSet<string> _summarizing = new();

    /// <summary>Summaries cost a model call, so only signed-in people get the button, and only when a language model is configured.</summary>
    private bool CanSummarize => Ai.SummariesEnabled && _userId is not null;

    private string? GetSummaryText(FeedItem item) => _summaries.TryGetValue(item.Link, out var s) ? s.Text : null;

    private bool IsSummaryError(FeedItem item) => _summaries.TryGetValue(item.Link, out var s) && s.IsError;

    private async Task SummarizeAsync(FeedItem item)
    {
        if (_userId is not { } uid || !_summarizing.Add(item.Link)) return;

        _summaries.Remove(item.Link);
        try
        {
            var result = await Ai.SummarizeItemAsync(item, $"user:{uid}");
            _summaries[item.Link] = result.Ok
                ? (result.Summary!.Text, false)
                : (result.Message ?? "Couldn't summarize this item.", true);
        }
        catch (Exception ex)
        {
            // An unhandled exception in an event handler ends the whole circuit; a failed summary must not.
            Log.LogWarning(ex, "Summarizing {Link} failed", item.Link);
            _summaries[item.Link] = ("Couldn't summarize this item right now.", true);
        }
        finally
        {
            _summarizing.Remove(item.Link);
        }
    }

    private void Toggle(FeedItem item) => Reading.ToggleBookmark(item);

    private void ToggleRead(FeedItem item) => Reading.ToggleRead(item);

    /// <summary>Opening an item (whole-card click or the title link) marks it read - unlike the explicit
    /// eye-icon toggle, this never flips an already-read item back to unread.</summary>
    private void MarkAsRead(FeedItem item) => Reading.EnsureRead(item);

    /// <summary>Marks every item in the current filter/search/sort view as read, not just the current page. Offers an Undo toast since this has no other confirmation step. Uses the bulk save-once methods - the naive per-item loop measured well over a minute against a ~9,000-item filtered view, blocking the whole circuit for that long.</summary>
    private void MarkAllAsRead()
    {
        var toMark = Filtered().Where(i => !Reading.IsRead(i.Link)).ToList();
        if (toMark.Count == 0) return;

        Reading.EnsureReadBulk(toMark);

        Toasts.ShowWithAction($"Marked {toMark.Count} item(s) as read", "Undo", async () =>
        {
            Reading.MarkUnreadBulk(toMark.Select(i => i.Link));
            await InvokeAsync(StateHasChanged);
        });
    }

    private void ClearAllFilters()
    {
        _search = "";
        _filter = "Unread";
        _category = "";
        _contentType = "";
        _level = "";
        _sources.Clear();
        _sourceSearch = "";
        _tag = "";
        _dateFrom = null;
        _dateTo = null;
        _sort = "newest";
        SyncUrl();
    }

    private void MuteSource(string sourceName) => Reading.ToggleMutedSource(sourceName);

    private void ToggleExpanded(string link)
    {
        if (!_expandedLinks.Add(link))
            _expandedLinks.Remove(link);
    }

    private void ToggleComments(string link)
    {
        if (!_expandedComments.Add(link))
            _expandedComments.Remove(link);
    }

    private int GetCommentCount(FeedItem item) => _commentCounts.GetValueOrDefault(item.Link);

    /// <summary>Fetches counts for the links on the page being rendered that haven't been asked about yet, as one
    /// batched query and one re-render. It used to be one query plus one full-page re-render per visible card -
    /// 100 of each on every page load, measured against the server log.</summary>
    private void RequestCommentCounts(List<FeedItem> items)
    {
        var missing = items.Select(i => i.Link).Where(_commentCountsRequested.Add).ToList();
        if (missing.Count > 0)
            _ = LoadCommentCountsAsync(missing);
    }

    private async Task LoadCommentCountsAsync(List<string> links)
    {
        var counts = await CommentsSvc.GetCommentCountsAsync(links);
        foreach (var link in links)
            _commentCounts[link] = counts.GetValueOrDefault(link);
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Reading.TouchNewsVisit(); // now that _sinceVisit is already committed to this render, safe to mark the visit
        _dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("aipulseKeyboard.register", _dotNetRef);

            _prefs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/feed-prefs.js");
            await _prefs.InvokeVoidAsync("trackStickyOffset");
            if (string.IsNullOrWhiteSpace(ViewParam) && await _prefs.InvokeAsync<string?>("get", ContentUi.DensityStorageKey) is { Length: > 0 } saved
                && ContentUi.ParseDensity(saved, _density) != _density)
            {
                _density = ContentUi.ParseDensity(saved, _density);
                StateHasChanged();
            }

            if (!_pageSizeChosen && await JS.InvokeAsync<bool>("aipulseKeyboard.isWideViewport"))
            {
                _pageSize = WidePageSize;
                StateHasChanged();
            }
        }
        catch { /* circuit may already be gone */ }
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _pageSizeChosen = true;
    }

    [JSInvokable]
    public async Task HandleKey(string key)
    {
        if (_visibleItems.Count == 0 && key is not ("?" or "Escape" or "r")) return;

        switch (key)
        {
            case "r":
                if (!_loading)
                    _ = Load(true);
                break;
            case "j":
                _focusedIndex = Math.Min(_focusedIndex + 1, _visibleItems.Count - 1);
                await JS.InvokeVoidAsync("aipulseKeyboard.scrollToFocused", _focusedIndex);
                break;
            case "k":
                _focusedIndex = _focusedIndex < 0 ? 0 : Math.Max(_focusedIndex - 1, 0);
                await JS.InvokeVoidAsync("aipulseKeyboard.scrollToFocused", _focusedIndex);
                break;
            case "o":
            case "Enter":
                if (_focusedIndex >= 0 && _focusedIndex < _visibleItems.Count)
                {
                    var opened = _visibleItems[_focusedIndex];
                    MarkAsRead(opened);
                    await JS.InvokeVoidAsync("aipulseKeyboard.openLink", opened.Link);
                }
                break;
            case "m":
                if (_focusedIndex >= 0 && _focusedIndex < _visibleItems.Count)
                    ToggleRead(_visibleItems[_focusedIndex]);
                break;
            case "b":
                if (_focusedIndex >= 0 && _focusedIndex < _visibleItems.Count)
                    Toggle(_visibleItems[_focusedIndex]);
                break;
            case "?":
                _showShortcutsHelp = !_showShortcutsHelp;
                break;
            case "Escape":
                _showShortcutsHelp = false;
                _showFilters = false;
                _focusedIndex = -1;
                break;
        }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        Feeds.PartialProgress -= OnPartialProgress;
        Feeds.CacheUpdated -= OnCacheUpdated;
        if (_prefs is not null)
        {
            try { await _prefs.DisposeAsync(); } catch { /* circuit may already be gone */ }
        }
        if (_dotNetRef is null) return;
        try { await JS.InvokeVoidAsync("aipulseKeyboard.unregister"); } catch { /* circuit may already be gone */ }
        _dotNetRef.Dispose();
    }
}

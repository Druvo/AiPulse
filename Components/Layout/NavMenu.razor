@using AiPulse.Models
@implements IDisposable
@inject FeedAggregatorService Feeds
@inject ReadingStateService Reading

@* The signed-in sidebar. One component, three presentations (all CSS, driven by attributes the early script in App.razor sets on <html>):
   - wide screens: a full sidebar with grouped sections;
   - wide screens, collapsed (data-sidebar="collapsed"): an icon rail, labels become tooltips but stay in the accessibility tree;
   - phones (< 768px): a slide-over drawer opened from the top bar or the bottom tab bar's "Menu" button (data-drawer="open").
   The links themselves come from ShellNav so the sidebar, drawer and bottom tab bar can never drift apart. *@

<div class="sidebar-head">
    <a class="sidebar-brand navbar-brand" href="dashboard" aria-label="AiPulse dashboard">
        <img src="/img/logo-v1.png" alt="" class="app-logo brand-logo" width="34" height="34" />
        <span class="sidebar-label">AiPulse</span>
    </a>
    <button type="button" class="sidebar-close icon-btn" data-shell="close-drawer" aria-label="Close menu">
        <Icon Name="x" Size="20" />
    </button>
</div>

<AuthorizeView>
    <nav class="sidebar-nav nav-scrollable" aria-label="Main">
        @foreach (var section in ShellNav.VisibleTo(context.User.IsInRole("Admin")))
        {
            <div class="nav-section" role="group" aria-labelledby="@($"nav-sec-{section.Title.ToLowerInvariant()}")">
                <div class="nav-section-label" id="@($"nav-sec-{section.Title.ToLowerInvariant()}")"><span class="sidebar-label">@section.Title</span></div>
                @foreach (var item in section.Items)
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="@item.Path" Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)" data-label="@item.Label">
                            <Icon Name="@item.Icon" Size="19" />
                            <span class="sidebar-label">@item.Label</span>
                            @if (item.Path == "news" && _unreadCount is > 0)
                            {
                                <span class="nav-count" title="@_unreadCount unread">@(_unreadCount > 99 ? "99+" : _unreadCount)<span class="visually-hidden"> unread</span></span>
                            }
                        </NavLink>
                    </div>
                }
            </div>
        }
    </nav>

    <div class="nav-footer">
        <a class="nav-user" href="@($"u/{context.User.Identity?.Name}")" data-label="View my profile">
            <span class="avatar" aria-hidden="true">@ShellNav.Initials(context.User.Identity?.Name)</span>
            <span class="nav-user__text sidebar-label">
                <strong>@context.User.Identity?.Name</strong>
                <small>@(context.User.IsInRole("Admin") ? "Admin" : "Member") · View profile</small>
            </span>
        </a>
        <div class="nav-footer__row">
            <button class="theme-toggle" type="button" onclick="toggleTheme()" title="Switch between light and dark theme" aria-label="Switch between light and dark theme">
                <Icon Name="moon" Size="17" CssClass="icon-light" />
                <Icon Name="sun" Size="17" CssClass="icon-dark" />
                <span class="sidebar-label">Theme</span>
            </button>
            <form method="post" action="/auth/logout" class="m-0">
                <button type="submit" class="logout-btn" title="Sign out" aria-label="Sign out">
                    <Icon Name="logout" Size="17" />
                    <span class="sidebar-label">Sign out</span>
                </button>
            </form>
        </div>
        <p class="nav-signature sidebar-label">
            Made with <span class="heart" aria-label="love">♥</span> by
            <a href="https://github.com/Druvo" target="_blank" rel="noopener">Druvo</a>
        </p>
    </div>
</AuthorizeView>

@code {
    private int? _unreadCount;

    /// <summary>
    /// Follows both things that change the count: a new poll result (the background watcher runs whether or not a page is open) and
    /// the person marking items read in this tab. Both arrive on other threads, so they hop onto the render thread first.
    /// </summary>
    protected override void OnInitialized()
    {
        Feeds.CacheUpdated += OnFeedsUpdated;
        Reading.ReadChanged += OnReadChanged;
    }

    protected override void OnParametersSet() => Recompute();

    private void OnFeedsUpdated(FeedResult _) => Refresh();

    private void OnReadChanged() => Refresh();

    private void Refresh() => _ = InvokeAsync(() =>
    {
        Recompute();
        StateHasChanged();
    });

    /// <summary>
    /// Same base pipeline as News.razor's Filtered() "Unread" tab (Release items excluded, muted sources/exclude-filters applied) minus the
    /// page's own search/category/tag refinements - "how many would show up if you opened News Feed right now with no extra filters".
    /// Uses PeekCache(), not GetAsync() - this component renders on every page, so it must never be what triggers a live poll across
    /// 100+ sources sharing a rate-limited host (can take minutes) just to draw a sidebar badge. No cached result yet this run -> no badge,
    /// until a poll finishes (which now updates it live).
    /// </summary>
    private void Recompute()
    {
        var result = Feeds.PeekCache();
        if (result is null) { _unreadCount = null; return; }

        IEnumerable<FeedItem> items = result.Items.Where(i => i.ContentType != "Release");
        if (Reading.ExcludeFilters.Count > 0)
            items = items.Where(i => !Reading.IsExcluded(i.Title + " " + i.Summary));
        if (Reading.MutedSources.Count > 0)
            items = items.Where(i => !Reading.IsSourceMuted(i.SourceName));
        _unreadCount = items.Count(i => !Reading.IsRead(i.Link));
    }

    public void Dispose()
    {
        Feeds.CacheUpdated -= OnFeedsUpdated;
        Reading.ReadChanged -= OnReadChanged;
    }
}

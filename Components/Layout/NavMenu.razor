                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="sources">
                        <Icon Name="database" />
                        <span>Sources</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="source-health">
                        <Icon Name="activity" />
                        <span>Source Health</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="users">

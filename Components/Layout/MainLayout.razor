@inherits LayoutComponentBase
@inject NavigationManager Nav

@* Most pages using this layout are still [Authorize]-gated and would just redirect a crawler - noindex
   by default. A handful of routes (News/Explore/Glossary/Tools) are public browsing now and should be
   indexable - decided here, in the layout itself, rather than via a page-level <HeadContent> override,
   because search engines combine (not replace) conflicting robots directives from multiple meta tags, so
   two <meta name="robots"> tags on the same rendered page would both apply rather than the page's one
   winning. Checking the route here means exactly one robots tag ever renders. *@
<HeadContent>
    @if (IsPublicPage)
    {
        <meta name="robots" content="index, follow" />
    }
    else
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <meta name="description" content="AiPulse — a standalone, self-hosted dashboard to keep developers current on the AI world: news, jargon, the right tool for the right task, and a structured learning roadmap. Runs with zero AI and no API keys." />
    <meta property="og:title" content="AiPulse — self-hosted AI news & learning dashboard" />
    <meta property="og:description" content="Aggregates ~39 AI/dev RSS sources with a curated glossary, tools matrix, and learning roadmap. Standalone, self-hosted, no API keys required." />
</HeadContent>

@code {
    private static readonly HashSet<string> PublicPaths = new(StringComparer.OrdinalIgnoreCase)
    {
        "/news", "/explore", "/glossary", "/tools"
    };

    private bool IsPublicPage
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            return PublicPaths.Contains(path) || path.StartsWith("/u/", StringComparison.OrdinalIgnoreCase);
        }
    }
}

@* An anonymous visitor on a public page (News/Explore/Glossary/Tools/a profile) should see a public
   site, not the internal dashboard shell - the full sidebar links to Dashboard/Learning Hub/Reading
   Stats/etc. that would just redirect them to /login, which reads as "broken internal tool", not
   "public site". Signed-in visitors still get the full dashboard sidebar as before. *@
<AuthorizeView>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4 gap-4">
                    <GlobalSearch />
                    <NotificationBell />
                    <a href="help"><Icon Name="help-circle" Size="16" /> Help</a>
                    <a href="settings"><Icon Name="settings" Size="16" /> Settings</a>
                    <a href="https://github.com/Druvo/AiPulse" target="_blank"><Icon Name="external-link" Size="16" /> About</a>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="page">
            <main class="w-100">
                <div class="top-row px-4 justify-content-between">
                    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                        <img src="/img/logo-v1.png" alt="AiPulse" class="app-logo brand-logo" />
                        <span>AiPulse</span>
                    </a>
                    <nav class="d-flex align-items-center gap-3">
                        <a href="news">News</a>
                        <a href="explore">Explore</a>
                        <a href="glossary">Glossary</a>
                        <a href="tools">Tools</a>
                        <a href="https://github.com/Druvo/AiPulse" target="_blank" rel="noopener">GitHub</a>
                    </nav>
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-sm btn-outline-dark" href="login">Sign in</a>
                        <a class="btn btn-sm btn-dark" href="register">Get started</a>
                    </div>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </NotAuthorized>
</AuthorizeView>

<button type="button" id="scroll-top-btn" class="scroll-top-btn" title="Back to top" aria-label="Back to top">
    <Icon Name="arrow-up" Size="18" />
</button>

<ToastHost />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="favicon.png" />
    @* description/og:title/og:description are set per-layout below (MainLayout vs. Login/Register's own
       HeadContent) rather than here, so a page-level override doesn't end up duplicating a static default -
       browsers/crawlers don't reliably pick one when the same meta name appears twice. *@
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="AiPulse.styles.css" />
    <meta name="theme-color" content="#faf9ff" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="AiPulse" />
    <link rel="alternate" type="application/atom+xml" title="AiPulse - latest AI news" href="feed.xml" />
    <HeadOutlet />
    <script>
        // Apply the saved theme/accent/custom-CSS immediately (avoids a flash of the wrong appearance).
        // localStorage can throw (blocked cookies, some private modes); a missing saved choice must never break the page.
        function savedTheme() { try { return localStorage.getItem('aipulse-theme'); } catch (e) { return null; } }
        function systemTheme() { return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
        function applyTheme() {
            // A choice the person made always wins; with none saved, follow the operating system (so dark-mode users get dark on first visit).
            var t = savedTheme() || systemTheme();
            document.documentElement.setAttribute('data-theme', t);
            var bar = document.querySelector('meta[name="theme-color"]');
            if (bar) bar.setAttribute('content', t === 'dark' ? '#0f0c1a' : '#faf9ff');
            var accent = null;
            try { accent = localStorage.getItem('aipulse-accent'); } catch (e) { }
            if (accent) document.documentElement.setAttribute('data-accent', accent);
            else document.documentElement.removeAttribute('data-accent');
            applyShell();
            try { applyCustomCss(); } catch (e) { }
            try { applyLogo(); } catch (e) { }
        }
        // Signed-in sidebar: expanded or collapsed to an icon rail. A saved choice wins; otherwise mid-size screens start as a rail so the
        // content keeps its room. Set on <html> before first paint (no layout jump) and re-applied after every enhanced navigation.
        function applyShell() {
            var s = null;
            try { s = localStorage.getItem('aipulse-sidebar'); } catch (e) { }
            if (!s) s = window.innerWidth < 1100 ? 'collapsed' : 'expanded';
            document.documentElement.setAttribute('data-sidebar', s);
            document.documentElement.removeAttribute('data-drawer');
            syncShellLabels();
        }
        function toggleSidebar() {
            var next = document.documentElement.getAttribute('data-sidebar') === 'collapsed' ? 'expanded' : 'collapsed';
            document.documentElement.setAttribute('data-sidebar', next);
            try { localStorage.setItem('aipulse-sidebar', next); } catch (e) { }
            syncShellLabels();
        }
        function syncShellLabels() {
            var collapsed = document.documentElement.getAttribute('data-sidebar') === 'collapsed';
            document.querySelectorAll('[data-shell="toggle-sidebar"]').forEach(function (b) {
                var t = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
                b.setAttribute('aria-label', t); b.setAttribute('title', t);
                b.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
            });
        }
        // Phone slide-over menu: open/close, Escape, focus moves into the drawer and back to the button that opened it.
        var drawerOpener = null;
        function setDrawer(open, opener) {
            var root = document.documentElement;
            if (open) { drawerOpener = opener || document.activeElement; root.setAttribute('data-drawer', 'open'); }
            else root.removeAttribute('data-drawer');
            document.querySelectorAll('[data-shell="open-drawer"]').forEach(function (b) { b.setAttribute('aria-expanded', open ? 'true' : 'false'); });
            if (open) {
                var close = document.querySelector('.app-sidebar .sidebar-close');
                if (close) setTimeout(function () { close.focus(); }, 30);
            } else if (drawerOpener && drawerOpener.focus) {
                try { drawerOpener.focus(); } catch (e) { }
                drawerOpener = null;
            }
        }
        document.addEventListener('click', function (e) {
            var t = e.target.closest ? e.target.closest('[data-shell]') : null;
            if (t) {
                var a = t.getAttribute('data-shell');
                if (a === 'open-drawer') { e.preventDefault(); setDrawer(true, t); }
                else if (a === 'close-drawer') { e.preventDefault(); setDrawer(false); }
                else if (a === 'toggle-sidebar') { e.preventDefault(); toggleSidebar(); }
            } else if (document.documentElement.getAttribute('data-drawer') === 'open' && e.target.closest && e.target.closest('.app-sidebar a[href]')) {
                document.documentElement.removeAttribute('data-drawer');
            }
            // Dropdowns built on <details> (account menu, public menu): a click anywhere else closes them.
            document.querySelectorAll('details.user-menu[open], details.public-menu[open], details.landing-menu[open]').forEach(function (d) {
                if (!d.contains(e.target) || (e.target.closest && e.target.closest('a[href]'))) d.removeAttribute('open');
            });
            // Show/hide password buttons on the sign-in screens.
            var eye = e.target.closest ? e.target.closest('[data-reveal]') : null;
            if (eye) {
                var input = document.getElementById(eye.getAttribute('data-reveal'));
                if (input) {
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    eye.setAttribute('aria-pressed', show ? 'true' : 'false');
                    eye.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                }
            }
        });
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            if (document.documentElement.getAttribute('data-drawer') === 'open') setDrawer(false);
            document.querySelectorAll('details.user-menu[open], details.public-menu[open], details.landing-menu[open]').forEach(function (d) {
                d.removeAttribute('open');
                var s = d.querySelector('summary'); if (s) s.focus();
            });
        });
        // Collapsed icon rail: show each link's label as a tooltip. Positioned in JS (fixed) so the sidebar's scroll area cannot clip it;
        // the label text itself stays in the link for screen readers, so the tooltip is purely visual.
        var shellTip = null;
        function showShellTip(e) {
            if (document.documentElement.getAttribute('data-sidebar') !== 'collapsed' || window.innerWidth < 768) return;
            var el = e.target.closest ? e.target.closest('.app-sidebar [data-label]') : null;
            if (!el) return;
            if (!shellTip || !shellTip.isConnected) { shellTip = document.createElement('div'); shellTip.className = 'shell-tip'; shellTip.setAttribute('aria-hidden', 'true'); document.body.appendChild(shellTip); }
            var r = el.getBoundingClientRect();
            shellTip.textContent = el.getAttribute('data-label');
            shellTip.style.left = (r.right + 10) + 'px';
            shellTip.style.top = (r.top + r.height / 2) + 'px';
            shellTip.classList.add('show');
        }
        function hideShellTip() { if (shellTip) shellTip.classList.remove('show'); }
        document.addEventListener('mouseover', showShellTip);
        document.addEventListener('focusin', showShellTip);
        document.addEventListener('mouseout', hideShellTip);
        document.addEventListener('focusout', hideShellTip);
        document.addEventListener('scroll', hideShellTip, true);
        document.addEventListener('DOMContentLoaded', syncShellLabels);
        applyTheme();
        function applyLogo() {
            var logo = localStorage.getItem('aipulse-logo') || 'v1';
            document.querySelectorAll('.app-logo').forEach(function (img) {
                img.src = '/img/logo-' + logo + '.png';
            });
        }
        function setLogo(v) {
            localStorage.setItem('aipulse-logo', v);
            applyLogo();
        }
        function toggleTheme() {
            var cur = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', cur);
            try { localStorage.setItem('aipulse-theme', cur); } catch (e) { }
            var bar = document.querySelector('meta[name="theme-color"]');
            if (bar) bar.setAttribute('content', cur === 'dark' ? '#0f0c1a' : '#faf9ff');
        }
        // Until someone picks a theme, keep following the operating system if it flips (e.g. automatic dark at sunset).
        if (window.matchMedia) {
            var watcher = window.matchMedia('(prefers-color-scheme: dark)');
            var onSystemChange = function () { if (!savedTheme()) applyTheme(); };
            if (watcher.addEventListener) watcher.addEventListener('change', onSystemChange);
            else if (watcher.addListener) watcher.addListener(onSystemChange);
        }
        if (window.matchMedia) {
            // Leaving the phone layout with the drawer open must not leave the page scroll-locked behind an invisible scrim.
            var wide = window.matchMedia('(min-width: 768px)');
            var onWide = function () { if (wide.matches) document.documentElement.removeAttribute('data-drawer'); };
            if (wide.addEventListener) wide.addEventListener('change', onWide);
            else if (wide.addListener) wide.addListener(onWide);
        }
        function setAccent(name) {
            if (name) { document.documentElement.setAttribute('data-accent', name); localStorage.setItem('aipulse-accent', name); }
            else { document.documentElement.removeAttribute('data-accent'); localStorage.removeItem('aipulse-accent'); }
        }
        function applyCustomCss() {
            var css = localStorage.getItem('aipulse-custom-css') || '';
            var el = document.getElementById('aipulse-custom-css');
            if (!el) {
                el = document.createElement('style');
                el.id = 'aipulse-custom-css';
                document.head.appendChild(el);
            }
            el.textContent = css;
        }
        function setCustomCss(css) {
            localStorage.setItem('aipulse-custom-css', css || '');
            applyCustomCss();
        }
    </script>
</head>

<body>
    <div id="nav-progress"></div>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        // Blazor's enhanced navigation re-syncs the document to the server's rendered HTML on every
        // internal link click, and the server never renders data-theme (it's client-only state) - so
        // without reapplying it on 'enhancedload', the theme resets on every navigation. This must be
        // registered via Blazor.addEventListener (not document.addEventListener - that's a different,
        // never-fired event), and only after blazor.web.js has defined the global Blazor object.
        Blazor.addEventListener('enhancedload', applyTheme);

        // Enhanced navigation swaps the DOM in place with no browser tab spinner, so a multi-second
        // navigation (e.g. Explore's live API fetches) can look frozen. Fake an nprogress-style bar:
        // start creeping toward 90% the instant an internal link/nav-item is clicked, snap to 100% and
        // fade out on 'enhancedload'. Falls back gracefully if a click doesn't trigger a navigation.
        (function () {
            var bar = document.getElementById('nav-progress');
            var creepTimer = null;
            var hideTimer = null;

            function start() {
                clearTimeout(hideTimer);
                clearInterval(creepTimer);
                bar.style.transition = 'none';
                bar.style.opacity = '1';
                bar.style.width = '0%';
                // force reflow so the width:0 takes effect before animating
                void bar.offsetWidth;
                bar.style.transition = 'width 0.4s ease-out';
                bar.style.width = '30%';
                var pct = 30;
                creepTimer = setInterval(function () {
                    pct += (90 - pct) * 0.1;
                    bar.style.width = Math.min(pct, 90) + '%';
                }, 300);
            }

            function done() {
                clearInterval(creepTimer);
                bar.style.transition = 'width 0.2s ease-out';
                bar.style.width = '100%';
                hideTimer = setTimeout(function () {
                    bar.style.transition = 'opacity 0.3s ease-out';
                    bar.style.opacity = '0';
                }, 200);
            }

            document.addEventListener('click', function (e) {
                var a = e.target.closest('a[href]');
                if (!a) return;
                if (a.target === '_blank' || a.hasAttribute('download')) return;
                if (a.origin !== location.origin) return;
                if (a.getAttribute('href')?.startsWith('#')) return;
                start();
            }, true);

            window.addEventListener('popstate', start);
            Blazor.addEventListener('enhancedload', done);
        })();
    </script>
    <script>
        // Ctrl/Cmd+K opens the global search - just forward to its trigger button, no JS interop needed.
        document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                var btn = document.getElementById('global-search-trigger');
                if (btn) { e.preventDefault(); btn.click(); }
            }
        });
    </script>
    <script src="js/notify.js"></script>
    <script src="js/playground.js"></script>
    <script src="js/keyboard.js"></script>
    <script src="js/scrollTop.js"></script>
    <script src="js/clerk-login.js"></script>
    <script>
        // Makes the site installable ("Add to home screen") and gives a friendly page when offline. Needs https or localhost.
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () { navigator.serviceWorker.register('sw.js').catch(function () { }); });
        }
    </script>
</body>

</html>

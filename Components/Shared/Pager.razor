@* Generic pagination control - "showing X-Y of Z" + page-size selector + numbered pages with prev/next. *@

<nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 my-3 pager" aria-label="Pagination">
    <div class="text-muted small" aria-live="polite">
        @if (TotalItems == 0)
        {
            <span>No results.</span>
        }
        else
        {
            <span>Showing <strong class="text-body tabular-nums">@RangeStart–@RangeEnd</strong> of <span class="tabular-nums">@TotalItems</span></span>
        }
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <label class="visually-hidden" for="@_sizeId">Rows per page</label>
        <select id="@_sizeId" class="form-select form-select-sm pager__size" value="@PageSize" @onchange="OnPageSizeChanged">
            @foreach (var size in PageSizeOptions)
            {
                <option value="@size">@size / page</option>
            }
        </select>
        <div class="pager__pages">
            <button type="button" class="pager__btn" disabled="@(CurrentPage <= 1)" @onclick="() => GoTo(CurrentPage - 1)" aria-label="Previous page"><Icon Name="chevron-left" Size="16" /></button>
            @foreach (var p in PagerWindow.Pages(CurrentPage, TotalPages))
            {
                if (p == PagerWindow.Gap)
                {
                    <span class="pager__gap" aria-hidden="true">…</span>
                }
                else
                {
                    var pageNo = p;
                    <button type="button" class="pager__btn" aria-current="@(pageNo == CurrentPage ? "page" : null)" aria-label="@($"Page {pageNo}")" @onclick="() => GoTo(pageNo)">@pageNo</button>
                }
            }
            <button type="button" class="pager__btn" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoTo(CurrentPage + 1)" aria-label="Next page"><Icon Name="chevron-right" Size="16" /></button>
        </div>
    </div>
</nav>

@code {
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public int[] PageSizeOptions { get; set; } = { 10, 20, 50, 100 };

    private readonly string _sizeId = $"pager-size-{Guid.NewGuid():N}";
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)PageSize));
    private int RangeStart => TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int RangeEnd => Math.Min(CurrentPage * PageSize, TotalItems);

    private async Task GoTo(int target)
    {
        target = Math.Clamp(target, 1, TotalPages);
        if (target == CurrentPage) return;
        CurrentPage = target;
        await CurrentPageChanged.InvokeAsync(target);
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size)) return;
        PageSize = size;
        await PageSizeChanged.InvokeAsync(size);
        await GoTo(1);
    }
}

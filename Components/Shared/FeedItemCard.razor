@* Shared card for rendering a single FeedItem - used by News, Reading Stats, Explore and the Dashboard so every post carries the
   same source identity (favicon over a colored-initial fallback, or the source's own brand color where it declares one), image,
   "new" treatment and actions wherever it appears. Three layouts: "List" (comfortable rows, image left), "Grid" (image on top)
   and "Compact" (headline rows). Styles live in FeedItemCard.razor.css. *@
@using AiPulse.Models
@inject FaviconService Favicons
@inject KnowledgeBaseService Kb
@inject IJSRuntime JS

<article class="fc fc--@_layoutKey @(IsRead ? "is-read" : "") @(WatchedKeyword is not null ? "is-watched" : "") @(_menuOpen ? "menu-open" : "") @CssClass"
         style="--card-accent: @_accentColor" @onclick="OpenItem">
    @if (ShowMedia)
    {
        <div class="fc-media @(HasImage ? "" : "fc-media--empty")" aria-hidden="true">
            <span class="fc-mark" style="--avatar-color: @_accentColor">
                <span class="fc-mark-initial">@Initial(Item.SourceName)</span>
                @if (_host is not null)
                {
                    <img class="fc-mark-favicon" src="/favicon-proxy/@_host" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" />
                }
            </span>
            @if (HasImage)
            {
                @* A broken image falls back to the placeholder underneath instead of collapsing the box, so nothing below it jumps. *@
                <img class="fc-media-img" src="@Item.ImageUrl" alt="" loading="lazy" decoding="async"
                     onerror="this.style.display='none';this.parentElement.classList.add('fc-media--empty')" />
            }
        </div>
    }
    <div class="fc-body">
        <div class="fc-meta">
            @if (!ShowMedia || Layout != "Compact")
            {
                <span class="fc-avatar" aria-hidden="true" style="--avatar-color: @_accentColor">
                    <span class="fc-avatar-initial">@Initial(Item.SourceName)</span>
                    @if (_host is not null)
                    {
                        <img src="/favicon-proxy/@_host" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" />
                    }
                </span>
            }
            <span class="fc-source">@Item.SourceName</span>
            @if (Item.AlsoSeenOn.Length > 0)
            {
                <span class="fc-also" title="Also covered by: @string.Join(", ", Item.AlsoSeenOn)">+@Item.AlsoSeenOn.Length</span>
            }
            <span aria-hidden="true">·</span>
            <time class="fc-time" datetime="@Item.Published.ToString("o")" title="@Item.Published.ToLocalTime().ToString("f")">@ContentUi.RelativeTime(Item.Published, DateTimeOffset.Now)</time>
            @if (Layout != "Compact" && Item.ReadingMinutes is { } minutes)
            {
                <span aria-hidden="true">·</span>
                <span class="fc-nowrap">@minutes min read</span>
            }
            @if (Layout == "List" && !string.IsNullOrWhiteSpace(Item.Author))
            {
                <span class="fc-author">by @Item.Author</span>
            }
        </div>

        <h3 class="fc-title">
            <a href="@Item.Link" target="_blank" rel="noopener" @onclick="NotifyOpened" @onclick:stopPropagation="true">
                @if (IsNew)
                {
                    <span class="fc-new" role="img" aria-label="New" title="New since your last visit"></span>
                }
                @if (IsRead)
                {
                    <span class="fc-read-check" role="img" aria-label="Read" title="Read"><Icon Name="check" Size="13" /></span>
                }
                @if (WatchedKeyword is not null)
                {
                    <span class="fc-watch" role="img" aria-label="Watchlist match" title="Watchlist: @WatchedKeyword"><Icon Name="star" Size="11" Filled="true" /></span>
                }
                @Item.Title
            </a>
        </h3>

        @if (Layout != "Compact" && !string.IsNullOrWhiteSpace(Item.Summary))
        {
            <p class="fc-summary">@Item.Summary</p>
        }

        @if (Layout != "Compact" && OnSummarize.HasDelegate)
        {
            @if (string.IsNullOrEmpty(AiSummary))
            {
                <button class="btn btn-sm btn-outline-primary fc-inline-btn" disabled="@AiSummaryBusy" @onclick="OnSummarize" @onclick:stopPropagation="true"
                        title="A short summary written by the language model from this item's own text">
                    @if (AiSummaryBusy) { <span class="spinner"></span> } else { <Icon Name="sparkle" Size="13" /> }
                    @(AiSummaryBusy ? "Summarizing…" : "Summarize")
                </button>
            }
            else
            {
                <div class="ai-summary @(AiSummaryIsError ? "ai-summary-error" : "") small" @onclick:stopPropagation="true">
                    @if (!AiSummaryIsError) { <span class="ai-summary-label"><Icon Name="sparkle" Size="11" /> AI summary</span> }
                    @AiSummary
                    @if (AiSummaryIsError)
                    {
                        <button class="btn btn-sm btn-link p-0 ms-1 align-baseline" @onclick="OnSummarize">Try again</button>
                    }
                </div>
            }
        }

        @if (Layout != "Compact" && ShowFullTextToggle && !string.IsNullOrWhiteSpace(Item.FullText))
        {
            <button class="btn btn-sm btn-outline-secondary fc-inline-btn" aria-expanded="@(Expanded ? "true" : "false")" @onclick="OnToggleExpanded" @onclick:stopPropagation="true">
                @(Expanded ? "Hide full text" : "Read full text")
            </button>
            @if (Expanded)
            {
                <p class="card-text small full-text-panel mb-0" @onclick:stopPropagation="true">@Item.FullText</p>
            }
        }

        @if (Layout != "Compact" && OnToggleComments.HasDelegate && CommentsExpanded)
        {
            <div @onclick:stopPropagation="true">
                <CommentThread ArticleLink="@Item.Link" OnCountChanged="OnCommentCountUpdated" />
            </div>
        }

        <div class="fc-foot">
            @if (Layout != "Compact")
            {
                <div class="fc-tags">
                    @if (Item.ContentType is { Length: > 0 } ct && ct != "News")
                    {
                        <span class="badge ctype-@ct.ToLowerInvariant()">@ct</span>
                    }
                    @if (Item.Level is "Beginner" or "Advanced")
                    {
                        <span class="badge level-@Item.Level.ToLowerInvariant()">@Item.Level</span>
                    }
                    @foreach (var t in Item.Tags.Take(Layout == "Grid" ? 3 : 4))
                    {
                        <a class="fc-tag" href="@($"news?tag={Uri.EscapeDataString(t)}")" @onclick:stopPropagation="true" title="Show stories tagged @t">#@t</a>
                    }
                </div>
            }
            <div class="fc-actions" @onclick:stopPropagation="true">
                @if (Layout != "Compact" && OnToggleComments.HasDelegate)
                {
                    <button type="button" class="fc-act fc-act--count @(CommentsExpanded ? "is-on" : "")" aria-expanded="@(CommentsExpanded ? "true" : "false")"
                            title="@CommentLabel" aria-label="@CommentLabel" @onclick="OnToggleComments">
                        <Icon Name="message" Size="17" />
                        @if (CommentCount > 0) { <span>@CommentCount</span> }
                    </button>
                }
                @if (OnToggleRead.HasDelegate)
                {
                    <button type="button" class="fc-act @(IsRead ? "is-on" : "")" aria-pressed="@(IsRead ? "true" : "false")"
                            title="@(IsRead ? "Mark unread" : "Mark read")" aria-label="@(IsRead ? "Mark unread" : "Mark read")" @onclick="OnToggleRead">
                        <Icon Name="@(IsRead ? "check" : "eye")" Size="17" />
                    </button>
                }
                @if (OnToggleBookmark.HasDelegate)
                {
                    <button type="button" class="fc-act @(IsBookmarked ? "is-on" : "")" aria-pressed="@(IsBookmarked ? "true" : "false")"
                            title="@(IsBookmarked ? "Remove bookmark" : "Save to read later")" aria-label="@(IsBookmarked ? "Remove bookmark" : "Save to read later")" @onclick="OnToggleBookmark">
                        <Icon Name="bookmark" Size="17" Filled="@IsBookmarked" />
                    </button>
                }
                <div class="fc-more">
                    <button type="button" class="fc-act" aria-haspopup="menu" aria-expanded="@(_menuOpen ? "true" : "false")" title="Share and more" aria-label="Share and more"
                            @onclick="() => _menuOpen = !_menuOpen">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="19" cy="12" r="1.8" /></svg>
                    </button>
                    @if (_menuOpen)
                    {
                        <div class="fc-scrim" @onclick="() => _menuOpen = false"></div>
                        <div class="fc-menu" role="menu" @onkeydown="OnMenuKey">
                            <a role="menuitem" href="@TwitterShareUrl()" target="_blank" rel="noopener" @onclick="() => _menuOpen = false"><Icon Name="share" Size="15" /> Share on X</a>
                            <a role="menuitem" href="@LinkedInShareUrl()" target="_blank" rel="noopener" @onclick="() => _menuOpen = false"><Icon Name="share" Size="15" /> Share on LinkedIn</a>
                            <a role="menuitem" href="@HackerNewsShareUrl()" target="_blank" rel="noopener" @onclick="() => _menuOpen = false"><Icon Name="external-link" Size="15" /> Submit to Hacker News</a>
                            @if (OnFollowSource.HasDelegate)
                            {
                                <button type="button" role="menuitem" @onclick="FollowSource">
                                    <Icon Name="star" Size="15" Filled="@IsFollowingSource" /> @(IsFollowingSource ? $"Unfollow {Item.SourceName}" : $"Follow {Item.SourceName}")
                                </button>
                            }
                            @if (OnMuteSource.HasDelegate)
                            {
                                <button type="button" role="menuitem" class="fc-menu-danger" @onclick="MuteSource">
                                    <Icon Name="eye-off" Size="15" /> Hide @Item.SourceName
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public FeedItem Item { get; set; } = null!;
    /// <summary>"List" (comfortable rows, image left, default), "Grid" (image on top, equal-height cards), or "Compact" (headline rows - no summary/tags/type badges).</summary>
    [Parameter] public string Layout { get; set; } = "List";
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public string? WatchedKeyword { get; set; }
    [Parameter] public bool IsRead { get; set; }
    [Parameter] public bool IsBookmarked { get; set; }
    [Parameter] public EventCallback OnToggleRead { get; set; }
    [Parameter] public EventCallback OnToggleBookmark { get; set; }
    /// <summary>Invoked whenever this item is opened (whole-card click or the title link itself) - callers use this to mark it read, separately from the explicit OnToggleRead button.</summary>
    [Parameter] public EventCallback OnOpened { get; set; }
    /// <summary>Optional - only News.razor wires this up. Invoked with the item's SourceName when the user asks to hide that source from their own feed.</summary>
    [Parameter] public EventCallback<string> OnMuteSource { get; set; }
    [Parameter] public bool IsFollowingSource { get; set; }
    /// <summary>Optional - only wired up for signed-in users (following requires an account). Invoked with the item's SourceName.</summary>
    [Parameter] public EventCallback<string> OnFollowSource { get; set; }
    /// <summary>Optional - only wired up by pages that show a comment thread (News, Bookmarks). A parent-tracked
    /// cache, since fetching a live count per card on every render would be one query per visible item.</summary>
    [Parameter] public int CommentCount { get; set; }
    [Parameter] public bool CommentsExpanded { get; set; }
    [Parameter] public EventCallback OnToggleComments { get; set; }
    /// <summary>Bubbles the post-mutation count up to whatever cache the caller keeps, in addition to this
    /// card's own immediate display update.</summary>
    [Parameter] public EventCallback<int> OnCommentCountChanged { get; set; }
    /// <summary>Optional - only wired up where the AI layer is on and the viewer is signed in. Asks for a short model-written summary of this item.</summary>
    [Parameter] public EventCallback OnSummarize { get; set; }
    [Parameter] public string? AiSummary { get; set; }
    [Parameter] public bool AiSummaryIsError { get; set; }
    [Parameter] public bool AiSummaryBusy { get; set; }
    [Parameter] public bool ShowFullTextToggle { get; set; }
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback OnToggleExpanded { get; set; }
    /// <summary>Extra classes for the root card element (e.g. keyboard-nav focus ring), which are page-specific concerns the card itself doesn't know about.</summary>
    [Parameter] public string? CssClass { get; set; }

    private string? _host;
    private string _accentColor = "";
    private bool _menuOpen;
    private string _layoutKey = "list";

    private string CommentLabel => CommentCount == 0 ? "Comment" : $"{CommentCount} comment{(CommentCount == 1 ? "" : "s")}";

    private bool HasImage => !string.IsNullOrWhiteSpace(Item.ImageUrl);
    /// <summary>Compact rows only spend space on a picture when there is a real one.</summary>
    private bool ShowMedia => Layout != "Compact" || HasImage;

    private async Task OpenItem()
    {
        if (_menuOpen) { _menuOpen = false; return; }
        await NotifyOpened();
        await JS.InvokeVoidAsync("aipulseKeyboard.openLink", Item.Link);
    }

    private async Task NotifyOpened()
    {
        if (OnOpened.HasDelegate) await OnOpened.InvokeAsync();
    }

    private async Task FollowSource()
    {
        _menuOpen = false;
        await OnFollowSource.InvokeAsync(Item.SourceName);
    }

    private async Task MuteSource()
    {
        _menuOpen = false;
        await OnMuteSource.InvokeAsync(Item.SourceName);
    }

    private void OnMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _menuOpen = false;
    }

    private async Task OnCommentCountUpdated(int newCount)
    {
        CommentCount = newCount;
        if (OnCommentCountChanged.HasDelegate) await OnCommentCountChanged.InvokeAsync(newCount);
    }

    private string TwitterShareUrl() => $"https://twitter.com/intent/tweet?text={Uri.EscapeDataString(Item.Title)}&url={Uri.EscapeDataString(Item.Link)}";
    private string LinkedInShareUrl() => $"https://www.linkedin.com/sharing/share-offsite/?url={Uri.EscapeDataString(Item.Link)}";
    private string HackerNewsShareUrl() => $"https://news.ycombinator.com/submitlink?u={Uri.EscapeDataString(Item.Link)}&t={Uri.EscapeDataString(Item.Title)}";

    protected override void OnParametersSet()
    {
        _layoutKey = Layout switch { "Grid" => "grid", "Compact" => "compact", _ => "list" };
        _host = Kb.SourceHostFor(Item.SourceName);
        _accentColor = AvatarColor(Item.SourceName);

        if (_host is null) return;
        Favicons.EnsureThemeColorFetchStarted(_host);
        if (Favicons.TryGetCachedThemeColor(_host, out var themeColor) && !string.IsNullOrWhiteSpace(themeColor))
            _accentColor = themeColor;
    }

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : char.ToUpperInvariant(name.Trim()[0]).ToString();

    /// <summary>Deterministic per-source color (hash the name to a hue) so every source has a consistent identity even before its favicon/theme-color loads (or when a site declares neither).</summary>
    private static string AvatarColor(string name)
    {
        var hash = 0;
        foreach (var ch in name)
            hash = (hash * 31 + ch) & 0x7fffffff;
        return $"hsl({hash % 360}, 58%, 42%)";
    }
}

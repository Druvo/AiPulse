@* Top tags and most active sources over the last DaysWindow days, as links into the News feed. Tags read as a small weighted
   cloud; sources as bars, so "who's loudest" is visible at a glance. *@

<section class="card h-100 tp">
    <div class="card-body">
        <h2 class="tp-title"><Icon Name="trending-up" Size="18" /> Trending @WindowLabel</h2>
        @{
            var tags = TopTags;
            var sources = TopSources;
        }
        @if (tags.Count == 0 && sources.Count == 0)
        {
            <div class="tp-empty"><Icon Name="trending-up" Size="20" /> Not enough stories @WindowLabel to call a trend yet.</div>
        }
        else
        {
            @if (tags.Count > 0)
            {
                var top = tags[0].Count;
                <div class="tp-tags">
                    @foreach (var (tag, count) in tags)
                    {
                        <a class="tp-tag tp-tier-@ContentUi.TopicTier(count, top)" href="@($"news?tag={Uri.EscapeDataString(tag)}&filter=All")" title="@count stories tagged @tag">
                            #@tag <span class="tp-tag-count">@count</span>
                        </a>
                    }
                </div>
            }
            @if (sources.Count > 0)
            {
                var topSource = sources[0].Count;
                <h3 class="tp-sub">Most active sources</h3>
                <ol class="tp-sources">
                    @foreach (var (source, count) in sources)
                    {
                        <li>
                            <a href="@($"news?source={Uri.EscapeDataString(source)}&filter=All")">
                                <span class="tp-source-name">@source</span>
                                <span class="tp-source-count">@count</span>
                                <span class="tp-bar" aria-hidden="true"><span style="width: @(Math.Max(4, count * 100 / topSource))%"></span></span>
                            </a>
                        </li>
                    }
                </ol>
            }
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<FeedItem> Items { get; set; } = Array.Empty<FeedItem>();

    /// <summary>How many trailing days to look back over. Default 7 (matches the original "this week" behavior).</summary>
    [Parameter]
    public int DaysWindow { get; set; } = 7;

    private string WindowLabel => DaysWindow switch
    {
        <= 1 => "today",
        <= 7 => "this week",
        _ => "this month"
    };

    private List<(string Tag, int Count)> TopTags => Items
        .Where(i => i.Published >= DateTimeOffset.Now.AddDays(-DaysWindow))
        .SelectMany(i => i.Tags)
        .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(g => g.Count())
        .Take(16)
        .Select(g => (g.Key, g.Count()))
        .ToList();

    private List<(string Source, int Count)> TopSources => Items
        .Where(i => i.Published >= DateTimeOffset.Now.AddDays(-DaysWindow))
        .GroupBy(i => i.SourceName)
        .OrderByDescending(g => g.Count())
        .Take(6)
        .Select(g => (g.Key, g.Count()))
        .ToList();
}

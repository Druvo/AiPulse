@* Strength hint under a new-password field (see PasswordStrength for the scoring). Purely advisory: the server's own rule decides. *@
@{
    var result = PasswordStrength.Evaluate(Password);
}
<div class="strength" id="@Id" data-score="@result.Score" aria-live="polite">
    <div class="strength__bars" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <span class="strength__label">@(result.Score == 0 ? $"At least {PasswordStrength.MinLength} characters; a longer passphrase beats symbols." : result.Label)</span>
</div>

@code {
    [Parameter] public string? Password { get; set; }
    [Parameter] public string? Id { get; set; }
}

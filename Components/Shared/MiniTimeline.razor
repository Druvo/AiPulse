@* Activity heatmap card for the Dashboard; click a day to jump into News filtered to it. *@

<section class="card h-100 mt-card">
    <div class="card-body">
        <div class="mt-head">
            <h2 class="mt-title"><Icon Name="calendar" Size="18" /> Activity</h2>
            <span class="mt-note">Stories collected per day</span>
        </div>
        <ActivityHeatmap Items="Items" MaxDays="MaxDays" />
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<FeedItem> Items { get; set; } = Array.Empty<FeedItem>();

    [Parameter]
    public int MaxDays { get; set; } = 90;
}

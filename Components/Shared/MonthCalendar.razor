@* Obsidian-style month calendar: click a day to select it, shift-click to extend into a range. Days are real buttons (keyboard and
   screen-reader reachable), shaded by how many items they hold. Styles in MonthCalendar.razor.css. *@

@{
    var monthStart = _displayMonth;
    var counts = CountsOverride ?? _itemCounts;
    var max = counts.Count > 0 ? counts.Values.Max() : 0;
    var today = DateOnly.FromDateTime(DateTime.Today);

    var gridStart = monthStart.AddDays(-(int)monthStart.DayOfWeek);
    var totalCells = 42; // always 6 full weeks, so the grid height doesn't jump between months
}

<div class="mc">
    <div class="mc-head">
        <button type="button" class="mc-nav" @onclick="PrevMonth" title="Previous month" aria-label="Previous month">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
        </button>
        <span class="mc-title" aria-live="polite">@monthStart.ToString("MMMM yyyy")</span>
        <button type="button" class="mc-nav" @onclick="NextMonth" title="Next month" aria-label="Next month">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </button>
        <button type="button" class="mc-today" @onclick="GoToday">Today</button>
    </div>
    <div class="mc-grid" role="group" aria-label="@monthStart.ToString("MMMM yyyy")">
        @foreach (var wd in new[] { "Su", "Mo", "Tu", "We", "Th", "Fr", "Sa" })
        {
            <div class="mc-weekday" aria-hidden="true">@wd</div>
        }
        @for (var i = 0; i < totalCells; i++)
        {
            var day = gridStart.AddDays(i);
            var inMonth = day.Month == monthStart.Month;
            var count = counts.GetValueOrDefault(day);
            var level = inMonth ? ContentUi.HeatLevel(count, max) : 0;
            var selected = RangeStart is not null && RangeEnd is not null && day >= RangeStart.Value && day <= RangeEnd.Value;
            var isToday = day == today;
            var capturedDay = day;
            var label = $"{day:dddd, MMMM d}: {(count == 0 ? "no items" : count == 1 ? "1 item" : $"{count:N0} items")}";
            <button type="button" class="mc-cell mc-l@(level) @(inMonth ? "" : "mc-outside") @(selected ? "is-selected" : "") @(isToday ? "is-today" : "")"
                    title="@label" aria-label="@label" aria-pressed="@(selected ? "true" : "false")"
                    @onclick="@(e => DayClicked(capturedDay, e))">
                @day.Day
            </button>
        }
    </div>
    <p class="mc-hint">
        @if (RangeStart is not null)
        {
            @if (RangeEnd is not null && RangeEnd != RangeStart)
            {
                <text>@RangeStart.Value.ToString("MMM d") – @RangeEnd.Value.ToString("MMM d, yyyy")</text>
            }
            else
            {
                <text>@RangeStart.Value.ToString("MMM d, yyyy")</text>
            }
            <text> selected · shift-click another day for a range</text>
        }
        else
        {
            <text>Pick a day to filter · shift-click a second day for a range</text>
        }
    </p>
</div>

@code {
    [Parameter]
    public IReadOnlyList<FeedItem> Items { get; set; } = Array.Empty<FeedItem>();

    /// <summary>Pre-computed day->count map, for callers whose data isn't a FeedItem list (e.g. GitHub Trending snapshots by date). Takes priority over <see cref="Items"/> when set.</summary>
    [Parameter]
    public IReadOnlyDictionary<DateOnly, int>? CountsOverride { get; set; }

    [Parameter]
    public DateOnly? RangeStart { get; set; }

    [Parameter]
    public DateOnly? RangeEnd { get; set; }

    [Parameter]
    public EventCallback<(DateOnly Start, DateOnly End)> OnRangeChanged { get; set; }

    private DateOnly _displayMonth = DateOnly.FromDateTime(DateTime.Today).AddDays(1 - DateTime.Today.Day);
    private bool _initialized;

    private IReadOnlyList<FeedItem>? _countedItems;
    private int _countedItemsLength = -1;
    private Dictionary<DateOnly, int> _itemCounts = new();

    protected override void OnParametersSet()
    {
        // The parent re-renders on every keystroke/filter click and passes the same (mutable, so always
        // "changed" to Blazor) list each time - regrouping 16k items by date on every one of those is what
        // made typing in the search box do a full calendar recompute. Only regroup when the list changed.
        if (CountsOverride is null && (!ReferenceEquals(Items, _countedItems) || Items.Count != _countedItemsLength))
        {
            _countedItems = Items;
            _countedItemsLength = Items.Count;
            _itemCounts = Items
                .GroupBy(i => DateOnly.FromDateTime(i.Published.LocalDateTime))
                .ToDictionary(g => g.Key, g => g.Count());
        }

        if (_initialized) return;
        _initialized = true;
        var anchor = RangeStart ?? DateOnly.FromDateTime(DateTime.Today);
        _displayMonth = anchor.AddDays(1 - anchor.Day);
    }

    private void PrevMonth() => _displayMonth = _displayMonth.AddMonths(-1);
    private void NextMonth() => _displayMonth = _displayMonth.AddMonths(1);
    private void GoToday() => _displayMonth = DateOnly.FromDateTime(DateTime.Today).AddDays(1 - DateTime.Today.Day);

    private async Task DayClicked(DateOnly day, MouseEventArgs e)
    {
        if (e.ShiftKey && RangeStart is not null)
        {
            var start = RangeStart.Value < day ? RangeStart.Value : day;
            var end = RangeStart.Value < day ? day : RangeStart.Value;
            await OnRangeChanged.InvokeAsync((start, end));
        }
        else
        {
            await OnRangeChanged.InvokeAsync((day, day));
        }
    }
}

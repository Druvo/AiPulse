@* Single toast stack for the whole app - see ToastService for how pages push a message here. Announced politely to screen readers;
   the thin bar along the bottom shows how long the toast stays (hidden under prefers-reduced-motion). *@
@rendermode InteractiveServer
@implements IDisposable
@inject ToastService Toasts

<div class="toast-stack" role="status" aria-live="polite">
    @foreach (var t in _active)
    {
        <div class="toast-item" @key="t.Id" style="--toast-ms:@(t.DurationMs)ms">
            <span class="toast-icon" aria-hidden="true"><Icon Name="check" Size="15" /></span>
            <span class="toast-text">@t.Text</span>
            @if (t.ActionText is not null)
            {
                <button type="button" class="btn btn-sm btn-link p-0 toast-action" @onclick="() => RunAction(t)">@t.ActionText</button>
            }
            <button type="button" class="icon-btn toast-close" title="Dismiss" aria-label="Dismiss notification" @onclick="() => Remove(t.Id)"><Icon Name="x" Size="15" /></button>
            <span class="toast-progress" aria-hidden="true"></span>
        </div>
    }
</div>

@code {
    private readonly List<ToastMessage> _active = new();

    protected override void OnInitialized()
    {
        Toasts.OnShow += HandleShow;
        Toasts.OnDismiss += HandleDismiss;
    }

    private void HandleDismiss(Guid id) => InvokeAsync(() => Remove(id));

    private void HandleShow(ToastMessage t)
    {
        InvokeAsync(async () =>
        {
            _active.Add(t);
            StateHasChanged();
            await Task.Delay(t.DurationMs);
            Remove(t.Id);
        });
    }

    private async Task RunAction(ToastMessage t)
    {
        Remove(t.Id);
        if (t.OnAction is not null) await t.OnAction();
    }

    private void Remove(Guid id)
    {
        if (_active.RemoveAll(x => x.Id == id) > 0) InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Toasts.OnShow -= HandleShow;
        Toasts.OnDismiss -= HandleDismiss;
    }
}

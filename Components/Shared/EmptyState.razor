@* Shared "nothing here" slot - one visual language for every dead end in the app instead of each page hand-writing its own.
   <EmptyState Icon="bookmark" Title="Nothing saved yet" Body="Save an article from the News Feed." ActionText="Open the feed" ActionHref="news" />
   Options: Compact (inside a small card), Boxed (dashed outline on its own), a secondary link, or any extra markup as child content. *@

<div class="empty-state @(Compact ? "empty-state--compact" : "") @(Boxed ? "empty-state--card" : "") @CssClass" role="status">
    <div class="empty-state__icon" aria-hidden="true"><Icon Name="@Icon" Size="@(Compact ? 22 : 26)" /></div>
    <p class="empty-state__title">@Title</p>
    @if (!string.IsNullOrWhiteSpace(Body))
    {
        <p class="empty-state__body">@Body</p>
    }
    @ChildContent
    @if (ActionText is not null || SecondaryText is not null)
    {
        <div class="empty-state__actions">
            @if (ActionText is not null)
            {
                @if (ActionHref is not null)
                {
                    <a class="btn btn-sm btn-primary" href="@ActionHref">@ActionText</a>
                }
                else if (OnAction.HasDelegate)
                {
                    <button type="button" class="btn btn-sm btn-primary" @onclick="OnAction">@ActionText</button>
                }
            }
            @if (SecondaryText is not null && SecondaryHref is not null)
            {
                <a class="btn btn-sm btn-ghost" href="@SecondaryHref">@SecondaryText</a>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "inbox";
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string? Body { get; set; }
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public string? ActionHref { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
    [Parameter] public string? SecondaryText { get; set; }
    [Parameter] public string? SecondaryHref { get; set; }
    /// <summary>Tighter padding and a smaller icon, for empty states inside a card or panel.</summary>
    [Parameter] public bool Compact { get; set; }
    /// <summary>A dashed outline so the empty state reads as a placeholder area on its own.</summary>
    [Parameter] public bool Boxed { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
